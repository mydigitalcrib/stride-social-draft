blob-report/
playwright/.cache/
*.log

# The approved desktop's screenshots (hundreds of MB): kept on disk, never committed. Their fingerprints are in
# tests/baselines.manifest.json, which is; `npm run test:baseline:verify` checks them, `npm run test:baseline:approve`
# is the only way to replace them.
tests/__baselines__/

# OS files
.DS_Store
Thumbs.db
desktop.ini
