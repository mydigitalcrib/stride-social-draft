dist-next/
dist-a/
dist-b/
dist-c/
dist-d/
.astro/

# Environment and secrets (set these in the host's dashboard instead)
.env
.env.*
!.env.example

# Local Phase 1 backup copy (kept on disk, never committed; Phase 1 is tagged `phase-1-recreation`)
duplicade-stride/

# Hosting CLIs
.vercel/
