{
  "name": "stride-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Independent rebuild of stride-social.com, structured for the Stride Social / Talent / Education divisions.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node scripts/checks/links.mjs",
    "check:placeholders": "node scripts/checks/placeholders.mjs",
    "check:content": "node scripts/checks/content.mjs",
    "roster:import": "node scripts/roster/import-sheet.mjs",
    "ci": "npm run check && npm run build && npm run check:links && npm run check:redirects && npm run check:seo && npm run check:placeholders && npm run check:content",
    "check:redirects": "node scripts/checks/redirects.mjs",
    "check:seo": "node scripts/checks/seo.mjs",
    "test": "playwright test",
    "test:desktop": "node scripts/visual/baseline.mjs verify && playwright test --project=desktop-*",
    "test:responsive": "playwright test --project=phone-* --project=tablet-*",
    "test:review": "playwright test --project=phone-* --project=tablet-* review",
    "test:baseline:verify": "node scripts/visual/baseline.mjs verify",
    "test:baseline:approve": "node scripts/visual/baseline.mjs approve"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@mediapipe/tasks-vision": "1.2.2",
    "astro": "^5.18.2",
    "lenis": "^1.3.27",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.0",
    "cheerio": "^1.2.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
