---
// Service page, one per Stride Social service: its opening (social/ServiceHero; the owner, 2026-11-12): its name, line
// and words, what it includes, and a phone playing videos (its case studies' own upright clips, then Stride's creators'
// reels: config/service-phones.ts; the owner, 2026-11-17, in place of its pictures); then the shared menu: Related
// Work, Questions, More Services. In front of Contact's background, as Stride Social is. Phones and tablets have the
// same opening (the owner, 2026-11-13). Content not yet supplied by Stride is left out.
import { getCollection, getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Deck from '@/components/experience/Deck.astro';
import { routes } from '@/lib/routes';
import { chunks, paragraphs } from '@/lib/experience';
import type { Card } from '@/lib/experience';
import ServiceHero from '@/components/social/ServiceHero.astro';
import BackVideo from '@/components/core/BackVideo.astro';
import { creatorRegions } from '@/config/creator-regions';
import { PHONE_CLIPS, phoneClips } from '@/config/service-phones';
import { getRoster, handleOf } from '@/lib/roster';

export async function getStaticPaths() {
  const services = (await getCollection('services')).sort((a, b) => a.data.number - b.data.number);
  return services.map((service) => ({ params: { slug: service.id }, props: { service, services } }));
}

const { service, services } = Astro.props;
const d = service.data;
const body = d.copyStatus !== 'needed' ? paragraphs(service.body).flatMap((p) => chunks(p, 320)) : [];
const related = (await getCollection('work', (w) => w.data.visible && w.data.services.some((s) => s.id === service.id))).sort((a, b) => a.data.order - b.data.order);
const clients = await Promise.all(related.map(async (w) => (await getEntry(w.data.client))?.data.name ?? w.data.title));
const final = (await getEntry('pages', 'social'))?.data.sections.final;
const enquire = `/social/enquire?service=${service.id}`;
const talk = `Talk to us about ${d.name}`;

const relatedCards: Card[] = related.slice(0, 8).map((w, i) => ({
  name: clients[i],
  text: w.data.summary,
  href: routes.caseStudy(w.id),
  image: w.data.card,
  stats: w.data.results.filter((r) => r.status === 'verified').slice(0, 3),
  action: { label: 'View case study', href: routes.caseStudy(w.id) },
}));
const faqCards: Card[] = d.faqs.map((f) => ({ name: f.q, text: f.a, href: enquire }));

// The phone: its case studies' upright clips first, taking turns (each case study's first, then each one's second...),
// then Stride's creators' reels (published creators only, by the roster's rules), each page starting at a different reel.
const perWork = related.map((w, i) =>
  w.data.videos
    .map((v) => phoneClips[v.src])
    .filter((c) => !!c)
    .map((c) => ({ ...c, who: clients[i], href: routes.caseStudy(w.id), note: 'Case study', label: `${clients[i]}: campaign video` })),
);
const fromWork = Array.from({ length: Math.max(0, ...perWork.map((l) => l.length)) }, (_, k) => perWork.flatMap((l) => (l[k] ? [l[k]] : []))).flat();
const roster = await getRoster();
const byId = new Map(roster.map((c) => [c.id, c]));
const platformOf = (p: Record<string, string | undefined>) => (p.tiktok ? 'TikTok' : p.instagram ? 'Instagram' : p.youtube ? 'YouTube' : p.twitch ? 'Twitch' : 'Creator');
const reels = creatorRegions
  .flatMap((r) => r.reels ?? [])
  .flatMap((reel) => {
    const c = byId.get(reel.creator);
    return c ? [{ src: reel.src, poster: reel.poster, who: handleOf(c) ?? c.data.name, href: routes.creator(c.id), note: platformOf(c.data.platforms), label: `${c.data.name}: creator video` }] : [];
  });
const turn = reels.length ? (d.number * 3) % reels.length : 0;
const clips = [...fromWork, ...reels.slice(turn), ...reels.slice(0, turn)].slice(0, PHONE_CLIPS);
const others: Card[] = services
  .filter((x) => x.id !== service.id)
  .map((x) => ({ name: x.data.name, text: x.data.descriptor, href: routes.service(x.id), image: x.data.hero, direct: true }));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: d.name,
    description: d.descriptor,
    serviceType: 'Influencer marketing',
    provider: { '@type': 'Organization', name: 'Stride Social', url: 'https://www.stride-social.com' },
  },
];
---

<SiteLayout title={d.seo?.title ?? `${d.name} | Stride Social`} description={d.seo?.description ?? d.descriptor} division="social" ogImage={d.hero?.src} jsonLd={jsonLd} headerOverlay>
  {/* In front of Contact's background, as Stride Social is (the owner, 2026-11-17: it was the night sky). */}
  <BackVideo look="deep" mp4="/assets/video/stride-showreel-desktop.mp4" webm="/assets/video/stride-showreel-desktop.webm" poster="/assets/site/stride-showreel-desktop-poster.jpg" blur={10} />
  <ServiceHero
    name={d.name}
    number={d.number}
    descriptor={d.descriptor}
    body={body}
    items={d.deliverables}
    pictures={[...(d.hero ? [d.hero] : []), ...d.gallery]}
    clips={clips}
    crumbs={[{ label: 'Stride Social', href: '/social' }, { label: d.name }]}
    talk={{ label: talk, href: enquire }}
    serviceId={service.id}
  />

  <Deck
    variant="spines"
    id="service-menu"
    label={`More about ${d.name}`}
    tone="social"
    look="deep"
    tabs={[
      { key: 'work', label: 'Related Work', icon: 'play', cards: relatedCards },
      { key: 'questions', label: 'Questions', icon: 'chat', numbered: true, cards: faqCards },
      { key: 'more', label: 'More Services', icon: 'layers', cards: others },
    ]}
    link={{ label: final?.cta?.label ?? 'Talk To Stride Social', href: enquire }}
  />
</SiteLayout>
