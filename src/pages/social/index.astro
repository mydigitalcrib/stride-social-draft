---
// Stride Social landing; its content is its own component (components/social/SocialPage.astro).
import { getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import SocialPage from '@/components/social/SocialPage.astro';

const page = await getEntry('pages', 'social');
if (!page) throw new Error('Missing src/content/pages/social.yaml');
---

<SiteLayout
  title="Stride Social | Influencer Marketing Agency"
  description={page.data.sections.hero.body}
  division="social"
  headerOverlay
>
  {/* The first frame waits for the title (experience/Deck.astro), which the homepage's row flies into. */}
  <link slot="head" rel="expect" href="#social-menu-title" blocking="render" />
  <SocialPage />
</SiteLayout>
