---
// Article: the cover full-bleed with the title in glass at its foot, then the text on navy, with a thin
// line of light along the top of the screen and a glass pill counting down the minutes left as you read
// (worked out from the article's own length). Share links stay beside it; more in the topic in the shared
// menu. Structured data: Article. Body HTML is the migrated article (trusted repository content).
// Every screen (phones and tablets as desktop since 2026-11-13): the cover settles as the page opens and recedes as you
// start reading; the line of light has a spark at its end that brightens with the speed of the scroll, and glows once
// when you reach the end; the minutes left roll from one number to the next; the share-a-sentence pill comes up over
// the words and fades as you scroll (or with Escape). Desktop also has the section dots beside the text: each fills
// with a ring as it's read, and jumping to one moves focus to its heading with a line of light under it. Nothing moves
// inside the text itself. Sizes are in rem, so it grows past 1920×1080 with the page.
import SiteLayout from '@/layouts/SiteLayout.astro';
import Breadcrumbs from '@/components/global/Breadcrumbs.astro';
import Prose from '@/components/core/Prose.astro';
import Deck from '@/components/experience/Deck.astro';
import { categoryLabels, formatDate, getArticles, normaliseHeadings, readingMinutes, realAside, type Article } from '@/lib/insights';
import { routes } from '@/lib/routes';
import { rewriteLegacyLinks } from '@/lib/legacy-links';
import { site } from '@/config/site';
import { interfaceCopy } from '@/lib/ui-copy';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article, articles } }));
}

const { article, articles } = Astro.props as { article: Article; articles: Article[] };
const t = await interfaceCopy();
const d = article.data;
// Bodies are migrated HTML: headings are renumbered so the outline never skips a level, and links
// to the previous site's URLs point straight at the new pages.
const body = rewriteLegacyLinks(normaliseHeadings((article.body ?? '').replace(/<!--[\s\S]*?-->/g, '')));
const aside = realAside(article);
const minutes = readingMinutes(article);
// A title with a word no line can hold (a web address) may break inside it on desktop; the rest keep their words whole.
const unbroken = d.title.split(/\s+/).some((w) => w.length > 17);
const related = articles.filter((a) => a.id !== article.id && a.data.category === d.category).slice(0, 8);
const url = new URL(routes.article(article.id), site.url).href;
const share = [
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}` },
  { label: 'X', href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(d.title)}` },
  { label: 'Email', href: `mailto:?subject=${encodeURIComponent(d.title)}&body=${encodeURIComponent(url)}` },
];
const author = d.authorName;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.standfirst,
    image: new URL(d.cover.src, site.url).href,
    ...(d.date ? { datePublished: d.date.toISOString().slice(0, 10) } : {}),
    ...(author ? { author: { '@type': 'Person', name: author } } : {}),
    publisher: { '@type': 'Organization', name: 'Stride Social', url: site.url },
  },
];
---

<SiteLayout title={d.seo?.title ?? `${d.title} | Stride Insights`} description={d.seo?.description ?? d.standfirst} ogImage={d.cover.src} ogType="article" jsonLd={jsonLd} headerOverlay>
  <article class="read" data-read data-minutes={minutes} data-tone="group">
    <span class="read__line" aria-hidden="true"></span>
    <span class="read__spark" aria-hidden="true" data-read-spark></span>

    <header class="read__hero on-photo" data-look="deep">
      <img class="read__cover" src={d.cover.src} alt={d.cover.alt} fetchpriority="high" decoding="async" />
      <div class="read__scrim" aria-hidden="true" data-backdrop></div>
      <div class="read__head container-wide">
        <div class="read__panel glass">
          <Breadcrumbs items={[{ label: 'Insights', href: '/insights' }, { label: categoryLabels[d.category], href: routes.insightsFiltered(d.category) }]} tone="dark" />
          <h1 class:list={['read__title exp-title', { 'is-unbroken': unbroken }]}>{d.title}</h1>
          <p class="read__stand">{d.standfirst}</p>
          <p class="exp-label">
            {d.date && <><time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time> · </>}{minutes} min read{author && <> · By {author}</>}
          </p>
        </div>
      </div>
    </header>

    <div class="read__body container-wide" data-look="white" data-read-body>
      <aside class="read__side">
        <p class="exp-label">Share</p>
        <ul class="read__share" role="list">
          {share.map((s) => (
            <li><a class="exp-chip" href={s.href} target={s.label === 'Email' ? undefined : '_blank'} rel="noopener">{s.label}{s.label !== 'Email' && <span class="visually-hidden"> (opens in a new tab)</span>}</a></li>
          ))}
        </ul>
      </aside>
      <Prose class="read__prose exp-prose" html={body} />
      {aside && (
        <figure class="read__aside">
          <img src={aside.src} alt={aside.alt} sizes="(max-width: 1023px) 100vw, 25vw" loading="lazy" />
        </figure>
      )}
    </div>

    <nav class="read__rail desk-only" aria-label={t('article.sections')} data-read-rail></nav>

    <div class="read__quote glass on-photo" hidden data-read-quote>
      <a class="exp-chip" href="#" target="_blank" rel="noopener" data-read-share>{t('article.share')}</a>
      <button class="exp-chip" type="button" data-read-copy data-done={t('article.copied')}>{t('article.copy')}</button>
    </div>

    <p class="read__left glass on-photo" aria-hidden="true"><span data-read-left>{minutes}</span> min left</p>
  </article>

  {related.length > 0 && (
    <Deck
      id="read-more"
      label={`More in ${categoryLabels[d.category]}`}
      tone="group"
      look="deep"
      tabs={[{
        key: 'more',
        label: `More in ${categoryLabels[d.category]}`,
        icon: 'book',
        cards: related.map((a) => ({ name: a.data.title, text: `${formatDate(a.data.date)} · ${readingMinutes(a)} min`, href: routes.article(a.id), image: a.data.cover, direct: true })),
      }]}
      link={{ label: 'All Insights', href: '/insights' }}
    />
  )}
</SiteLayout>

<style>
  .read {
    position: relative;
    color: rgb(var(--ink));
  }

  /* How far you've read: a line of light along the top of the screen. */
  .read__line {
    position: fixed;
    inset: 0 0 auto;
    z-index: 110;
    height: 3px;
    background: rgb(var(--tone-lit));
    box-shadow: 0 0 14px rgb(var(--tone-glow));
    transform: scaleX(var(--read, 0));
    transform-origin: left;
  }

  .read__hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    overflow: hidden;
  }

  .read__cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    filter: contrast(1.1) saturate(1.18) brightness(0.94);
  }

  .read__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(var(--backdrop, var(--tone-surface))), rgb(var(--backdrop, var(--tone-surface)) / 0) 55%),
      linear-gradient(to bottom, rgb(var(--navy-900-rgb) / 0.55), rgb(var(--navy-900-rgb) / 0) 24%);
  }

  .read__head {
    position: relative;
    width: 100%;
    padding-block: calc(var(--header-h) + var(--space-3)) var(--space-6);
  }

  .read__panel {
    display: grid;
    gap: var(--space-3);
    max-width: 52rem;
    padding: clamp(22px, 2.6vw, 42px);
  }

  .read__title {
    font-size: clamp(1.875rem, 3.8vw, 4rem);
    line-height: 0.98;
  }

  .read__stand {
    font-size: var(--type-lead);
    line-height: 1.34;
    color: rgb(var(--ink) / 0.9);
  }

  /* ---------- The text ---------- */
  .read__body {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 7fr) minmax(0, 3fr);
    gap: var(--space-6) var(--gutter);
    align-items: start;
    padding-block: var(--space-7) var(--space-8);
  }

  .read__side {
    position: sticky;
    top: calc(var(--header-h) + var(--space-3));
    display: grid;
    gap: var(--space-2);
  }

  .read__share {
    display: grid;
    justify-items: start;
    gap: 6px;
  }

  .read__aside {
    position: sticky;
    top: calc(var(--header-h) + var(--space-3));
  }

  .read__aside img {
    width: 100%;
    border-radius: 22px;
  }

  /* Minutes left. */
  .read__left {
    position: fixed;
    right: var(--space-5);
    bottom: var(--space-5);
    z-index: 40;
    padding: 10px 16px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: rgb(var(--navy-900-rgb) / 0.72);
    opacity: var(--pill, 0);
    transition: opacity 400ms var(--ease-out);
    pointer-events: none;
  }

  /* A dot for each section down the side of the screen. */
  .read__rail {
    position: fixed;
    top: 50%;
    right: var(--space-5);
    z-index: 40;
    display: grid;
    gap: 2px;
    opacity: var(--pill, 0);
    transform: translateY(-50%);
    transition: opacity 400ms var(--ease-out);
  }

  .read__rail :global(button) {
    position: relative;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
  }

  .read__rail :global(button::before) {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgb(var(--ink) / 0.3);
    transition:
      background-color 240ms var(--ease-out),
      scale 240ms var(--ease-out);
  }

  .read__rail :global(button.is-here::before),
  .read__rail :global(button:hover::before) {
    background: rgb(var(--tone-lit));
    scale: 1.5;
  }

  .read__rail :global(button span) {
    position: absolute;
    top: 50%;
    right: 100%;
    max-width: 18rem;
    padding: 5px 12px;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(var(--panel) / 0.92);
    box-shadow: inset 0 0 0 1px rgb(var(--hair) / 0.2);
    font-size: 0.8125rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgb(var(--ink));
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%);
    transition: opacity 180ms var(--ease-out);
  }

  .read__rail :global(button:hover span),
  .read__rail :global(button:focus-visible span) {
    opacity: 1;
  }

  /* Share a sentence: appears over what's selected. */
  .read__quote {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    display: flex;
    gap: 6px;
    padding: 6px;
    border-radius: 999px;
    background: rgb(var(--navy-900-rgb) / 0.92);
    transform: translate(var(--qx, 0), var(--qy, 0));
  }

  .read__quote[hidden] {
    display: none;
  }

  @media (max-width: 1023px) {
    .read__body {
      grid-template-columns: minmax(0, 1fr);
    }

    .read__side,
    .read__aside {
      position: static;
    }

    .read__share {
      display: flex;
      flex-wrap: wrap;
    }
  }

  /* ---------- Every screen: in rem, so past 1920×1080 it grows with the page (styles/system/tokens.css) ---------- */
  @media all {
    .read__line {
      height: 0.1875rem;
      box-shadow: 0 0 0.875rem rgb(var(--tone-glow));
    }

    /* Read to the end, the line glows once (again only after reading back up a way: the script). */
    .read__line.is-done {
      animation: read-done 1.2s var(--ease-in-out);
    }

    /* A spark at the line's end that brightens with the speed of the scroll and fades when it stops (the script). */
    .read__spark {
      position: fixed;
      top: -0.28125rem;
      left: -3rem;
      z-index: 111;
      width: 6rem;
      height: 0.75rem;
      border-radius: 50%;
      background: radial-gradient(closest-side, var(--white), rgb(var(--tone-lit) / 0.7) 45%, transparent);
      opacity: 0;
      pointer-events: none;
    }

    .read__panel {
      padding: clamp(1.375rem, 2.6vw, 2.625rem);
    }

    /* A word too long for any line (a web address in a title) breaks inside the glass rather than widening it; other
       titles keep their words whole, as the design has them (.is-unbroken, set in the markup). */
    .read__title.is-unbroken {
      overflow-wrap: anywhere;
    }

    .read__share {
      gap: 0.375rem;
    }

    .read__aside img {
      border-radius: 1.375rem;
    }

    /* The minutes left arrive from a little below, and each new number rolls in. */
    .read__left {
      padding: 0.625rem 1rem;
      translate: 0 calc((1 - var(--pill, 0)) * 0.5rem);
      transition:
        opacity 400ms var(--ease-out),
        translate 400ms var(--ease-out);
    }

    .read__left span {
      display: inline-block;
    }

    .read__rail {
      gap: 0.125rem;
    }

    .read__rail :global(button) {
      width: 1.5rem;
      height: 1.5rem;
    }

    .read__rail :global(button::before) {
      width: 0.4375rem;
      height: 0.4375rem;
    }

    .read__rail :global(button:focus-visible::before) {
      background: rgb(var(--tone-lit));
      scale: 1.5;
    }

    /* How much of each section is read: a ring filling round its dot (--p, the script); the ones read stay faintly
       ringed. Empty until you're in a section, so the dots look as they always have. */
    .read__rail :global(button::after) {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0.9375rem;
      height: 0.9375rem;
      margin: -0.46875rem 0 0 -0.46875rem;
      border-radius: 50%;
      background: conic-gradient(rgb(var(--tone-lit)) calc(var(--p, 0) * 1turn), transparent 0);
      -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 1.5px), #000 calc(100% - 1.5px));
      mask: radial-gradient(farthest-side, transparent calc(100% - 1.5px), #000 calc(100% - 1.5px));
      opacity: 0.45;
      pointer-events: none;
    }

    .read__rail :global(button.is-here::after) {
      opacity: 1;
    }

    .read__rail :global(button span) {
      padding: 0.3125rem 0.75rem;
      translate: 0.4rem 0;
      transition:
        opacity 180ms var(--ease-out),
        translate 180ms var(--ease-out);
    }

    .read__rail :global(button:hover span),
    .read__rail :global(button:focus-visible span) {
      translate: 0 0;
    }

    /* Placed with translate (not transform), so its appearing scale grows from its own foot, over the words. */
    .read__quote {
      gap: 0.375rem;
      padding: 0.375rem;
      transform: none;
      translate: var(--qx, 0) var(--qy, 0);
      transform-origin: 50% 100%;
    }

    /* Arriving at a section from its dot: a line of light grows under its heading, holds, and fades. */
    .read__body :global(.is-arrived) {
      position: relative;
    }

    .read__body :global(.is-arrived::after) {
      content: '';
      position: absolute;
      right: 0;
      bottom: -0.5rem;
      left: 0;
      height: 2px;
      background: rgb(var(--tone-lit));
      box-shadow: 0 0 0.75rem rgb(var(--tone-glow));
      transform-origin: 0 50%;
      pointer-events: none;
      animation: read-arrive 2.1s var(--ease-out) both;
    }
  }

  /* A narrow laptop, an article without a picture beside it: the text takes the empty column, for a readable line. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .read__body:not(:has(.read__aside)) {
      grid-template-columns: minmax(0, 2fr) minmax(0, 9fr) minmax(0, 1fr);
    }
  }

  /* With motion: the cover settles as the page opens and recedes as you start reading, the title's glass lifting away
     from it (--q, the script). */
  @media (prefers-reduced-motion: no-preference) {
    .read__cover {
      translate: 0 calc(var(--q, 0) * 18vh);
      scale: calc(1 + var(--q, 0) * 0.06);
      animation: read-settle 1.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .read__panel {
      translate: 0 calc(var(--q, 0) * -6rem);
      opacity: calc(1 - max(0, var(--q, 0) - 0.4) / 0.6 * 0.5);
      animation: read-rise 700ms var(--ease-out) 150ms backwards;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .read__left,
    .read__rail :global(button span) {
      translate: none;
    }

    /* Still, for a moment (the site's reduced-motion rule would cut any animation to nothing): the script takes it
       off after 1.2s. */
    .read__body :global(.is-arrived::after) {
      animation: none;
    }
  }

  @keyframes read-settle {
    from {
      transform: scale(1.06);
    }
  }

  @keyframes read-rise {
    from {
      transform: translateY(1.5rem);
    }
  }

  @keyframes read-done {
    50% {
      box-shadow: 0 0 1.75rem rgb(var(--tone-glow));
      opacity: 0.55;
    }
  }

  @keyframes read-arrive {
    0% {
      scale: 0 1;
    }

    28%,
    57% {
      scale: 1 1;
      opacity: 1;
    }

    100% {
      scale: 1 1;
      opacity: 0;
    }
  }
</style>

<script>
  import { uiScale } from '@/scripts/system/scale';
  import { reduced } from '@/scripts/system/env';

  type Lenis = { scrollTo(target: number, options?: { duration?: number; force?: boolean; onComplete?: () => void }): void };

  document.querySelectorAll<HTMLElement>('[data-read]').forEach((root) => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const body = root.querySelector<HTMLElement>('[data-read-body]');
    const left = root.querySelector<HTMLElement>('[data-read-left]');
    const minutes = Number(root.dataset.minutes) || 1;
    if (!body) return;

    /* ---------- Every screen ---------- */
    const still = reduced();
    const line = root.querySelector<HTMLElement>('.read__line');
    const spark = root.querySelector<HTMLElement>('[data-read-spark]');
    const pill = root.querySelector<HTMLElement>('.read__left');
    const rail = root.querySelector<HTMLElement>('[data-read-rail]');
    const hero = root.querySelector<HTMLElement>('.read__hero');
    const cover = root.querySelector<HTMLElement>('.read__cover');
    const panel = root.querySelector<HTMLElement>('.read__panel');
    const heads = [...body.querySelectorAll<HTMLElement>('.read__prose h2, .read__prose h3')];
    const top = heads.filter((h) => h.tagName === heads[0]?.tagName);
    const dots: HTMLButtonElement[] = [];
    const lenis = () => (window as unknown as { lenis?: Lenis }).lenis;

    // Where the hero, the text and its sections are on the page: measured as the page settles (load, the fonts, any
    // change of size), never while scrolling, so a scroll only compares numbers.
    let heroTop = 0;
    let heroH = 1;
    let bodyTop = 0;
    let bodyH = 1;
    let starts: number[] = [];
    let wide = document.documentElement.clientWidth;

    // What's on screen now, so each frame writes only what changed, and only to the pieces that use it (never the
    // whole article, which would restyle the text).
    let queued = false;
    let lastY = window.scrollY;
    let read = '';
    let shown = '';
    let mins = -1;
    let here = -1;
    let q = '';
    let heroOn = true;
    let armed = true;
    let energy = 0;
    let sparking = 0;
    const rings: number[] = [];

    // Each new number of minutes rolls in: from below as they go down, from above if you read back up.
    const roll = (m: number, was: number) => {
      if (!left) return;
      left.textContent = String(m);
      if (was < 0 || still) return;
      left.animate([{ transform: `translateY(${m < was ? 0.6 : -0.6}em)`, opacity: 0 }, { transform: 'none', opacity: 1 }], {
        duration: 260,
        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      });
    };

    // The spark fades a little every frame until the scroll gives it more.
    const glow = () => {
      sparking = 0;
      energy *= 0.9;
      if (energy < 0.01) energy = 0;
      if (spark) spark.style.opacity = energy.toFixed(3);
      if (energy) sparking = requestAnimationFrame(glow);
    };

    const frame = () => {
      queued = false;
      const y = window.scrollY;
      const h = window.innerHeight;
      const t = bodyTop - y;
      const f = Math.min(1, Math.max(0, -t / Math.max(1, bodyH - h)));
      const fs = f.toFixed(4);
      if (fs !== read) {
        read = fs;
        line?.style.setProperty('--read', fs);
      }
      const on = t < h * 0.4 && t + bodyH > h * 0.6 ? '1' : '0';
      if (on !== shown) {
        shown = on;
        pill?.style.setProperty('--pill', on);
        rail?.style.setProperty('--pill', on);
      }
      const m = Math.max(0, Math.ceil(minutes * (1 - f)));
      if (m !== mins) {
        roll(m, mins);
        mins = m;
      }

      // The section being read (the last heading above 40% of the screen), and how far through each one you are.
      if (dots.length) {
        const mark = y + h * 0.4;
        let at = 0;
        starts.forEach((s, i) => {
          if (s < mark) at = i;
        });
        if (at !== here) {
          here = at;
          dots.forEach((d, i) => d.classList.toggle('is-here', i === at));
        }
        dots.forEach((d, i) => {
          const end = starts[i + 1] ?? bodyTop + bodyH;
          const p = Math.min(1, Math.max(0, (mark - starts[i]) / Math.max(1, end - starts[i])));
          const was = rings[i];
          if (was !== undefined && Math.abs(p - was) <= 0.005 && !(p !== was && (p === 0 || p === 1))) return;
          rings[i] = p;
          d.style.setProperty('--p', p.toFixed(3));
        });
      }

      const dy = y - lastY;
      lastY = y;
      if (!still) {
        if (spark && f > 0 && f < 1) {
          spark.style.transform = `translate3d(${(f * wide).toFixed(1)}px, 0, 0)`;
          // As bright as the scroll is quick: full at 40px a frame (at 1920×1080's scale).
          energy = Math.max(energy, Math.min(1, Math.abs(dy) / (40 * uiScale())));
          if (energy > 0.01 && !sparking) sparking = requestAnimationFrame(glow);
        }
        if (line && armed && f >= 0.995) {
          armed = false;
          line.classList.add('is-done');
        } else if (f < 0.9) armed = true;
        if (heroOn) {
          const qs = Math.min(1, Math.max(0, (y - heroTop) / heroH)).toFixed(4);
          if (qs !== q) {
            q = qs;
            cover?.style.setProperty('--q', qs);
            panel?.style.setProperty('--q', qs);
          }
        }
      }
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(frame);
    };

    const measure = () => {
      const y = window.scrollY;
      const r = body.getBoundingClientRect();
      bodyTop = r.top + y;
      bodyH = r.height;
      if (hero) {
        heroTop = hero.getBoundingClientRect().top + y;
        heroH = Math.max(1, hero.offsetHeight);
      }
      starts = top.map((s) => s.getBoundingClientRect().top + y);
      wide = document.documentElement.clientWidth;
      queue();
    };

    line?.addEventListener('animationend', () => line.classList.remove('is-done'));
    // The cover is a layer of its own only while it's on screen.
    if (hero && !still) {
      new IntersectionObserver(([e]) => {
        heroOn = e.isIntersecting;
        if (cover) cover.style.willChange = heroOn ? 'transform' : '';
        queue();
      }).observe(hero);
    }

    /* ---------- The section dots ---------- */
    // Landing on a section from its dot: focus moves to its heading (where the keyboard and a screen reader carry on
    // from), and a line of light shows under it for a moment (with reduced motion it doesn't animate, so it's taken off
    // after 1.2s instead of when its animation ends).
    let arrived: HTMLElement | null = null;
    let unlight = 0;
    const arrive = (h: HTMLElement) => {
      if (!h.hasAttribute('tabindex')) h.setAttribute('tabindex', '-1');
      h.focus({ preventScroll: true });
      // Taken off and put back with a style read between, so landing on it again while it shows starts it over.
      arrived?.classList.remove('is-arrived');
      h.classList.remove('is-arrived');
      void h.offsetWidth;
      h.classList.add('is-arrived');
      arrived = h;
      if (!still) return;
      window.clearTimeout(unlight);
      unlight = window.setTimeout(() => h.classList.remove('is-arrived'), 1200);
    };
    if (rail && top.length > 1) {
      top.forEach((h) => {
        const b = document.createElement('button');
        b.type = 'button';
        const label = document.createElement('span');
        label.textContent = h.textContent?.trim() ?? '';
        b.append(label);
        b.setAttribute('aria-label', label.textContent ?? '');
        b.addEventListener('click', () => {
          // Clear of the header, at any size of screen.
          const y = h.getBoundingClientRect().top + window.scrollY - 110 * uiScale();
          const l = lenis();
          if (l) l.scrollTo(y, { duration: 0.9, force: true, onComplete: () => arrive(h) });
          else {
            window.scrollTo(0, y);
            requestAnimationFrame(() => arrive(h));
          }
        });
        // Only the line's own animation ends it (not one inside the heading, bubbling up).
        h.addEventListener('animationend', (e) => {
          if (e.target === h && e.pseudoElement === '::after') h.classList.remove('is-arrived');
        });
        rail.append(b);
        dots.push(b);
      });
    }

    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', measure, { passive: true });
    new ResizeObserver(measure).observe(body);
    document.fonts?.ready.then(measure);
    measure();

    /* ---------- Share a sentence ---------- */
    // It comes up from its foot over what's selected, fades as the page scrolls or with Escape, and its Copy label
    // crossfades to say it's done.
    const quote = root.querySelector<HTMLElement>('[data-read-quote]');
    const share = root.querySelector<HTMLAnchorElement>('[data-read-share]');
    const copy = root.querySelector<HTMLButtonElement>('[data-read-copy]');
    const prose = body.querySelector<HTMLElement>('.read__prose');
    if (quote && share && copy && prose) {
      let chosen = '';
      let fading: Animation | null = null;
      const pageUrl = location.href.split('#')[0];
      const label = copy.textContent ?? '';
      const hide = () => {
        quote.hidden = true;
        fading?.cancel();
        fading = null;
      };
      const fade = () => {
        if (quote.hidden || fading) return;
        if (still) return hide();
        const out = quote.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 120, easing: 'ease-out', fill: 'forwards' });
        fading = out;
        out.finished.then(
          () => fading === out && hide(),
          () => undefined,
        );
      };
      document.addEventListener('selectionchange', () => {
        const s = document.getSelection();
        const text = s?.toString().trim() ?? '';
        if (!s || s.isCollapsed || text.length < 16 || text.length > 280 || !prose.contains(s.anchorNode)) return hide();
        chosen = text;
        const r = s.getRangeAt(0).getBoundingClientRect();
        const appearing = quote.hidden || !!fading;
        fading?.cancel();
        fading = null;
        quote.hidden = false;
        const k = uiScale();
        quote.style.setProperty('--qx', `${Math.max(12 * k, r.left + r.width / 2 - quote.offsetWidth / 2)}px`);
        quote.style.setProperty('--qy', `${Math.max(12 * k, r.top - quote.offsetHeight - 10 * k)}px`);
        share.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(`“${chosen}”`)}&url=${encodeURIComponent(pageUrl)}`;
        if (appearing && !still) {
          quote.animate(
            [
              { opacity: 0, scale: '0.94' },
              { opacity: 1, scale: '1' },
            ],
            { duration: 160, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
          );
        }
      });
      window.addEventListener('scroll', fade, { passive: true });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') fade();
      });
      const say = (text: string) => {
        if (still) {
          copy.textContent = text;
          return;
        }
        const out = copy.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 100, easing: 'ease-out', fill: 'forwards' });
        out.finished.then(
          () => {
            copy.textContent = text;
            copy.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 160, easing: 'ease-out' });
            out.cancel();
          },
          () => undefined,
        );
      };
      let done = 0;
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(`${pageUrl}#:~:text=${encodeURIComponent(chosen)}`);
          window.clearTimeout(done);
          say(copy.dataset.done ?? label);
          done = window.setTimeout(() => say(label), 1400);
        } catch {
          /* the browser refused: the sentence is still selected */
        }
      });
    }
  });
</script>
