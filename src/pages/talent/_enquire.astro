---
// Stride Talent's brand enquiry page. The division and creator can be prefilled:
// /talent/enquire?interest=speakers, /talent/enquire?creator=amandaagy.
import { getCollection, getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import TalentWall from '@/components/talent/TalentWall.astro';
import FormStage from '@/components/experience/FormStage.astro';
import TalentEnquiryForm from '@/components/talent/TalentEnquiryForm.astro';
import { enquiryEmail } from '@/config/forms';

const copy = (await getEntry('pages', 'talent'))?.data.sections.enquiry;
if (!copy) throw new Error('Missing enquiry in src/content/pages/talent.yaml');
const msg = (key: string) => copy.items?.find((i) => i.key === key)?.label ?? '';
// The divisions in Stride Talent's picker, then Stride Podcasts, which has a page of its own but isn't in the picker.
const interests = [
  ...(await getCollection('talentDivisions', (d) => d.data.picker !== null))
    .sort((a, b) => (a.data.picker ?? 0) - (b.data.picker ?? 0))
    .map((d) => ({ value: d.id, label: d.data.name })),
  ...(await getCollection('talentDivisions', (d) => d.id === 'podcasts' && d.data.picker === null)).map((d) => ({ value: d.id, label: d.data.name })),
  { value: 'not-sure', label: 'Not sure yet' },
];
---

<SiteLayout title="Book a creator | Stride Talent" description={copy.body} division="talent" look="deep" headerOverlay>
  <FormStage tone="talent" look="deep" crumbs={[{ label: 'Stride Talent', href: '/talent' }, { label: 'Enquire' }]} eyebrow={copy.eyebrow} headline={copy.headline ?? ''} body={copy.body} status={copy.status} email={enquiryEmail}>
    <TalentEnquiryForm tone="dark" interests={interests} messages={{ success: msg('success'), error: msg('error'), unavailable: msg('unavailable'), consent: msg('consent') }} />
  </FormStage>
  <TalentWall />
</SiteLayout>

<script>
  // A shortlist picked on the roster starts the brief.
  const brief = document.querySelector<HTMLTextAreaElement>('textarea[name="brief"]');
  if (brief && !brief.value) {
    const names = JSON.parse(brief.form?.dataset.names ?? '{}') as Record<string, string>;
    const creators = (new URLSearchParams(location.search).get('creators') ?? '').split(',').map((id) => names[id]).filter(Boolean);
    if (creators.length) {
      brief.value = `Creators I'd like to work with: ${creators.join(', ')}.\n\n`;
      brief.dispatchEvent(new Event('input', { bubbles: true }));
    }
  }
</script>
