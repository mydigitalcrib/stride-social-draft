---
// Creator roster: every creator, in a mosaic of photographs (talent/RosterBrowser), the search and the division kept
// in the URL (/talent/roster?division=gaming&q=amy). On every screen (phones and tablets rebuilt from the desktop, the
// owner, 2026-11-13: three photographs across a phone, five across a tablet). Only published creators appear
// (src/lib/roster.ts); each opens the creator's profile.
import { getCollection, getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import BackVideo from '@/components/core/BackVideo.astro';
import RosterBrowser from '@/components/talent/RosterBrowser.astro';
import EnquiryClose from '@/components/social/EnquiryClose.astro';
import PlaceholderNotice from '@/components/core/PlaceholderNotice.astro';
import { divisionsOf, getRoster } from '@/lib/roster';
import { creatorView } from '@/lib/creator-view';
import { isPreview } from '@/lib/env';
import Tray from '@/components/experience/Tray.astro';
import DivisionPicker from '@/components/talent/DivisionPicker.astro';
import CreatorSheet from '@/components/talent/CreatorSheet.astro';

const roster = await getRoster();
const allCategories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const labels = Object.fromEntries(allCategories.map((c) => [c.id, c.data.label]));
const talent = (await getEntry('pages', 'talent'))?.data.sections;
const copy = talent?.rosterPage;
if (!talent || !copy) throw new Error('Missing rosterPage in src/content/pages/talent.yaml');
const interim = roster.some((c) => c.data.consent.status !== 'confirmed');

const views = roster.map((c) => creatorView(c, labels));
const pickerDivisions = (await getCollection('talentDivisions', (d) => d.data.picker !== null && !['sport', 'speakers'].includes(d.id)))
  .sort((a, b) => (a.data.picker ?? 0) - (b.data.picker ?? 0))
  .filter((d) => roster.some((c) => divisionsOf(c).includes(d.id)))
  .map((d) => ({ id: d.id, label: d.data.name.replace(/^Stride /, '') }));
const browserWords = Object.fromEntries((talent.browser?.items ?? []).map((i) => [i.key ?? '', i.label]));
// The divisions as giant type (desktop), their letters filling with their creators' photographs (as on /talent), in
// place of the division filter's buttons. Only the divisions with creators here, each a filter.
const giantDivisions = (await getCollection('talentDivisions', (d) => d.data.picker !== null && !['sport', 'speakers'].includes(d.id)))
  .sort((a, b) => (a.data.picker ?? 0) - (b.data.picker ?? 0))
  .map((d) => {
    const members = roster.filter((c) => divisionsOf(c).includes(d.id));
    return {
      id: d.id,
      name: d.data.name,
      own: false,
      href: `/talent/roster?division=${d.id}`,
      count: members.length,
      photo: d.data.hero ?? members.find((c) => c.data.portrait)?.data.portrait ?? null,
      faces: members.flatMap((c) => (c.data.portrait ? [c.data.portrait] : [])).slice(0, 6),
    };
  })
  .filter((d) => d.count > 0);
const pickerWord = (key: string) => talent.picker?.items?.find((i) => i.key === key)?.label ?? key;
---

<SiteLayout title="Creator roster | Stride Talent" description={copy.body} division="talent" look="deep" headerOverlay>
  <div class="roster-top">
      <RosterBrowser level="h1" eyebrow={copy.eyebrow} headline={copy.headline} creators={views} divisions={pickerDivisions} niches={allCategories.filter((cat) => views.some((v) => v.niches.includes(cat.id))).map((c) => ({ id: c.id, label: c.data.label }))} copy={browserWords} pageSize={views.length} sizes="(min-width: 1280px) 16vw, (min-width: 1024px) 20vw, 50vw">
        <DivisionPicker slot="divisions" headline={browserWords.division ?? 'Division'} divisions={giantDivisions} emptyLabel={pickerWord('empty')} />
        {isPreview && interim && <PlaceholderNotice variant="inline" label="Interim roster">— from Stride's sheet, with Foam's descriptions and photos. Awaiting Stride: consent, confirmed follower figures, videos. Division membership is proposed.</PlaceholderNotice>}
      </RosterBrowser>
  </div>
  {/* A creator's profile over the page, from a name (desktop). */}
  <CreatorSheet />
  <EnquiryClose headline={talent.apply.headline ?? ''} label={talent.hero.items?.[1]?.label ?? 'Apply For Management'} href={talent.hero.items?.[1]?.href ?? '/talent/apply'} tone="talent" look="deep" />
  <Tray list="creators" />
  {/* Desktop: Contact's background, as Stride Talent's own page (the owner, 2026-11-13). */}
  <BackVideo look="deep" mp4="/assets/video/stride-showreel-desktop.mp4" webm="/assets/video/stride-showreel-desktop.webm" poster="/assets/site/stride-showreel-desktop-poster.jpg" blur={10} />
</SiteLayout>

<style>
  .roster-top {
    padding-top: var(--header-h);
  }
</style>
