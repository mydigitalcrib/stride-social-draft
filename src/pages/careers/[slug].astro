---
// Job page: the role as a big glass ticket that stays beside you and leans towards the pointer, the
// description beside it, and how to apply (the careers inbox, with the role in the subject). Built only for
// roles that may be listed: confirmed open, or in preview the previous site's postings, labelled.
// Desktop: ticking a responsibility, its tick springs in and a spark of light carries it up to the count in the ticket,
// whose number rolls on (down again when one is unticked); the count is read out as it changes.
import { getCollection, render } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Breadcrumbs from '@/components/global/Breadcrumbs.astro';
import Prose from '@/components/core/Prose.astro';
import PlaceholderNotice from '@/components/core/PlaceholderNotice.astro';
import { careersEmail } from '@/config/forms';
import { isPreview } from '@/lib/env';
import { site } from '@/config/site';
import { interfaceCopy } from '@/lib/ui-copy';

export async function getStaticPaths() {
  const roles = await getCollection('roles', (r) => r.data.status === 'open' || (isPreview && r.data.status === 'legacy'));
  return roles.map((role) => ({ params: { slug: role.id }, props: { role } }));
}

const { role } = Astro.props;
const t = await interfaceCopy();
const d = role.data;
const { Content } = await render(role);
const mailto = `mailto:${careersEmail}?subject=${encodeURIComponent(`Application: ${d.title}`)}`;
const longest = Math.max(5, ...d.title.split(/\s+/).map((w) => w.length));
// JobPosting only lists fields that are real (salary "Upon Application" is not a figure).
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'JobPosting',
    title: d.title,
    description: d.summary,
    hiringOrganization: { '@type': 'Organization', name: 'Stride Social', sameAs: site.url },
    ...(d.location && /remote/i.test(d.location) ? { jobLocationType: 'TELECOMMUTE' } : {}),
  },
];
---

<SiteLayout title={d.seo?.title ?? `${d.title} | Careers at Stride`} description={d.seo?.description ?? d.summary} jsonLd={isPreview && d.status !== 'open' ? undefined : jsonLd} look="white" headerOverlay>
  <article class="job" data-tone="group" data-look="white" data-job data-hint={t('role.hint')} data-count={t('role.count')} data-tick={t('role.tick')} data-body={t('role.body')}>
    <div class="job__inner container-wide">
      <aside class="job__side">
        <div class="job__ticket glass" data-job-ticket>
          <Breadcrumbs items={[{ label: 'Careers', href: '/careers' }, { label: 'Role' }]} tone="dark" />
          <h1 class="job__title exp-title" style={`--len: ${longest}`}>{d.title}</h1>
          <p class="job__meta">{[d.location, d.salary].filter(Boolean).map((x) => <span class="exp-chip">{x}</span>)}</p>
          <p class="job__summary">{d.summary}</p>
          <p class="job__ticks exp-label" hidden aria-live="polite" aria-atomic="true" data-job-ticks></p>
          <a class="exp-pill" href={mailto} data-job-apply>
            Apply by email
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
          </a>
          <p class="job__how">Email your CV to <a href={mailto}>{careersEmail}</a> with the role in the subject line.</p>
          {d.status === 'legacy' && <PlaceholderNotice variant="inline" label="To confirm">— posted on the previous site; confirm it's still open</PlaceholderNotice>}
        </div>
      </aside>
      <div class="job__body glass">
        <Prose class="exp-prose"><Content /></Prose>
      </div>
    </div>
  </article>
</SiteLayout>

<style>
  .job {
    position: relative;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + var(--space-3)) var(--space-8);
    color: rgb(var(--ink));
  }

  .job__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-6) var(--gutter);
    align-items: start;
  }

  .job__side {
    position: sticky;
    top: calc(var(--header-h) + var(--space-3));
    perspective: 1400px;
  }

  .job__ticket {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: var(--space-3);
    padding: clamp(20px, 2.2vw, 36px);
    container-type: inline-size;
    box-shadow:
      inset 0 0 0 1.5px rgb(var(--tone-lit) / 0.9),
      0 0 34px -6px rgb(var(--tone-glow) / 0.5),
      0 30px 60px -30px rgb(var(--shade) / 0.8);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 240ms var(--ease-out);
  }

  .job__title {
    font-size: min(3.75rem, calc(100cqi / (var(--len) * 0.9)));
  }

  .job__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .job__summary {
    color: rgb(var(--ink) / 0.88);
  }

  .job__how {
    font-size: var(--type-small);
    color: rgb(var(--ink) / 0.72);
  }

  .job__how a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .job__body {
    padding: clamp(22px, 2.6vw, 44px);
  }

  .job__ticks {
    color: rgb(var(--tone-lit));
  }

  /* Tick what sounds like you: it goes into your application. */
  .job__body :global(li.has-tick) {
    position: relative;
    padding-left: 36px;
    list-style: none;
  }

  .job__body :global(li.has-tick::marker) {
    content: '';
  }

  .job__body :global(.job__tick) {
    position: absolute;
    top: 2px;
    left: 0;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 8px;
    box-shadow: inset 0 0 0 1.5px rgb(var(--hair) / 0.5);
    font-size: 0.8125rem;
    line-height: 1;
    color: transparent;
    transition:
      background-color 200ms var(--ease-out),
      color 200ms var(--ease-out);
  }

  .job__body :global(.job__tick:hover) {
    box-shadow: inset 0 0 0 1.5px rgb(var(--tone-lit));
  }

  .job__body :global(.job__tick[aria-pressed='true']) {
    background: rgb(var(--tone-lit));
    color: rgb(var(--tone-on));
  }

  .job__body :global(.job__tick:focus-visible) {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 2px;
  }

  .job__body :global(.job__tick span) {
    display: block;
  }

  /* The count's number, which rolls when it changes: the old one and the new one share its place. */
  .job__ticks :global(.job__n) {
    display: inline-grid;
  }

  .job__ticks :global(.job__n > span) {
    grid-area: 1 / 1;
  }

  /* The spark that carries a tick up to the count (desktop, appended to the page). */
  :global(.job__spark) {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 140;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: rgb(var(--tone-lit));
    box-shadow: 0 0 0.75rem 0.125rem rgb(var(--tone-lit) / 0.55);
    pointer-events: none;
  }

  /* Desktop: in rem, so past 1920×1080 the ticket's padding and glow, the ticks and their indent grow with the type
     around them (tokens.css); up to it they're the pixels they were. */
  @media (min-width: 1024px) {
    .job__side {
      perspective: 87.5rem;
    }

    .job__ticket {
      padding: clamp(1.25rem, 2.2vw, 2.25rem);
      box-shadow:
        inset 0 0 0 1.5px rgb(var(--tone-lit) / 0.9),
        0 0 2.125rem -0.375rem rgb(var(--tone-glow) / 0.5),
        0 1.875rem 3.75rem -1.875rem rgb(var(--shade) / 0.8);
    }

    .job__meta {
      gap: 0.375rem;
    }

    .job__how a {
      text-underline-offset: 0.1875rem;
    }

    .job__body {
      padding: clamp(1.375rem, 2.6vw, 2.75rem);
    }

    .job__body :global(li.has-tick) {
      padding-left: 2.25rem;
    }

    .job__body :global(.job__tick) {
      top: 0.125rem;
      width: 1.5rem;
      height: 1.5rem;
      border-radius: 0.5rem;
    }
  }

  /* Ticked, the tick springs in from a little turned; unticked, it fades out (and is set back once it's gone). */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .job__body :global(.job__tick) {
      transition:
        background-color 200ms var(--ease-out),
        color 120ms var(--ease-out);
    }

    .job__body :global(.job__tick span) {
      transform: scale(0.5) rotate(-10deg);
      transition: transform 0s linear 120ms;
    }

    .job__body :global(.job__tick[aria-pressed='true']) {
      transition:
        background-color 200ms var(--ease-out),
        color 200ms var(--ease-out);
    }

    .job__body :global(.job__tick[aria-pressed='true'] span) {
      transform: none;
      transition: transform 240ms var(--spring-pop, cubic-bezier(0.2, 1.4, 0.35, 1));
    }
  }

  @media (max-width: 1023px) {
    .job__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .job__side {
      position: static;
    }
  }
</style>

<script>
  import { initTilt } from '@/scripts/system/ambient';
  import { desktop, reduced } from '@/scripts/system/env';
  import { uiScale } from '@/scripts/system/scale';
  document.querySelectorAll<HTMLElement>('[data-job-ticket]').forEach((t) => {
    if (t.dataset.ready) return;
    t.dataset.ready = 'true';
    initTilt(t, () => t, 6);
  });

  // The role's responsibilities can be ticked; what's ticked goes into the application email.
  document.querySelectorAll<HTMLElement>('[data-job]').forEach((root) => {
    if (root.dataset.ready || !desktop()) return;
    root.dataset.ready = 'true';
    const lists = [...root.querySelectorAll<HTMLElement>('.job__body ul')];
    const list = lists.find((l) => /responsib/i.test(l.previousElementSibling?.textContent ?? '')) ?? lists[0];
    const counter = root.querySelector<HTMLElement>('[data-job-ticks]');
    const apply = root.querySelector<HTMLAnchorElement>('[data-job-apply]');
    if (!list || !counter || !apply) return;
    const base = apply.href;
    const items = [...list.children] as HTMLElement[];
    const nameOf = (li: HTMLElement) => (li.querySelector('strong')?.textContent ?? li.textContent ?? '').replace(/:\s*$/, '').trim().slice(0, 90);
    const buttons = items.map((li) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'job__tick';
      b.innerHTML = '<span aria-hidden="true">✓</span>';
      b.setAttribute('aria-pressed', 'false');
      b.setAttribute('aria-label', `${root.dataset.tick ?? ''}: ${nameOf(li)}`);
      li.classList.add('has-tick');
      li.prepend(b);
      return b;
    });
    const ticked = () => items.filter((_, i) => buttons[i].getAttribute('aria-pressed') === 'true');

    // The count: its number in a place of its own, so a change can roll it (up for one more, down for one less) and
    // brighten the line for a moment. With reduced motion it just changes.
    const ease = 'cubic-bezier(0.22, 1, 0.36, 1)';
    let shown = 0;
    const count = (n: number) => {
      const was = shown;
      if (n === was && counter.textContent) return;
      shown = n;
      counter.hidden = false;
      if (!n) {
        counter.textContent = root.dataset.hint ?? '';
        return;
      }
      const total = String(items.length);
      let slot = counter.querySelector<HTMLElement>('.job__n');
      const next = document.createElement('span');
      next.textContent = String(n);
      if (!slot || !was) {
        const [before = '', after = ''] = (root.dataset.count ?? '{n}').split('{n}');
        slot = document.createElement('span');
        slot.className = 'job__n';
        slot.append(next);
        counter.replaceChildren(before.replace('{total}', total), slot, after.replace('{total}', total));
      } else {
        slot.querySelectorAll('[aria-hidden]').forEach((el) => el.remove());
        const old = slot.lastElementChild as HTMLElement | null;
        slot.append(next);
        if (old) {
          if (reduced()) old.remove();
          else {
            const d = n > was ? 0.5 : -0.5;
            old.setAttribute('aria-hidden', 'true');
            old.animate([{ transform: 'none', opacity: 1 }, { transform: `translateY(${-d}rem)`, opacity: 0 }], { duration: 240, easing: ease, fill: 'forwards' }).finished.then(
              () => old.remove(),
              () => old.remove(),
            );
            next.animate([{ transform: `translateY(${d}rem)`, opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 240, easing: ease });
          }
        }
      }
      if (!reduced()) counter.animate([{ opacity: 0.7 }, { opacity: 1 }], { duration: 300, easing: 'ease-out' });
    };

    // A spark of light from the tick up to the count, along a curve that rises 3rem above the straight line (a
    // quadratic curve through that point, in 12 steps), shrinking as it goes and fading at the end.
    const fly = (from: HTMLElement) =>
      new Promise<void>((landed) => {
        const a = from.getBoundingClientRect();
        const b = (counter.querySelector('.job__n') ?? counter).getBoundingClientRect();
        const k = uiScale();
        const r = 3 * k;
        const x0 = a.left + a.width / 2;
        const y0 = a.top + a.height / 2;
        const x1 = shown ? b.left + b.width / 2 : b.left + 6 * k;
        const y1 = b.top + b.height / 2;
        const cx = (x0 + x1) / 2;
        const cy = (y0 + y1) / 2 - 2 * 48 * k;
        const spark = document.createElement('span');
        spark.className = 'job__spark';
        spark.setAttribute('aria-hidden', 'true');
        document.body.append(spark);
        const frames = Array.from({ length: 13 }, (_, i) => {
          const t = i / 12;
          const x = (1 - t) * (1 - t) * x0 + 2 * (1 - t) * t * cx + t * t * x1;
          const y = (1 - t) * (1 - t) * y0 + 2 * (1 - t) * t * cy + t * t * y1;
          return { transform: `translate(${(x - r).toFixed(1)}px, ${(y - r).toFixed(1)}px) scale(${(1 - 0.4 * t).toFixed(3)})` };
        });
        spark.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 120, delay: 400, fill: 'forwards' });
        spark
          .animate(frames, { duration: 520, easing: 'cubic-bezier(0.5, 0, 0.2, 1)' })
          .finished.catch(() => {})
          .finally(() => {
            spark.remove();
            landed();
          });
      });

    const render = (from?: HTMLElement) => {
      const on = ticked();
      apply.href = on.length ? `${base}&body=${encodeURIComponent(`${root.dataset.body ?? ''}\n${on.map((li) => `- ${nameOf(li)}`).join('\n')}\n\n`)}` : base;
      if (from && !reduced()) fly(from).then(() => count(ticked().length));
      else count(on.length);
    };
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const on = b.getAttribute('aria-pressed') !== 'true';
        b.setAttribute('aria-pressed', String(on));
        render(on ? b : undefined);
      }),
    );
    render();
  });
</script>
