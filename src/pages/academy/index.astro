---
// Stride Academy: "Coming soon" until it opens (the owner, 2026-11-10), shared with the homepage's Academy card
// (components/education/ComingSoon.astro). The full page is parked: components/education/EducationPage.astro goes
// back in here, and on the homepage, when Stride Academy opens.
import { getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import ComingSoon from '@/components/education/ComingSoon.astro';
import BackVideo from '@/components/core/BackVideo.astro';

const soon = (await getEntry('pages', 'education'))?.data.sections.soon;
if (!soon) throw new Error('Missing `soon` in src/content/pages/education.yaml');
---

<SiteLayout title="Stride Academy | Coming soon" description={`Stride Academy is coming soon. ${soon.body ?? ''}`.trim()} division="education" look="deep" headerOverlay>
  {/* In front of the homepage's showreel on Stride's navy, as Our Sponsorships stands (the owner, 2026-11-18: "use the
      same background/colors as /sponsorships"; it was the division's slate). */}
  <BackVideo look="deep" mp4="/assets/video/stride-showreel-desktop.mp4" webm="/assets/video/stride-showreel-desktop.webm" poster="/assets/site/stride-showreel-desktop-poster.jpg" blur={12} />
  <ComingSoon />
</SiteLayout>
