---
// Stride Advertising, /social (the owner, 2026-11-18: chosen from two drafts, it replaced the old page with its
// menu and Draft 2's dashboard): everything about Stride Social on one page, scrolled the way TikTok's web app plays its feed (the
// owner: "all the info shown only in 1 page ... scroll like a real TikTok, with the strategies"). One feed of tall
// posts, snapping from one to the next (the wheel, a swipe, the arrows or ↑/↓): the campaigns, Stride Social's own
// case-study reels, twenty of its best-known brands (config/stride-social-instagram.ts `reels`, from
// instagram.com/stridesociall; their captions as posted, first frames as posters), playing
// muted until the sound is turned on; and among them, every few campaigns, Stride Social's four strategies as photo
// posts, swiped sideways (a cover, then one slide per service, dots and a count; they turn by themselves while on
// screen, as TikTok's photo posts do). Beside each post: Like, Details, Save, Share and the spinning disc. Details opens
// a sheet over the side of the feed, as TikTok's comments do, with everything a service's page had (what it is, what's
// included, its questions, the campaigns that used it), so no post leads away to another page. The sidebar: a search,
// For You (everything) and Strategies (just the strategy posts), Talk to us, and the strategies in the feed, each
// opening its post (a creator on the roster shows with their photo beside their campaign and opens on /talent). Likes and saves stay in this browser; nothing is
// counted (no invented figures). Only the reel on screen and its neighbours load. Phones: the feed fills the screen
// under the header, the actions over the post's right edge, the sheet from the foot.
import { getEntry } from 'astro:content';
import { strideSocialInstagram as ig } from '@/config/stride-social-instagram';
import { strideInstagram as talent } from '@/config/stride-instagram';

const page = await getEntry('pages', 'social');
if (!page) throw new Error('Missing src/content/pages/social.yaml');
const s = page.data.sections;
const item = (key: string) => s.feed?.items?.find((i) => i.key === key);
const w = (key: string, fallback: string) => item(key)?.label ?? fallback;

// Every campaign is posted as @stridetalent, its logo beside it opening that account on Instagram, not the creator
// (the owner, 2026-11-18: "for every single video add @stridetalent ... and logo as well, not the creators"); the
// creator stays named in the caption.
const reels = ig.reels.map((r) => ({
  ...r,
  src: `/assets/video/stridesociall-reel-${r.code}.mp4`,
  poster: `/assets/site/stridesociall-reel-${r.code}-first.jpg`,
}));

// The strategies (social.yaml `menu`), each with the services it speaks of (as SocialMenu), and everything those
// services' own pages held: what it is, what's included, its questions, its pictures and the case studies that used it.
const groups: Record<string, string[]> = {
  'influencer-activations': ['influencer-activations', 'influencer-seeding'],
  'ugc-production': ['ugc-production'],
  'tiktok-shop': ['tiktok-shop', 'tiktok-shop-livestreams'],
  'influencer-events': ['influencer-events', 'podcast-activations'],
};
// A service's page copy as plain paragraphs (its markdown, without the editors' notes).
const paragraphs = (md: string | undefined) =>
  (md ?? '')
    .replace(/<!--[\s\S]*?-->/g, '')
    .split(/\n\s*\n/)
    .map((p) =>
      p
        .replace(/<[^>]+>/g, ' ')
        .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
        .replace(/[*_#>`]/g, '')
        .replace(/\s+/g, ' ')
        .trim(),
    )
    .filter((p) => p.length > 1);
const strategies = await Promise.all(
  (s.menu?.items ?? []).map(async (m, n) => {
    const entries = (await Promise.all((groups[m.key ?? ''] ?? []).map((id) => getEntry('services', id)))).flatMap((e) => (e ? [e] : []));
    const services = entries.map((e) => ({
      id: e.id,
      name: e.data.name,
      descriptor: e.data.descriptor,
      deliverables: e.data.deliverables,
      faqs: e.data.faqs,
      image: e.data.hero ?? e.data.gallery[0] ?? null,
      text: paragraphs(e.body),
    }));
    const cover = m.image ? { src: m.image, alt: m.alt ?? '', position: m.position } : services[0]?.image ? { ...services[0].image } : null;
    return { key: m.key ?? `strategy-${n}`, n: n + 1, label: m.label, copy: m.copy ?? '', cover, services };
  }),
);

// One feed: the campaigns, and after the 2nd, the 8th, the 14th and the 20th a strategy's services, one post each
// (the owner, 2026-11-18: "Influencer Seeding should be in the next scroll").
type Group = (typeof strategies)[number];
type Post = { kind: 'campaign'; i: number; r: (typeof reels)[number] } | { kind: 'strategy'; g: Group; sv: Group['services'][number]; k: number } | { kind: 'approach' };
// How Stride Social works, /social's "Our approach." (social.yaml `approach`): its four steps, each a slide with its
// picture and words, after the 5th campaign; the sidebar's "Our approach" opens it (the owner, 2026-11-18).
const approach = { eyebrow: s.approach?.eyebrow ?? 'How we work', headline: s.approach?.headline ?? 'Our approach.', steps: s.approach?.items ?? [] };
const posts: Post[] = [];
reels.forEach((r, i) => {
  posts.push({ kind: 'campaign', i, r });
  if (i === 4 && approach.steps.length) posts.push({ kind: 'approach' });
  const at = strategies[(i - 1) / 6];
  if (i >= 1 && (i - 1) % 6 === 0 && at) at.services.forEach((sv, k) => posts.push({ kind: 'strategy', g: at, sv, k }));
});
// A service post's slides: its strategy and name, its picture, what it is, what's included (where it has a list) and,
// last, "Start your campaign now." with the ways in (the owner, 2026-11-18, in place of the campaigns with it).
// Each service's picture slide plays one of Stride's own videos of that kind of work instead (the owner, 2026-11-18:
// "replace the miniatures for videos that make sense with what we're offering for each service"): a creator
// partnership (@joshandjem × Netflix UK), creators unboxing what was sent to them (@musaandstellaa × Miniso), a UGC
// video from the Temu case study, a creator from the Comfelie TikTok Shop case study, a creator's video ahead of a
// TikTok LIVE (@callum_wm17 × TikTok: no live-selling footage yet), Stride at VivaTech, and a podcast's ad (The
// Fellas × TrainPal). Each plays while its slide is on screen, with the feed's sound setting, and waits there.
// `position`: which part of the upright video the square shows, so a creator's own captions are either whole or out of
// frame, never cut (the owner, 2026-11-18): Temu's sit low and are left out; Callum's sit high and are kept whole, his
// credit going to the foot (`low`) so it doesn't cover them.
const reelVideo = (code: string, credit: string, position?: string, low = false) => ({ src: `/assets/video/ig-stridetalent-reel-${code}.mp4`, poster: `/assets/site/ig-stridetalent-reel-${code}-first.jpg`, credit, position, low });
const slideVideos: Record<string, { src: string; poster: string; credit: string; position?: string; low?: boolean }> = {
  'influencer-activations': reelVideo('DfFAs2oprqm', '@joshandjem × Netflix UK'),
  'influencer-seeding': reelVideo('DdG1xsDpXSx', '@musaandstellaa × Miniso'),
  'ugc-production': { src: '/assets/video/case-temu-2.mp4', poster: '/assets/site/case-temu-2-first.jpg', credit: 'Temu × Stride Social', position: '50% 0%' },
  'tiktok-shop': { src: '/assets/video/flowdrive-VDbaPLrkg8ffAjqF0f0AG.mp4', poster: '/assets/site/flowdrive-VDbaPLrkg8ffAjqF0f0AG-first.jpg', credit: 'Comfelie × TikTok Shop' },
  'tiktok-shop-livestreams': reelVideo('DfXCUFVJBeV', '@callum_wm17 × TikTok LIVE', '50% 28%', true),
  'influencer-events': { src: '/assets/video/stride-story-12.mp4', poster: '/assets/site/stride-story-12.jpg', credit: 'Stride at VivaTech' },
  'podcast-activations': { src: '/assets/video/stridesociall-reel-DBNqTDKRWyH.mp4', poster: '/assets/site/stridesociall-reel-DBNqTDKRWyH-first.jpg', credit: '@thefellasinsta × TrainPal' },
};
// Each service's thumbnail in the sidebar and the Details sheet: a frame of its own video (the owner, 2026-11-18:
// "replace these little miniatures accordingly"), public/assets/site/social-service-<id>.jpg; else its photo.
const thumbOf = (sv: Group['services'][number]) => (slideVideos[sv.id] ? `/assets/site/social-service-${sv.id}.jpg` : sv.image?.src ?? null);
const slidesFor = (sv: Group['services'][number]) => ['cover', ...(sv.image ? ['pic'] : []), 'about', ...(sv.deliverables.length ? ['included'] : []), 'close'];
const closeLine = item('close')?.label ?? 'Start your campaign now.';
const viewWork = item('viewWork');

const mark = '<svg viewBox="0 0 106 106" aria-hidden="true"><path d="M53 53H0L53 0v53Z"/><path d="M53 106H0l53-53v53Z"/><path d="M106 53H53l53-53v53Z"/><path d="M106 106H53l53-53v53Z"/></svg>';
// Stride's logo as it's drawn (the owner's file, 2026-11-18): every post's avatar, opening @stridetalent on Instagram.
const logo = '/assets/site/stride-logo-square.png';
const tick = '<path d="M19.998 3.094 14.638 0l-2.972 5.15H5.432v6.354L0 14.64 3.094 20 0 25.359l5.432 3.137v5.905h5.975L14.638 40l5.36-3.094L25.358 40l3.232-5.6h6.162v-6.01L40 25.359 36.905 20 40 14.641l-5.248-3.03v-6.46h-6.419L25.358 0l-5.36 3.094Zm7.415 11.225 2.254 2.287-11.43 11.5-6.835-6.93 2.244-2.258 4.587 4.581 9.18-9.18Z" fill="currentColor" fill-rule="evenodd"/>';
const icon = {
  heart: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"/>',
  bubble: '<path d="M12 4.5c4.7 0 8 3 8 6.8s-3.3 6.7-8 6.7c-1 0-1.9-.1-2.7-.4L5 19.5l1.2-3.6C4.8 14.7 4 13.1 4 11.3 4 7.5 7.3 4.5 12 4.5Z"/>',
  save: '<path d="M7 4.5h10v15l-5-3.5-5 3.5Z"/>',
  share: '<path d="M13.5 5 20 11l-6.5 6v-3.5c-4 0-7 1.2-9.5 4.5.8-5 3.5-8.5 9.5-9.5Z"/>',
  note: '<path d="M9 18V6l10-2v12"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="16.5" cy="16" r="2.5"/>',
};
---

<section class="fy" aria-labelledby="fy-title" data-tone="social" data-look="deep" data-fy data-lenis-prevent data-copied={w('copied', 'Link copied')} data-sound-on={w('soundOn', 'Sound on')} data-sound-off={w('soundOff', 'Sound off')}>
  <h1 class="visually-hidden" id="fy-title">{s.feed?.headline ?? 'Stride Social'}</h1>
  <div class="fy__shell">
    <aside class="fy__side" aria-label="Stride Social">
      <label class="fy__search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
        <input type="search" placeholder={w('search', 'Search campaigns')} aria-label={w('search', 'Search campaigns')} data-fy-search />
      </label>
      <nav class="fy__nav">
        <button class="fy__navlink" type="button" aria-pressed="true" data-fy-view="all">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5h-5v5H5a1 1 0 0 1-1-1Z"></path></svg>
          {w('forYou', 'For You')}
        </button>
        <button class="fy__navlink" type="button" aria-pressed="false" data-fy-view="strategy">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="m15.5 8.5-2 5-5 2 2-5Z"></path></svg>
          {w('strategies', 'Strategies')}
        </button>
        <button class="fy__navlink" type="button" data-fy-jump="approach">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5.5" cy="12" r="2"></circle><circle cx="12" cy="12" r="2"></circle><circle cx="18.5" cy="12" r="2"></circle><path d="M7.5 12h2.5M14 12h2.5"></path></svg>
          {w('approach', 'Our approach')}
        </button>
      </nav>
      {/* Every strategy in the feed, one row each, under its group's name (the owner, 2026-11-18: in place of the
          creators, "every single strategies, like a list"): a row opens its post, a group's name its first. */}
      {/* Social's approved line over its strategies, a sentence a line (the owner, 2026-11-18: "The right strategies. /
          Real impact."), in place of "Strategies in this feed". */}
      <p class="fy__label">
        {((s.hero.lines ?? []).join(' ') || 'The right strategies. Real impact.').split(/(?<=\.)\s+/).map((line, k) => (k ? <><br />{line}</> : line))}
      </p>
      <ul class="fy__creators" role="list" data-lenis-prevent>
        {strategies.map((g) => (
          <li class="fy__group">
            <button class="fy__group-name" type="button" data-fy-jump={`service-${g.services[0]?.id}`}>0{g.n} · {g.label}</button>
            <ul class="fy__group-list" role="list">
              {g.services.map((sv, k) => (
                <li>
                  <button class="fy__creator fy__creator--strategy" type="button" data-fy-jump={`service-${sv.id}`}>
                    {thumbOf(sv) ? <img src={thumbOf(sv)} alt="" loading="lazy" decoding="async" sizes="(min-width: 1921px) 2.1vw, 2.5rem" /> : <span class="fy__initial" set:html={mark} />}
                    <span class="fy__creator-text">
                      <span class="fy__creator-name">{sv.name}</span>
                      <span class="fy__creator-sub">{sv.descriptor}</span>
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </aside>

    <div class="fy__main">
      {/* As TikTok's "Following | For You": Strategies on the left, For You (the default) on the right (the owner,
          2026-11-18). */}
      <div class="fy__tabs" role="toolbar" aria-label="Feed">
        <button type="button" class="fy__tab" aria-pressed="false" data-fy-view="strategy">{w('strategies', 'Strategies')}</button>
        <button type="button" class="fy__tab" aria-pressed="true" data-fy-view="all">{w('forYou', 'For You')}</button>
      </div>

      <div class="fy__feed" data-fy-feed data-lenis-prevent tabindex="-1" aria-label="Stride Social">
        {posts.map((p) =>
          p.kind === 'campaign' ? (
            <article class="fy__item" data-fy-item data-kind="campaign" data-code={p.r.code} data-id={`campaign-${p.i}`} data-search={`${p.r.creator} ${p.r.client} ${p.r.title} ${p.r.text}`.toLowerCase()} aria-label={p.r.creator ? `${p.r.client}, with ${p.r.creator}` : p.r.client}>
              <div class="fy__card">
                <video class="fy__video" playsinline loop muted preload="none" data-sound="own" poster={p.r.poster} data-src={p.r.src} aria-hidden="true"></video>
                <button class="fy__tap" type="button" aria-label="Pause" data-fy-tap>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5Z"></path></svg>
                </button>
                <div class="fy__info">
                  <p class="fy__who">
                    <span data-fy-who>@{talent.handle}</span>
                    {talent.verified && (
                      <svg class="fy__verified" viewBox="0 0 40 40" role="img" aria-label="Verified">
                        <path d="M19.998 3.094 14.638 0l-2.972 5.15H5.432v6.354L0 14.64 3.094 20 0 25.359l5.432 3.137v5.905h5.975L14.638 40l5.36-3.094L25.358 40l3.232-5.6h6.162v-6.01L40 25.359 36.905 20 40 14.641l-5.248-3.03v-6.46h-6.419L25.358 0l-5.36 3.094Zm7.415 11.225 2.254 2.287-11.43 11.5-6.835-6.93 2.244-2.258 4.587 4.581 9.18-9.18Z" fill="currentColor" fill-rule="evenodd" />
                      </svg>
                    )}
                  </p>
                  <p class="fy__title">{p.r.title}</p>
                  {p.r.text && <p class="fy__text">{p.r.text}</p>}
                  <p class="fy__music">
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.note} />
                    <span class="fy__marquee"><span>{w('sound', 'original sound · Stride Social')} × {p.r.client}</span></span>
                  </p>
                </div>
                <span class="fy__bar" aria-hidden="true"><i></i></span>
              </div>
              <div class="fy__rail">
                <a class="fy__face fy__face--brand" href={talent.href} target="_blank" rel="noopener" aria-label={`@${talent.handle} on Instagram`}>
                  <img src={logo} alt="" width="150" height="150" loading="lazy" decoding="async" />
                  <span class="fy__plus" aria-hidden="true">+</span>
                </a>
                <button class="fy__act" type="button" aria-pressed="false" data-fy-like><span class="fy__act-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.heart} /></span><span class="fy__act-label">{w('like', 'Like')}</span></button>
                <button class="fy__act" type="button" data-fy-details aria-haspopup="dialog"><span class="fy__act-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.bubble} /></span><span class="fy__act-label">{w('details', 'Details')}</span></button>
                <button class="fy__act" type="button" aria-pressed="false" data-fy-save><span class="fy__act-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.save} /></span><span class="fy__act-label">{w('save', 'Save')}</span></button>
                <button class="fy__act" type="button" data-fy-share><span class="fy__act-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.share} /></span><span class="fy__act-label">{w('share', 'Share')}</span></button>
                <span class="fy__disc" aria-hidden="true" set:html={mark} />
              </div>
            </article>
          ) : p.kind === 'approach' ? (
            <article class="fy__item fy__item--strategy" data-fy-item data-kind="approach" data-code="approach" data-id="approach" data-search={`${approach.headline} ${approach.steps.map((x) => `${x.label} ${x.copy ?? ''}`).join(' ')}`.toLowerCase()} aria-label={approach.headline}>
              <div class="fy__card fy__card--photo">
                <span class="fy__stage" aria-hidden="true"></span>
                <div class="fy__slides" data-fy-slides data-lenis-prevent>
                  <section class="fy__slide fy__slide--cover" data-auto aria-label={approach.headline}>
                    <div class="fy__slide-body">
                      <span class="fy__slide-tag">{approach.eyebrow}</span>
                      <h2 class="fy__slide-title">{approach.headline}</h2>
                      <ol class="fy__steps-list" role="list">
                        {approach.steps.map((x, k) => (
                          <li><span>0{k + 1}</span>{x.label}</li>
                        ))}
                      </ol>
                      <span class="fy__swipe">{w('swipe', 'Swipe to read more')} <span aria-hidden="true">→</span></span>
                    </div>
                  </section>
                  {approach.steps.map((x, k) => (
                    <section class="fy__slide fy__slide--service" aria-label={x.label}>
                      <div class="fy__slide-scroll" data-lenis-prevent>
                        {x.image && <img class="fy__slide-pic" src={x.image} alt={x.alt ?? ''} loading="lazy" decoding="async" draggable="false" style={x.position ? `object-position: ${x.position}` : undefined} sizes="(min-width: 1921px) 21.7vw, (min-width: 1024px) 26rem, 80vw" />}
                        <span class="fy__slide-tag">0{k + 1} / 0{approach.steps.length}</span>
                        <h3 class="fy__slide-name">{x.label}</h3>
                        {x.copy && <p class="fy__sheet-text">{x.copy}</p>}
                      </div>
                    </section>
                  ))}
                  <section class="fy__slide fy__slide--close" aria-label={closeLine}>
                    <h3 class="fy__close-title">{closeLine}</h3>
                    <p class="fy__close-ways">
                      <a class="exp-pill exp-pill--ghost" href={viewWork?.href ?? '/work'}>{viewWork?.label ?? 'View case studies'}</a>
                      <a class="exp-pill exp-pill--glass" href={s.final?.cta?.href ?? '/social/enquire'}>{s.final?.cta?.label ?? 'Talk To Stride Social'} →</a>
                    </p>
                  </section>
                </div>
                <span class="fy__dots" aria-hidden="true">{[0, ...approach.steps, 0].map(() => <i></i>)}</span>
                <div class="fy__pager">
                  <button class="fy__slide-step exp-round" type="button" aria-label="Previous" data-fy-slide="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg></button>
                  <span class="fy__count" aria-live="polite" data-fy-count>1 / {approach.steps.length + 2}</span>
                  <button class="fy__slide-step exp-round" type="button" aria-label="Next" data-fy-slide="1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg></button>
                </div>
                <div class="fy__info fy__info--short">
                  <p class="fy__who"><span data-fy-who>@{talent.handle}</span>{talent.verified && <svg class="fy__verified" viewBox="0 0 40 40" role="img" aria-label="Verified" set:html={tick} />}</p>
                  <p class="fy__title">{approach.headline}</p>
                  <p class="fy__music">
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.note} />
                    <span class="fy__marquee"><span>{w('sound', 'original sound · Stride Social')} · {approach.steps.map((x) => x.label).join(' · ')}</span></span>
                  </p>
                </div>
                <span class="fy__bar" aria-hidden="true"><i></i></span>
              </div>
              <div class="fy__rail">
                <a class="fy__face fy__face--brand" href={talent.href} target="_blank" rel="noopener" aria-label={`@${talent.handle} on Instagram`}>
                  <img src={logo} alt="" width="150" height="150" loading="lazy" decoding="async" />
                  <span class="fy__plus" aria-hidden="true">+</span>
                </a>
                <button class="fy__act" type="button" aria-pressed="false" data-fy-like><span class="fy__act-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.heart} /></span><span class="fy__act-label">{w('like', 'Like')}</span></button>
                <button class="fy__act" type="button" data-fy-details aria-haspopup="dialog"><span class="fy__act-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.bubble} /></span><span class="fy__act-label">{w('details', 'Details')}</span></button>
                <button class="fy__act" type="button" aria-pressed="false" data-fy-save><span class="fy__act-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.save} /></span><span class="fy__act-label">{w('save', 'Save')}</span></button>
                <button class="fy__act" type="button" data-fy-share><span class="fy__act-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.share} /></span><span class="fy__act-label">{w('share', 'Share')}</span></button>
                <span class="fy__disc" aria-hidden="true" set:html={mark} />
              </div>
            </article>
          ) : (
            <article class="fy__item fy__item--strategy" data-fy-item data-kind="strategy" data-code={`service-${p.sv.id}`} data-id={`service-${p.sv.id}`} data-strategy={p.g.key} data-search={`${p.g.label} ${p.sv.name} ${p.sv.descriptor} ${p.sv.text.join(' ')} ${p.sv.deliverables.join(' ')}`.toLowerCase()} aria-label={`${p.g.label}: ${p.sv.name}`}>
              <div class="fy__card fy__card--photo">
                {/* The owner's own background behind every strategy (2026-11-18): navy, Stride's triangles faint in it. */}
                <span class="fy__stage" aria-hidden="true"></span>
                <div class="fy__slides" data-fy-slides data-lenis-prevent>
                  {slidesFor(p.sv).map((kind) => {
                    if (kind === 'cover')
                      return (
                        <section class="fy__slide fy__slide--cover" data-auto aria-label={`${p.g.label}: ${p.sv.name}`}>
                          <div class="fy__slide-body">
                            <span class="fy__slide-tag">{w('strategy', 'Strategy')} 0{p.g.n}{p.g.services.length > 1 ? ` · ${p.k + 1} / ${p.g.services.length}` : ''}</span>
                            <h2 class="fy__slide-title">{p.g.label}</h2>
                            <p class="fy__slide-sub">{p.sv.name}</p>
                            <span class="fy__swipe">{w('swipe', 'Swipe to read more')} <span aria-hidden="true">→</span></span>
                          </div>
                        </section>
                      );
                    if (kind === 'pic') {
                      const vid = slideVideos[p.sv.id];
                      return (
                        <section class="fy__slide fy__slide--pic" data-auto={vid ? undefined : ''} aria-label={p.sv.name}>
                          {vid ? (
                            <div class="fy__slide-media">
                              <video class="fy__slide-pic fy__slide-vid" muted loop playsinline preload="none" data-sound="own" poster={vid.poster} data-src={vid.src} aria-label={`${p.sv.name}: ${vid.credit}`} style={vid.position ? `object-position: ${vid.position}` : undefined}></video>
                              <span class:list={['fy__slide-credit', { 'fy__slide-credit--low': vid.low }]}>{vid.credit}</span>
                            </div>
                          ) : (
                            <img class="fy__slide-pic" src={p.sv.image!.src} alt={p.sv.image!.alt} loading="lazy" decoding="async" draggable="false" style={p.sv.image!.position ? `object-position: ${p.sv.image!.position}` : undefined} sizes="(min-width: 1921px) 21.7vw, (min-width: 1024px) 26rem, 80vw" />
                          )}
                          <h3 class="fy__slide-name">{p.sv.name}</h3>
                        </section>
                      );
                    }
                    if (kind === 'about')
                      return (
                        <section class="fy__slide fy__slide--service" aria-label={p.sv.name}>
                          <div class="fy__slide-scroll" data-lenis-prevent>
                            <h3 class="fy__slide-name">{p.sv.name}</h3>
                            <p class="fy__slide-lede">{p.sv.descriptor}</p>
                            {p.sv.text.map((x) => <p class="fy__sheet-text">{x}</p>)}
                          </div>
                        </section>
                      );
                    if (kind === 'included')
                      return (
                        <section class="fy__slide fy__slide--service" aria-label={w('included', "What's included")}>
                          <div class="fy__slide-scroll" data-lenis-prevent>
                            <h3 class="fy__slide-name">{w('included', "What's included")}</h3>
                            <ul class="fy__ticks fy__ticks--big" role="list">{p.sv.deliverables.map((d) => <li>{d}</li>)}</ul>
                          </div>
                        </section>
                      );
                    return (
                      <section class="fy__slide fy__slide--close" aria-label={closeLine}>
                        <h3 class="fy__close-title">{closeLine}</h3>
                        <p class="fy__close-ways">
                          <a class="exp-pill exp-pill--ghost" href={viewWork?.href ?? '/work'}>{viewWork?.label ?? 'View case studies'}</a>
                          <a class="exp-pill exp-pill--glass" href={s.final?.cta?.href ?? '/social/enquire'}>{s.final?.cta?.label ?? 'Talk To Stride Social'} →</a>
                        </p>
                      </section>
                    );
                  })}
                </div>
                <span class="fy__dots" aria-hidden="true">{slidesFor(p.sv).map(() => <i></i>)}</span>
                {/* Its pager at the top right, clear of every slide's words (the owner, 2026-11-18: the arrows covered them). */}
                <div class="fy__pager">
                  <button class="fy__slide-step exp-round" type="button" aria-label="Previous" data-fy-slide="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg></button>
                  <span class="fy__count" aria-live="polite" data-fy-count>1 / {slidesFor(p.sv).length}</span>
                  <button class="fy__slide-step exp-round" type="button" aria-label="Next" data-fy-slide="1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg></button>
                </div>
                <div class="fy__info fy__info--short">
                  <p class="fy__who"><span data-fy-who>@{talent.handle}</span>{talent.verified && <svg class="fy__verified" viewBox="0 0 40 40" role="img" aria-label="Verified" set:html={tick} />}</p>
                  <p class="fy__title">{p.sv.name}</p>
                  <p class="fy__music">
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.note} />
                    <span class="fy__marquee"><span>{w('sound', 'original sound · Stride Social')} · {p.g.label}</span></span>
                  </p>
                </div>
                <span class="fy__bar" aria-hidden="true"><i></i></span>
              </div>
              <div class="fy__rail">
                <a class="fy__face fy__face--brand" href={talent.href} target="_blank" rel="noopener" aria-label={`@${talent.handle} on Instagram`}>
                  <img src={logo} alt="" width="150" height="150" loading="lazy" decoding="async" />
                  <span class="fy__plus" aria-hidden="true">+</span>
                </a>
                <button class="fy__act" type="button" aria-pressed="false" data-fy-like><span class="fy__act-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.heart} /></span><span class="fy__act-label">{w('like', 'Like')}</span></button>
                <button class="fy__act" type="button" data-fy-details aria-haspopup="dialog"><span class="fy__act-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.bubble} /></span><span class="fy__act-label">{w('details', 'Details')}</span></button>
                <button class="fy__act" type="button" aria-pressed="false" data-fy-save><span class="fy__act-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.save} /></span><span class="fy__act-label">{w('save', 'Save')}</span></button>
                <button class="fy__act" type="button" data-fy-share><span class="fy__act-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.share} /></span><span class="fy__act-label">{w('share', 'Share')}</span></button>
                <span class="fy__disc" aria-hidden="true" set:html={mark} />
              </div>
            </article>
          ),
        )}
        <div class="fy__end" data-fy-end>
          <span class="fy__end-mark" set:html={mark} />
          <p class="fy__end-title">{w('end', "You're all caught up.")}</p>
          <p class="fy__end-line">{s.final?.headline ?? 'Your next campaign starts here.'}</p>
          <p class="fy__end-ways">
            <a class="exp-pill exp-pill--glass" href={s.final?.cta?.href ?? '/social/enquire'}>{s.final?.cta?.label ?? 'Talk To Stride Social'} →</a>
          </p>
        </div>
        <p class="fy__none" data-fy-none hidden>{w('none', 'No campaigns match that.')}</p>
      </div>

      <button class="fy__sound exp-round" type="button" aria-label={w('soundOn', 'Sound on')} data-fy-sound>
        <svg class="fy__sound-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4Z"></path><path d="M16 9.5l5 5M21 9.5l-5 5"></path></svg>
        <svg class="fy__sound-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4Z"></path><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"></path></svg>
      </button>
      <div class="fy__steps">
        <button class="exp-round" type="button" aria-label="Previous post" data-fy-step="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6"></path></svg></button>
        <button class="exp-round" type="button" aria-label="Next post" data-fy-step="1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></button>
      </div>
    </div>
  </div>

  {/* Details, as TikTok's comments sheet: a campaign's caption, or a strategy's services (a service's whole page is in
      its own slide). */}
  <aside class="fy__drawer" role="dialog" aria-modal="false" aria-label={w('details', 'Details')} data-fy-drawer data-lenis-prevent hidden>
    <button class="fy__drawer-close exp-round" type="button" aria-label="Close" data-fy-close>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>
    <div class="fy__sheet" data-fy-sheet="campaign" hidden>
      <p class="fy__sheet-kicker" data-fy-d-who></p>
      <h2 class="fy__sheet-title" data-fy-d-title></h2>
      <p class="fy__sheet-text" data-fy-d-text></p>
      <a class="exp-pill exp-pill--glass" href={ig.href} target="_blank" rel="noopener" data-fy-d-ig>{w('instagram', 'View on Instagram')} →</a>
    </div>
    <div class="fy__sheet" data-fy-sheet="approach" hidden>
      <p class="fy__sheet-kicker">{approach.eyebrow}</p>
      <h2 class="fy__sheet-title">{approach.headline}</h2>
      <ul class="fy__sheet-list" role="list">
        {approach.steps.map((x, k) => (
          <li>
            <button type="button" class="fy__sheet-service" data-fy-jump="approach" data-fy-slide-to={k + 1}>
              {x.image && <img src={x.image} alt="" loading="lazy" decoding="async" sizes="(min-width: 1921px) 3.4vw, 4rem" style={x.position ? `object-position: ${x.position}` : undefined} />}
              <span><b>0{k + 1} · {x.label}</b><small>{x.copy}</small></span>
            </button>
          </li>
        ))}
      </ul>
    </div>
    {strategies.map((g) => (
      <div class="fy__sheet" data-fy-sheet={`strategy-${g.key}`} hidden>
        <p class="fy__sheet-kicker">{w('strategy', 'Strategy')} 0{g.n}</p>
        <h2 class="fy__sheet-title">{g.label}</h2>
        <p class="fy__sheet-text">{g.copy}</p>
        <p class="fy__sheet-head">{w('servicesIn', 'Its services')}</p>
        <ul class="fy__sheet-list" role="list">
          {g.services.map((sv, k) => (
            <li>
              <button type="button" class="fy__sheet-service" data-fy-jump={`service-${sv.id}`}>
                {thumbOf(sv) && <img src={thumbOf(sv)} alt="" loading="lazy" decoding="async" sizes="(min-width: 1921px) 3.4vw, 4rem" />}
                <span><b>{sv.name}</b><small>{sv.descriptor}</small></span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </aside>
  <p class="fy__toast" role="status" aria-live="polite" data-fy-toast></p>
</section>

<style>
  .fy {
    position: relative;
    padding-top: var(--header-h);
    color: rgb(var(--ink));
  }

  /* The sidebar, the feed and its actions, side by side in the middle, clear of the edge menu. */
  .fy__shell {
    display: grid;
    grid-template-columns: 15rem auto;
    justify-content: center;
    gap: 3rem;
    height: calc(100svh - var(--header-h));
    padding: 0 max(var(--margin), 14.5rem) 1rem;
  }

  /* ---------- The sidebar ---------- */
  .fy__side {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-height: 0;
    padding-top: 1rem;
  }



  .fy__face--brand :global(svg) {
    width: 55%;
    fill: var(--ice);
  }

  .fy__search {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: rgb(var(--white-rgb) / 0.08);
    box-shadow: inset 0 0 0 1px rgb(var(--white-rgb) / 0.12);
  }

  .fy__search:focus-within {
    box-shadow: inset 0 0 0 1px rgb(var(--ice-rgb) / 0.7);
  }

  .fy__search svg,
  .fy__navlink svg {
    flex: none;
    width: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fy__search input {
    width: 100%;
    min-width: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.9375rem;
    outline: none;
  }

  .fy__search input::placeholder {
    color: rgb(var(--white-rgb) / 0.55);
  }

  .fy__nav {
    display: grid;
    gap: 0.125rem;
  }

  .fy__navlink {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    width: 100%;
    padding: 0.625rem 0.75rem;
    border-radius: 0.625rem;
    color: rgb(var(--white-rgb) / 0.82);
    font: inherit;
    font-size: 1.0625rem;
    font-weight: 650;
    text-align: left;
    transition:
      background-color 200ms var(--ease-out),
      color 200ms var(--ease-out);
  }

  .fy__navlink:hover {
    background: rgb(var(--white-rgb) / 0.07);
    color: var(--white);
  }

  .fy__navlink[aria-pressed='true'] {
    color: var(--ice);
  }

  .fy__navlink[aria-pressed='true'] svg {
    fill: rgb(var(--ice-rgb) / 0.25);
  }

  /* Social's line over the list, in its display type, a sentence a line (sized so "The right strategies." fits). */
  .fy__label {
    padding: 1.125rem 0.75rem 0;
    border-top: 1px solid rgb(var(--white-rgb) / 0.12);
    color: var(--white);
    font-family: var(--font-display);
    font-size: 1rem;
    white-space: nowrap;
    font-weight: 850;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .fy__creators {
    min-height: 0;
    margin: 0 -0.25rem;
    padding: 0 0.25rem 1rem;
    overflow-y: auto;
    scrollbar-width: thin;
    list-style: none;
  }

  .fy__creator {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.375rem 0.5rem;
    border-radius: 0.625rem;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    text-align: left;
  }

  .fy__creator:hover {
    background: rgb(var(--white-rgb) / 0.07);
  }

  .fy__creator img,
  .fy__creator .fy__initial {
    flex: none;
    width: 2rem;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
  }

  .fy__creator-name {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* A strategy in the list: its picture, its name and its services under it. */
  .fy__group + .fy__group {
    margin-top: 0.75rem;
  }

  .fy__group-name {
    display: block;
    width: 100%;
    padding: 0.375rem 0.5rem 0.25rem;
    color: var(--ice);
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-align: left;
    text-transform: uppercase;
  }

  .fy__group-name:hover {
    color: var(--white);
  }

  .fy__group-list {
    list-style: none;
  }

  .fy__creator--strategy img,
  .fy__creator--strategy .fy__initial {
    width: 2.5rem;
    border-radius: 0.5rem;
  }

  .fy__creator-text {
    display: grid;
    min-width: 0;
  }

  .fy__creator--strategy .fy__creator-name {
    white-space: normal;
    line-height: 1.2;
  }

  .fy__creator-sub {
    overflow: hidden;
    color: rgb(var(--white-rgb) / 0.6);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .fy__creator-count {
    margin-left: auto;
    color: rgb(var(--white-rgb) / 0.5);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .fy__initial {
    display: grid;
    place-items: center;
    background: var(--navy-500);
    color: var(--ice);
    font-family: var(--font-display);
    font-weight: 850;
  }

  /* ---------- The feed ---------- */
  .fy__main {
    position: relative;
    min-height: 0;
  }

  .fy__tabs {
    position: absolute;
    top: 1.5rem;
    left: calc(50% - 2.25rem);
    z-index: 3;
    display: flex;
    gap: 1.5rem;
    translate: -50% 0;
    pointer-events: none;
  }

  .fy__tab {
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
    color: rgb(var(--white-rgb) / 0.7);
    font: inherit;
    font-size: 1rem;
    font-weight: 700;
    text-shadow: 0 0.0625rem 0.5rem rgb(0 0 0 / 0.5);
    pointer-events: auto;
  }

  .fy__tab[aria-pressed='true'] {
    border-color: var(--white);
    color: var(--white);
  }

  .fy__feed {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior-y: auto;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
    outline: none;
  }

  .fy__feed::-webkit-scrollbar {
    display: none;
  }

  .fy__item,
  .fy__end {
    height: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .fy__item {
    display: grid;
    grid-template-columns: auto 4.5rem;
    align-items: end;
    justify-content: center;
    gap: 1.25rem;
    padding: 1rem 0;
  }

  .fy__item[hidden],
  .fy__end[hidden] {
    display: none;
  }

  .fy__card {
    position: relative;
    height: calc(100svh - var(--header-h) - 3rem);
    max-height: 52rem;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: 1rem;
    background: rgb(0 0 0);
    /* No drop shadow: the one under the post before bled into the top of the next (the owner, 2026-11-18). */
    box-shadow: inset 0 0 0 1px rgb(var(--white-rgb) / 0.08);
    transform: scale(0.96);
    opacity: 0.55;
    transition:
      transform 500ms var(--ease-out),
      opacity 500ms var(--ease-out);
  }

  .fy__item.is-active .fy__card {
    transform: none;
    opacity: 1;
  }

  .fy__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fy__tap {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .fy__tap svg {
    width: 4.5rem;
    fill: rgb(var(--white-rgb) / 0.88);
    filter: drop-shadow(0 0 1rem rgb(0 0 0 / 0.45));
    opacity: 0;
    scale: 0.8;
    transition:
      opacity 200ms var(--ease-out),
      scale 200ms var(--ease-out);
  }

  .fy__item.is-paused .fy__tap svg {
    opacity: 1;
    scale: 1;
  }

  .fy__info {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    display: grid;
    gap: 0.375rem;
    padding: 5rem 1.25rem 1.5rem;
    background: linear-gradient(to top, rgb(0 0 0 / 0.78), rgb(0 0 0 / 0.35) 60%, transparent);
    color: var(--white);
    pointer-events: none;
  }

  .fy__info--short {
    padding-top: 3rem;
  }

  .fy__who {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.0625rem;
    font-weight: 750;
  }

  .fy__badge {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: rgb(var(--ice-rgb) / 0.22);
    box-shadow: inset 0 0 0 1px rgb(var(--ice-rgb) / 0.5);
    color: var(--ice);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .fy__title {
    font-size: 0.9375rem;
    font-weight: 650;
  }

  .fy__text {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: rgb(var(--white-rgb) / 0.85);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .fy__music {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    font-size: 0.8125rem;
  }

  .fy__music svg {
    flex: none;
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .fy__marquee {
    overflow: hidden;
    white-space: nowrap;
    mask: linear-gradient(to right, transparent, #000 0.75rem, #000 calc(100% - 1.5rem), transparent);
  }

  .fy__marquee span {
    display: inline-block;
    padding-left: 0.75rem;
  }

  .fy__item.is-active .fy__marquee span {
    animation: fy-marquee 9s linear infinite;
  }

  @keyframes fy-marquee {
    from {
      transform: translateX(40%);
    }
    to {
      transform: translateX(-100%);
    }
  }

  .fy__bar {
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    height: 0.1875rem;
    background: rgb(var(--white-rgb) / 0.2);
  }

  .fy__bar i {
    position: absolute;
    inset: 0;
    background: var(--ice);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* ---------- A strategy: a photo post, swiped sideways ---------- */
  .fy__card--photo {
    background: var(--navy-700);
  }

  /* Behind a strategy: the owner's own background, navy with Stride's triangles faint in it, filling the post. */
  .fy__stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--navy-900) url('/assets/site/social-strategy-bg.jpg') center / cover no-repeat;
    pointer-events: none;
  }

  /* A service's slide: its picture and whole page, scrolled inside the slide, fading out under the dots and the foot. */
  .fy__slide.fy__slide--service {
    align-content: stretch;
    padding: 0;
  }

  .fy__slide-scroll {
    display: grid;
    align-content: safe center;
    gap: 0.75rem;
    height: 100%;
    padding: 6.5rem 1.5rem 9.5rem;
    overflow-y: auto;
    overscroll-behavior-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--ice-rgb) / 0.35) transparent;
    mask-image: linear-gradient(to bottom, transparent 0, transparent 4.5rem, #000 6.25rem, #000 calc(100% - 10rem), transparent calc(100% - 7rem));
  }

  /* The cover: the strategy, and under it the service this post is about. */
