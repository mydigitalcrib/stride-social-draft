<script>
  import { reduced } from '@/scripts/system/env';
  import { whenLoaded } from '@/scripts/system/loaded';
  import { setSoundWanted, soundAllowed, soundWanted, whenSoundAllowed } from '@/scripts/system/sound';

  const LIKED = 'stride:fy-liked';
  const SAVED = 'stride:fy-saved';
  const PHOTO_MS = 4500; // a strategy's slide, before it turns by itself
  const read = (key: string): Set<string> => {
    try {
      return new Set(JSON.parse(localStorage.getItem(key) || '[]') as string[]);
    } catch {
      return new Set();
    }
  };
  const write = (key: string, set: Set<string>) => {
    try {
      localStorage.setItem(key, JSON.stringify([...set]));
    } catch {
      /* a private window: it just isn't remembered */
    }
  };

  document.querySelectorAll<HTMLElement>('[data-fy]').forEach((root) => {
    const feed = root.querySelector<HTMLElement>('[data-fy-feed]')!;
    const items = [...root.querySelectorAll<HTMLElement>('[data-fy-item]')];
    const end = root.querySelector<HTMLElement>('[data-fy-end]');
    const none = root.querySelector<HTMLElement>('[data-fy-none]');
    const sound = root.querySelector<HTMLButtonElement>('[data-fy-sound]');
    const drawer = root.querySelector<HTMLElement>('[data-fy-drawer]');
    const toast = root.querySelector<HTMLElement>('[data-fy-toast]');
    const search = root.querySelector<HTMLInputElement>('[data-fy-search]');
    const liked = read(LIKED);
    const saved = read(SAVED);
    let active = -1;
    // Sound on (the owner, 2026-11-18): as soon as the browser allows it (the visitor's first click), unless they turned
    // it off with a sound button somewhere on the site (sound.ts).
    let muted = !(soundWanted() && soundAllowed());
    let inView = true;
    let started = false;
    let kind: 'all' | 'strategy' = 'all';
    let photoTime = 0;
    let last = 0;
    root.classList.toggle('is-muted', muted);

    const video = (i: number) => items[i]?.querySelector<HTMLVideoElement>('.fy__video') ?? null;
    const slidesOf = (i: number) => items[i]?.querySelector<HTMLElement>('[data-fy-slides]') ?? null;
    const slideVideo = (i: number) => items[i]?.querySelector<HTMLVideoElement>('.fy__slide-vid') ?? null;
    const load = (i: number) => {
      const v = video(i);
      if (v && !v.getAttribute('src') && v.dataset.src) {
        v.src = v.dataset.src;
        v.preload = 'auto';
      }
      // A slide's campaign: ready to start, the rest coming as it plays.
      const s = slideVideo(i);
      if (s && !s.getAttribute('src') && s.dataset.src) {
        s.src = s.dataset.src;
        s.preload = 'metadata';
      }
    };
    const shown = () => items.filter((it) => !it.hidden);
    const running = (i: number) => i === active && started && inView && !document.hidden && !items[i].classList.contains('is-paused');

    // Only the campaign on screen plays, while the feed is in view and the page is open.
    const sync = () => {
      items.forEach((it, i) => {
        const v = video(i);
        if (v) {
          v.muted = muted;
          if (running(i)) v.play().catch(() => it.classList.add('is-paused'));
          else v.pause();
        }
        syncSlide(i);
      });
    };
    // A slide's campaign plays only while its slide is the one showing in the post on screen.
    const syncSlide = (i: number) => {
      const s = slideVideo(i);
      if (!s) return;
      s.muted = muted;
      const el = slidesOf(i);
      const showing = !!el && s.closest('.fy__slide') === el.children[Math.round(el.scrollLeft / Math.max(1, el.clientWidth))];
      if (running(i) && showing) s.play().catch(() => {});
      else s.pause();
    };

    // A strategy's slides: which one is showing, its dot and count; the arrows at either end.
    const slideAt = (i: number) => {
      const el = slidesOf(i);
      return el ? Math.round(el.scrollLeft / Math.max(1, el.clientWidth)) : 0;
    };
    const paintSlides = (i: number) => {
      const el = slidesOf(i);
      if (!el) return;
      const at = slideAt(i);
      const n = el.children.length;
      items[i].querySelectorAll('.fy__dots i').forEach((d, k) => d.classList.toggle('is-on', k === at));
      const count = items[i].querySelector<HTMLElement>('[data-fy-count]');
      if (count) count.textContent = `${at + 1} / ${n}`;
      const prev = items[i].querySelector<HTMLButtonElement>('[data-fy-slide="-1"]');
      const next = items[i].querySelector<HTMLButtonElement>('[data-fy-slide="1"]');
      if (prev) prev.disabled = at === 0;
      if (next) next.disabled = at === n - 1;
      syncSlide(i);
    };
    const goSlide = (i: number, to: number) => {
      const el = slidesOf(i);
      if (!el) return;
      const k = Math.max(0, Math.min(el.children.length - 1, to));
      el.scrollTo({ left: k * el.clientWidth, behavior: reduced() ? 'auto' : 'smooth' });
      photoTime = 0;
    };
    items.forEach((it, i) => {
      const el = slidesOf(i);
      if (!el) return;
      let frame = 0;
      el.addEventListener('scroll', () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => paintSlides(i));
      });
      el.addEventListener('scrollend', () => paintSlides(i));
      // A finger or a drag on it resets its timer.
      el.addEventListener('pointerdown', () => (photoTime = 0));
      // A mouse drags the slides sideways, as a finger swipes them (the owner, 2026-11-18): let go past a sixth of the
      // way and it turns to the next or the one before; a drag never also follows a link it started on.
      let drag: { x: number; left: number; moved: boolean } | null = null;
      let dragged = false;
      el.addEventListener('pointerdown', (e) => {
        if (e.pointerType !== 'mouse' || e.button !== 0) return;
        drag = { x: e.clientX, left: el.scrollLeft, moved: false };
        dragged = false;
      });
      el.addEventListener('pointermove', (e) => {
        if (!drag) return;
        const dx = e.clientX - drag.x;
        if (!drag.moved && Math.abs(dx) > 5) {
          drag.moved = true;
          el.setPointerCapture(e.pointerId);
          el.classList.add('is-dragging');
        }
        if (drag.moved) el.scrollLeft = drag.left - dx;
      });
      const drop = (e: PointerEvent) => {
        if (!drag) return;
        const { moved, left, x } = drag;
        drag = null;
        if (!moved) return;
        dragged = true;
        el.classList.remove('is-dragging');
        const from = Math.round(left / Math.max(1, el.clientWidth));
        const dx = e.clientX - x;
        goSlide(i, Math.abs(dx) > el.clientWidth / 6 ? from + (dx < 0 ? 1 : -1) : from);
      };
      el.addEventListener('pointerup', drop);
      el.addEventListener('pointercancel', drop);
      // The browser's own dragging of a link or a picture would take the gesture away.
      el.addEventListener('dragstart', (e) => e.preventDefault());
      el.addEventListener(
        'click',
        (e) => {
          if (!dragged) return;
          dragged = false;
          e.preventDefault();
          e.stopPropagation();
        },
        true,
      );
      paintSlides(i);
    });

    const setActive = (i: number) => {
      if (i === active || i < 0) return;
      active = i;
      photoTime = 0;
      items.forEach((it, n) => it.classList.toggle('is-active', n === i));
      items[i].classList.remove('is-paused');
      load(i);
      const list = shown();
      const k = list.indexOf(items[i]);
      [list[k + 1], list[k - 1]].forEach((it) => it && load(items.indexOf(it)));
      sync();
    };

    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && setActive(items.indexOf(e.target as HTMLElement))),
      { root: feed, threshold: 0.6 },
    );
    items.forEach((it) => io.observe(it));
    new IntersectionObserver((entries) => {
      inView = entries[entries.length - 1].isIntersecting;
      sync();
    }, { threshold: 0.3 }).observe(feed);
    document.addEventListener('visibilitychange', sync);

    // Every frame: a campaign's progress line, or a strategy's slide timer, turning to the next slide at its end.
    const tick = (now: number) => {
      const dt = Math.min(100, now - (last || now));
      last = now;
      const it = items[active];
      const bar = it?.querySelector<HTMLElement>('.fy__bar i');
      const v = video(active);
      if (v && bar && v.duration) bar.style.transform = `scaleX(${v.currentTime / v.duration})`;
      const el = slidesOf(active);
      if (el && bar) {
        const at = slideAt(active);
        const n = el.children.length;
        const slide = el.children[at] as HTMLElement | undefined;
        if (slide?.hasAttribute('data-auto') && at < n - 1) {
          // The cover and the picture turn by themselves; the slides to read wait.
          if (running(active) && !reduced() && !(drawer && !drawer.hidden)) photoTime += dt;
          bar.style.transform = `scaleX(${(at + Math.min(1, photoTime / PHOTO_MS)) / Math.max(1, n - 1)})`;
          if (photoTime >= PHOTO_MS) goSlide(active, at + 1);
        } else bar.style.transform = `scaleX(${at / Math.max(1, n - 1)})`;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    const scrollToEl = (el: HTMLElement | null | undefined, smooth = true) => {
      if (el) feed.scrollTo({ top: el.offsetTop, behavior: smooth && !reduced() ? 'smooth' : 'auto' });
    };
    const go = (dir: number) => {
      const list = shown();
      const k = list.indexOf(items[active]);
      scrollToEl(dir > 0 ? (list[k + 1] ?? end) : list[Math.max(0, k - 1)]);
    };

    // The whole feed scrolls as TikTok does, a post at a time (the owner, 2026-11-18: on a laptop the page could come to
    // rest part way, the post cut off at the bottom): a turn of the wheel anywhere over the feed's screen steps the feed
    // and never the page; past the last post (its "caught up") the page glides on, whole, to the close below, and coming
    // back up it glides back, whole, to the feed. What scrolls on its own inside keeps the wheel while it can (the
    // strategies' list, a slide's long words, the Details drawer). And if the page is left part way some other way (the
    // scrollbar, the keyboard), it settles onto the feed or the close, whichever it was heading for.
    const GESTURE = 220; // ms without the wheel that ends a gesture (a trackpad's swipe and its glide are one)
    let wheelAt = 0;
    let wheelDir = 0;
    const scrollsItself = (el: Element | null, dy: number) => {
      for (let n = el; n && n !== root; n = n.parentElement) {
        if (n === feed) return false;
        if (n === drawer) return true;
        const oy = getComputedStyle(n).overflowY;
        if ((oy === 'auto' || oy === 'scroll') && n.scrollHeight > n.clientHeight + 1 && (dy > 0 ? n.scrollTop + n.clientHeight < n.scrollHeight - 1 : n.scrollTop > 0)) return true;
      }
      return false;
    };
    const top = () => root.getBoundingClientRect().top + window.scrollY;
    const pageTo = (y: number) => {
      const l = (window as unknown as { lenis?: { scrollTo(y: number, o: object): void } }).lenis;
      if (l) l.scrollTo(y, { duration: reduced() ? 0 : 0.8, force: true });
      else window.scrollTo({ top: y, behavior: reduced() ? 'auto' : 'smooth' });
    };
    root.addEventListener(
      'wheel',
      (e) => {
        if (e.ctrlKey || !e.deltaY || Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
        if (scrollsItself(e.target as Element, e.deltaY)) return;
        e.preventDefault();
        const dir = Math.sign(e.deltaY);
        const now = performance.now();
        const fresh = now - wheelAt > GESTURE || dir !== wheelDir;
        wheelAt = now;
        wheelDir = dir;
        if (!fresh) return;
        const y = top();
        // The page part way off the feed: onto the feed, or the close below, whole.
        if (Math.abs(window.scrollY - y) > 2) return pageTo(dir > 0 ? y + root.offsetHeight : y);
        const atEnd = feed.scrollTop + feed.clientHeight >= feed.scrollHeight - 2;
        if (dir > 0 && atEnd) return pageTo(y + root.offsetHeight);
        if (dir < 0 && feed.scrollTop <= 1) return;
        go(dir);
      },
      { passive: false },
    );
    let lastY = window.scrollY;
    let heading = 0;
    let settle = 0;
    window.addEventListener(
      'scroll',
      () => {
        const sy = window.scrollY;
        if (sy !== lastY) heading = Math.sign(sy - lastY);
        lastY = sy;
        window.clearTimeout(settle);
        settle = window.setTimeout(() => {
          const y = top();
          const h = root.offsetHeight;
          const off = window.scrollY - y;
          if (off <= 2 || off >= h - 2) return;
          pageTo(heading > 0 ? (off > h * 0.25 ? y + h : y) : off < h * 0.75 ? y : y + h);
        }, 180);
      },
      { passive: true },
    );

    const say = (text: string) => {
      if (!toast) return;
      toast.textContent = text;
      toast.classList.add('is-on');
      window.setTimeout(() => toast.classList.remove('is-on'), 1800);
    };

    // For You shows every post, Strategies just the strategies; the search narrows either.
    const filter = () => {
      const needle = (search?.value ?? '').trim().toLowerCase();
      items.forEach((it) => (it.hidden = (kind === 'strategy' && it.dataset.kind !== 'strategy') || (!!needle && !(it.dataset.search ?? '').includes(needle))));
      const list = shown();
      if (none) none.hidden = list.length > 0;
      if (end) end.hidden = list.length === 0;
      feed.scrollTop = 0;
      active = -1;
      if (list[0]) setActive(items.indexOf(list[0]));
    };
    const setKind = (next: 'all' | 'strategy') => {
      kind = next;
      root.querySelectorAll<HTMLButtonElement>('[data-fy-view]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.fyView === next)));
      filter();
    };

    // Details: the sheet for what's on screen (a campaign, a strategy's cover, or the service its slide shows).
    const showSheet = (key: string) => {
      if (!drawer) return;
      drawer.querySelectorAll<HTMLElement>('[data-fy-sheet]').forEach((sh) => (sh.hidden = sh.dataset.fySheet !== key));
      drawer.hidden = false;
      drawer.scrollTop = 0;
      drawer.querySelector<HTMLButtonElement>('[data-fy-close]')?.focus({ preventScroll: true });
    };
    const openDetails = (it: HTMLElement) => {
      if (!drawer) return;
      if (it.dataset.kind === 'campaign') {
        const sheet = drawer.querySelector<HTMLElement>('[data-fy-sheet="campaign"]')!;
        sheet.querySelector('[data-fy-d-who]')!.textContent = it.querySelector('[data-fy-who]')?.textContent ?? '';
        sheet.querySelector('[data-fy-d-title]')!.textContent = it.querySelector('.fy__title')?.textContent ?? '';
        sheet.querySelector('[data-fy-d-text]')!.textContent = it.querySelector('.fy__text')?.textContent ?? '';
        (sheet.querySelector('[data-fy-d-text]') as HTMLElement).hidden = !it.querySelector('.fy__text');
        sheet.querySelector<HTMLAnchorElement>('[data-fy-d-ig]')!.href = `https://www.instagram.com/reel/${it.dataset.code}/`;
        return showSheet('campaign');
      }
      showSheet(it.dataset.kind === 'approach' ? 'approach' : `strategy-${it.dataset.strategy}`);
    };
    const closeDrawer = () => {
      if (drawer && !drawer.hidden) drawer.hidden = true;
    };

    // Likes and saves: remembered in this browser, nothing counted.
    items.forEach((it) => {
      const code = it.dataset.code ?? '';
      it.querySelector('[data-fy-like]')?.setAttribute('aria-pressed', String(liked.has(code)));
      it.querySelector('[data-fy-save]')?.setAttribute('aria-pressed', String(saved.has(code)));
    });

    root.addEventListener('click', (e) => {
      const t = e.target as Element;
      const it = t.closest<HTMLElement>('[data-fy-item]');
      const toggle = (btn: HTMLElement, set: Set<string>, key: string) => {
        const code = it?.dataset.code ?? '';
        const on = !set.has(code);
        if (on) set.add(code);
        else set.delete(code);
        write(key, set);
        btn.setAttribute('aria-pressed', String(on));
        btn.classList.remove('is-pop');
        void btn.offsetWidth;
        if (on) btn.classList.add('is-pop');
      };
      const like = t.closest<HTMLElement>('[data-fy-like]');
      if (like && it) return toggle(like, liked, LIKED);
      const save = t.closest<HTMLElement>('[data-fy-save]');
      if (save && it) return toggle(save, saved, SAVED);
      if (t.closest('[data-fy-details]') && it) return openDetails(it);
      if (t.closest('[data-fy-close]')) return closeDrawer();
      if (t.closest('[data-fy-share]') && it) {
        const url = `${location.origin}${location.pathname}#${it.dataset.code}`;
        if (navigator.share && matchMedia('(pointer: coarse)').matches) navigator.share({ url }).catch(() => {});
        else navigator.clipboard?.writeText(url).then(() => say(root.dataset.copied ?? 'Link copied'), () => {});
        return;
      }
      if (t.closest('[data-fy-tap]') && it) {
        it.classList.toggle('is-paused');
        t.closest('[data-fy-tap]')?.setAttribute('aria-label', it.classList.contains('is-paused') ? 'Play' : 'Pause');
        return sync();
      }
      const slideBtn = t.closest<HTMLElement>('[data-fy-slide]');
      if (slideBtn && it) return goSlide(items.indexOf(it), slideAt(items.indexOf(it)) + Number(slideBtn.dataset.fySlide));
      const step = t.closest<HTMLElement>('[data-fy-step]');
      if (step) return go(Number(step.dataset.fyStep));
      const viewBtn = t.closest<HTMLElement>('[data-fy-view]');
      if (viewBtn) return setKind(viewBtn.dataset.fyView === 'strategy' ? 'strategy' : 'all');
      const jump = t.closest<HTMLElement>('[data-fy-jump]');
      if (jump) {
        closeDrawer();
        if (search) search.value = '';
        if (kind !== 'all' || items.some((x) => x.hidden)) setKind('all');
        const to = items.find((x) => x.dataset.id === jump.dataset.fyJump);
        scrollToEl(to);
        // A service's post opens on its first slide.
        if (to && slidesOf(items.indexOf(to))) goSlide(items.indexOf(to), Number(jump.dataset.fySlideTo ?? 0));
        return;
      }
    });

    const setMuted = (m: boolean) => {
      muted = m;
      root.classList.toggle('is-muted', muted);
      sound?.setAttribute('aria-label', muted ? (root.dataset.soundOn ?? 'Sound on') : (root.dataset.soundOff ?? 'Sound off'));
      if (!muted) items[active]?.classList.remove('is-paused');
      sync();
    };
    sound?.addEventListener('click', () => {
      setMuted(!muted);
      setSoundWanted(!muted);
    });
    if (muted) whenSoundAllowed(() => soundWanted() && setMuted(false));
    else sound?.setAttribute('aria-label', root.dataset.soundOff ?? 'Sound off');
    document.addEventListener('stride:sound', (e) => setMuted(!(e as CustomEvent<{ on: boolean }>).detail.on));

    search?.addEventListener('input', filter);

    // The keyboard: ↑/↓ (or K/J) move through the feed, ←/→ through a strategy's slides, M the sound, Escape closes.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') return closeDrawer();
      const typing = (e.target as Element).closest?.('input, textarea, select, [contenteditable]');
      if (typing || !inView) return;
      if (e.key === 'ArrowDown' || e.key === 'j') (e.preventDefault(), go(1));
      else if (e.key === 'ArrowUp' || e.key === 'k') (e.preventDefault(), go(-1));
      else if ((e.key === 'ArrowRight' || e.key === 'ArrowLeft') && slidesOf(active)) {
        e.preventDefault();
        goSlide(active, slideAt(active) + (e.key === 'ArrowRight' ? 1 : -1));
      } else if (e.key === 'm' || e.key === 'M') sound?.click();
    });

    // It starts as the page opens, on the post in the address if there is one (#<code>, a shared link).
    whenLoaded(() => {
      started = true;
      const asked = items.find((it) => it.dataset.code === decodeURIComponent(location.hash.slice(1)));
      if (asked) scrollToEl(asked, false);
      if (active < 0) setActive(items.indexOf(asked ?? items[0]));
      sync();
    });
  });
</script>
