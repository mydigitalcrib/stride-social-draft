---
// Stride Social's services on desktop (the owner's choice, 2026-11-12: "fun and on theme with Stride Social"), as
// stories, the way social shows them, in front of Stride Social's night sky. Along the top a ring for each service;
// in the middle the one on, as a tall story: a bar for each service filling as it plays, the next one following on its
// own; a press on its left side goes back, on its right side on (or the arrow keys, or the services either side, which
// wait half in view); held, it waits. Each says what it is and what it delivers, with "+ Add to brief" (the brief's
// tray, shortlist.ts) and the way to its page. Pictures: each service's own, all of them, as its page shows them, one after another as the story plays (its `hero` then its `gallery`: from Stride's decks or its
// Strategies); one without stands in with a drawn picture, marked as a placeholder, until Stride sends it. Behaviour: service-stories.ts. Phones and tablets have the same stories (the owner, 2026-11-13).
// Also: the stories follow a drag (mouse or pen) or a sideways swipe on a trackpad; the ring of the one playing keeps
// its time as a line of light; a story coming on has its words rise and its stickers pressed on one by one. It waits
// while held, focused from the keyboard, out of view or in a hidden tab. Sized in rem, so it keeps its share of a
// large screen; on a short one it tightens a little.
import { getCollection } from 'astro:content';
import { routes } from '@/lib/routes';
import { pad } from '@/lib/experience';
import { interfaceCopy } from '@/lib/ui-copy';

const t = await interfaceCopy();
const services = (await getCollection('services')).sort((a, b) => a.data.number - b.data.number);
// Its pictures, as its own page shows them: its `hero`, then its `gallery` (the owner, 2026-11-13: a story plays
// through them all, one after another, as it fills).
const pictureOf = (m: { src: string; alt: string; position?: string }) => ({ src: m.src, alt: m.alt, position: m.position ?? '50% 50%' });
const stories = services.map((s) => {
  const pictures = s.data.hero ? [pictureOf(s.data.hero), ...(s.data.gallery ?? []).map(pictureOf)] : [];
  return { id: s.id, name: s.data.name, number: s.data.number, line: s.data.descriptor, deliverables: s.data.deliverables.slice(0, 4), href: routes.service(s.id), picture: pictures[0] ?? null, pictures };
});
const mark = '<svg viewBox="0 0 106 106" aria-hidden="true"><path d="M53 53H0L53 0v53Z"/><path d="M53 106H0l53-53v53Z"/><path d="M106 53H53l53-53v53Z"/><path d="M106 106H53l53-53v53Z"/></svg>';
---

<div class="stories" data-service-stories>
  {/* The rings: one per service. */}
  <ol class="stories__rings" role="list" aria-label={t('stories.rings')}>
    {stories.map((s, i) => (
      <li>
        <button class:list={['stories__ring', { 'is-on': i === 0 }]} type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-story-ring={i}>
          <span class="stories__avatar">
            {s.picture ? <img src={s.picture.src} alt="" sizes="(min-width: 1921px) 3.6vw, 80px" decoding="async" style={`object-position: ${s.picture.position}`} /> : <span class="stories__avatar-none" set:html={mark} />}
          </span>
          <span class="stories__ring-name">{s.name}</span>
        </button>
      </li>
    ))}
  </ol>

  {/* The stories: the one on in the middle, the others either side. */}
  <div class="stories__stage" data-stories-stage>
    {stories.map((s, i) => (
      <article class:list={['story-card', { 'is-on': i === 0 }]} aria-label={s.name} style={`--i: ${i}`} data-story-card={i} aria-hidden={i === 0 ? undefined : 'true'}>
        <div class="story-card__picture">
          {s.picture ? (
            s.pictures.map((p, f) => (
              <img
                class:list={{ 'is-shown': f === 0 }}
                src={p.src}
                alt={f === 0 ? p.alt : ''}
                sizes="(min-width: 1921px) 21vw, 420px"
                loading={i === 0 && f === 0 ? undefined : 'lazy'}
                decoding="async"
                draggable="false"
                style={`object-position: ${p.position}`}
                data-story-frame={f}
              />
            ))
          ) : (
            <span class="story-card__none" data-placeholder="service picture">
              <span class="story-card__none-n" aria-hidden="true">{pad(s.number)}</span>
              <span class="story-card__none-mark" aria-hidden="true" set:html={mark} />
              <span class="story-card__none-label exp-label">{t('stories.picture')}</span>
            </span>
          )}
        </div>
        <div class="story-card__top">
          <div class="story-card__bars" aria-hidden="true">
            {stories.map((_, k) => <i data-story-bar={k}><b></b></i>)}
          </div>
          <p class="story-card__who"><span class="story-card__mark" set:html={mark} /><span>Stride Social</span><span class="story-card__n">{pad(s.number)} / {pad(stories.length)}</span></p>
        </div>
        <div class="story-card__words">
          <h2 class="story-card__name">{s.name}</h2>
          <p class="story-card__line">{s.line}</p>
          {s.deliverables.length > 0 && <ul class="story-card__stickers" role="list">{s.deliverables.map((d, k) => <li style={`--s: ${k}`}>{d}</li>)}</ul>}
          <p class="story-card__ways">
            <button class="exp-pill exp-pill--ghost story-card__keep" type="button" aria-pressed="false" data-keep="brief" data-keep-id={s.id} data-keep-label={s.name} data-keep-group={s.id}>
              <span class="keep-off">{t('door.add')}</span><span class="keep-on">{t('door.added')}</span>
            </button>
            <a class="exp-pill story-card__go" href={s.href}>
              {t('stories.see')}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
            </a>
          </p>
        </div>
      </article>
    ))}
    <button class="stories__step stories__step--prev" type="button" aria-label={t('stories.prev')} data-stories-prev>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5.5M11 6.5 5.5 12l5.5 5.5"></path></svg>
    </button>
    <button class="stories__step stories__step--next" type="button" aria-label={t('stories.next')} data-stories-next>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
    </button>
  </div>
  {/* Which story a visitor's press brought on: its name and its place, as the card says them. */}
  <p class="visually-hidden" aria-live="polite" data-stories-status></p>
</div>

<style>
  .stories {
    display: grid;
    gap: clamp(0.875rem, 2.2svh, 1.75rem);
  }

  /* ---------- The rings ---------- */
  .stories__rings {
    display: flex;
    justify-content: center;
    gap: clamp(0.875rem, 2vw, 2.125rem);
  }

  .stories__ring {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    width: 5.75rem;
    color: rgb(var(--ink));
  }

  /* A ring of light around each, lit until it's been seen; the one on, brighter and larger. */
  /* One cell the ring's own size, so an upright picture stays inside the circle instead of growing its row. */
  .stories__avatar {
    position: relative;
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    padding: 0.25rem;
    border-radius: 50%;
    background: conic-gradient(from 200deg, var(--white), var(--ice), rgb(120 170 220), var(--white));
    transition:
      scale 360ms var(--spring-pop, cubic-bezier(0.2, 1.4, 0.35, 1)),
      box-shadow 300ms var(--ease-out),
      filter 300ms var(--ease-out);
  }

  /* The one playing keeps its time: a line of light round its ring, drawn as its bar fills (--p, service-stories.ts),
     gone when it isn't playing. */
  .stories__avatar::after {
    content: '';
    position: absolute;
    inset: -0.1875rem;
    border-radius: 50%;
    background: conic-gradient(var(--white) calc(var(--p, 0) * 360deg), transparent 0);
    -webkit-mask: radial-gradient(closest-side, transparent calc(100% - 0.4375rem), rgb(0 0 0 / 0.3) calc(100% - 0.1875rem), #000 calc(100% - 0.125rem));
    mask: radial-gradient(closest-side, transparent calc(100% - 0.4375rem), rgb(0 0 0 / 0.3) calc(100% - 0.1875rem), #000 calc(100% - 0.125rem));
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms var(--ease-out);
  }

  .stories__ring.is-on .stories__avatar::after {
    opacity: 1;
  }

  .stories__avatar img,
  .stories__avatar-none {
    width: 100%;
    height: 100%;
    border: 0.1875rem solid var(--navy-900);
    border-radius: 50%;
    object-fit: cover;
    background: linear-gradient(160deg, #294368, var(--navy-900));
  }

  .stories__avatar-none {
    display: grid;
    place-items: center;
  }

  .stories__avatar-none :global(svg) {
    width: 1.625rem;
    fill: rgb(var(--ice-rgb) / 0.8);
  }

  .stories__ring.is-seen:not(.is-on) .stories__avatar {
    filter: saturate(0) brightness(0.7);
  }

  .stories__ring:hover .stories__avatar {
    scale: 1.07;
  }

  .stories__ring.is-on .stories__avatar {
    scale: 1.14;
    box-shadow: 0 0 1.625rem rgb(var(--ice-rgb) / 0.75);
  }

  .stories__ring-name {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
    line-height: 1.3;
    color: rgb(var(--ink) / 0.72);
  }

  .stories__ring.is-on .stories__ring-name {
    color: var(--white);
  }

  .stories__ring:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 4px;
    border-radius: 0.75rem;
  }

  /* ---------- The stories ----------
     670px tall at 1920×1080 (as drawn), and the same share of a larger screen. On a short screen (a laptop, under
     about 900px tall) the card widens, up to 18.75rem, so its stickers and buttons fit under its top bar; the extra
     width shrinks as the stage grows (47.375rem - --h) and is gone by a 485px stage, so 1440×900 and taller keep
     9:16, as drawn. */
  .stories__stage {
    --h: clamp(27.5rem, calc(100svh - 25.625rem), 43.75rem);
    --w: max(calc(var(--h) * 9 / 16), min(18.75rem, calc(47.375rem - var(--h))));
    position: relative;
    height: var(--h);
  }

  .story-card {
    --d: 0; /* its place from the one on: -2 … 2 (service-stories.ts; in between while dragged) */
    --a: 0; /* how far that is */
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--w);
    height: 100%;
    overflow: hidden;
    border-radius: 1.375rem;
    background: #050c1a;
    box-shadow:
      inset 0 0 0 1px rgb(var(--white-rgb) / 0.14),
      0 3.125rem 5.625rem -2.5rem rgb(0 0 0 / 0.95);
    opacity: calc(1 - min(var(--a), 2.4) * 0.32);
    translate: calc(-50% + var(--d) * 74%) 0;
    scale: calc(1 - min(var(--a), 2) * 0.24);
    z-index: calc(10 - var(--a));
    transition:
      translate 620ms cubic-bezier(0.2, 0.9, 0.25, 1),
      scale 620ms cubic-bezier(0.2, 0.9, 0.25, 1),
      opacity 420ms var(--ease-out);
    cursor: pointer;
  }

  /* Those either side dim: a veil of black over the whole card (the same as darkening it to 55%, without
     repainting its picture). */
  .story-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: #000;
    opacity: calc(min(var(--a), 1) * 0.45);
    pointer-events: none;
    transition: opacity 420ms var(--ease-out);
  }

  /* Dragged: the cards follow the hand, and glide on when it lets go. */
  .stories__stage.is-dragging {
    cursor: grabbing;
  }

  .stories__stage.is-dragging .story-card,
  .stories__stage.is-dragging .story-card::before {
    transition: none;
  }

  .story-card.is-far {
    visibility: hidden;
  }

  .story-card.is-on {
    cursor: auto;
    box-shadow:
      inset 0 0 0 1px rgb(var(--white-rgb) / 0.22),
      0 0 5.625rem -1.25rem rgb(var(--ice-rgb) / 0.45),
      0 3.125rem 5.625rem -2.5rem rgb(0 0 0 / 0.95);
  }

  .story-card__picture,
  .story-card__picture img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Its pictures, one shown at a time (service-stories.ts moves on through them as its bar fills): the one shown fades
     in over the last and eases back from a little nearer. */
  .story-card__picture img {
    object-fit: cover;
    opacity: 0;
    scale: 1.06;
    transition:
      opacity 700ms var(--ease-out),
      scale 6s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .story-card__picture img.is-shown {
    opacity: 1;
  }

  .story-card.is-on .story-card__picture img.is-shown {
    scale: 1;
  }

  .story-card__picture::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(var(--navy-900-rgb) / 0.6), transparent 22%),
      linear-gradient(to top, rgb(var(--navy-900-rgb) / 0.95), rgb(var(--navy-900-rgb) / 0.78) 48%, rgb(var(--navy-900-rgb) / 0.4) 76%, transparent 92%);
    pointer-events: none;
  }

  /* Until Stride sends a picture: a drawn one, the night's blue moving slowly, the number large, the mark. */
  .story-card__none {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.875rem;
    overflow: hidden;
    background:
      radial-gradient(60% 40% at 30% 25%, rgb(var(--ice-rgb) / 0.35), transparent 70%),
      radial-gradient(70% 50% at 80% 70%, rgb(80 130 200 / 0.4), transparent 70%),
      linear-gradient(170deg, #1d3a66, var(--navy-900));
    background-size: 160% 160%, 160% 160%, 100% 100%;
  }

  .story-card__none-n {
    position: absolute;
    top: 14%;
    left: -4%;
    font-family: var(--font-display);
    font-size: 16rem;
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 0.09375rem rgb(var(--ice-rgb) / 0.28);
  }

  .story-card__none-mark :global(svg) {
    width: 5.25rem;
    fill: rgb(var(--ice-rgb) / 0.7);
    filter: drop-shadow(0 0 1.5rem rgb(var(--ice-rgb) / 0.6));
  }

  .story-card__none-label {
    margin-bottom: 30%;
    color: rgb(var(--ink) / 0.55);
  }

  .story-card__top {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: 1;
    display: grid;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
  }

  .story-card__bars {
    display: flex;
    gap: 0.25rem;
  }

  .story-card__bars i {
    flex: 1;
    height: 0.1875rem;
    overflow: hidden;
    border-radius: 0.1875rem;
    background: rgb(var(--white-rgb) / 0.3);
  }

  .story-card__bars b {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--white);
    scale: var(--fill, 0) 1;
    transform-origin: 0 50%;
  }

  .story-card__who {
    display: flex;
    align-items: center;
    gap: 0.5625rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .story-card__mark {
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    border-radius: 50%;
    background: var(--navy-900);
    box-shadow: 0 0 0 2px var(--white);
  }

  .story-card__mark :global(svg) {
    width: 0.875rem;
    fill: var(--white);
  }

  .story-card__n {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: rgb(var(--white-rgb) / 0.8);
  }

  .story-card__words {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: 0.5625rem;
    padding: 1.125rem;
  }

  .story-card__name {
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, calc(var(--h) * 0.042), 1.875rem);
    overflow-wrap: anywhere;
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.96;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .story-card__line {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: rgb(var(--white-rgb) / 0.9);
  }

  /* What it delivers: stickers, a little askew, as on a story (each one's tilt is --r). */
  .story-card__stickers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .story-card__stickers li {
    max-width: 100%;
    padding: 0.3125rem 0.625rem;
    border-radius: 0.5rem;
    background: var(--white);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--navy-900);
    box-shadow: 0 0.375rem 0.875rem -0.375rem rgb(0 0 0 / 0.6);
    rotate: var(--r);
  }

  .story-card__stickers li:nth-child(odd) {
    --r: -2deg;
  }

  .story-card__stickers li:nth-child(even) {
    --r: 2deg;
    background: var(--ice);
  }

  .story-card__ways {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .story-card:not(.is-on) .story-card__ways,
  .story-card:not(.is-on) .story-card__stickers {
    visibility: hidden;
  }

  .stories__step {
    position: absolute;
    top: 50%;
    z-index: 20;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-top: -1.5rem;
    border-radius: 50%;
    background: linear-gradient(135deg, rgb(var(--white-rgb) / 0.2), rgb(var(--white-rgb) / 0.06));
    box-shadow: inset 0 0 0 1px rgb(var(--white-rgb) / 0.36);
    color: var(--white);
    backdrop-filter: blur(0.75rem);
    -webkit-backdrop-filter: blur(0.75rem);
  }

  .stories__step--prev {
    left: calc(50% - var(--w) / 2 - 4.625rem);
  }

  .stories__step--next {
    right: calc(50% - var(--w) / 2 - 4.625rem);
  }

  .stories__step svg,
  .story-card__go svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stories__step:focus-visible,
  .story-card :global(a:focus-visible),
  .story-card :global(button:focus-visible) {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 3px;
  }

  /* A narrow desktop (about 1024 wide): the seven rings fit the content's width. */
  @media (min-width: 1024px) and (max-width: 1199px) {
    .stories__ring {
      width: 5rem;
    }

    .stories__rings {
      gap: clamp(0.5rem, 1.2vw, 2.125rem);
    }
  }

  /* A short screen (a laptop): a little tighter, so the story's way to its page stays on the first screen. */
  @media (min-width: 1024px) and (max-height: 820px) {
    .stories {
      gap: 0.75rem;
    }

    .stories__avatar {
      width: 3rem;
      height: 3rem;
    }

    .story-card__words {
      gap: 0.4375rem;
      padding: 0.875rem;
    }
  }

  /* ---------- Phones and tablets: the same stories (the owner, 2026-11-13) ----------
     The rings a row that scrolls sideways under the finger; the story on as wide as the screen allows, at 9:16 (or
     as tall as the screen leaves room for), its neighbours just showing at the edges; a tap on its left third goes
     back, anywhere else on. */
  @media (max-width: 1023px) {
    .stories {
      margin-inline: calc(-1 * var(--margin));
    }

    .stories__rings {
      justify-content: flex-start;
      gap: 0.75rem;
      padding: 0.25rem var(--margin) 0.5rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }

    .stories__rings::-webkit-scrollbar {
      display: none;
    }

    .stories__rings li {
      flex: none;
    }

    .stories__ring {
      width: 4.75rem;
    }

    .stories__stage {
      --w: min(calc(100vw - 2 * var(--margin)), 26rem);
      --h: min(calc(var(--w) * 16 / 9), calc(100svh - 10rem));
      overflow: clip;
    }

    .stories__step {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .story-card__none {
      animation: stories-aurora 14s ease-in-out infinite alternate;
    }

    @keyframes stories-aurora {
      to {
        background-position: 100% 60%, 0% 30%, 0 0;
      }
    }

    /* A story coming on (service-stories.ts, .is-entering): its name and line rise, its stickers are pressed on one
       by one, then its way in. Each ends where it rests. */
    .story-card.is-entering .story-card__name {
      animation: story-rise 420ms var(--ease-out) 120ms both;
    }

    .story-card.is-entering .story-card__line {
      animation: story-rise 420ms var(--ease-out) 180ms both;
    }

    .story-card.is-entering .story-card__stickers li {
      animation: story-slap 420ms var(--ease-out) calc(260ms + var(--s, 0) * 70ms) both;
    }

    .story-card.is-entering .story-card__ways {
      animation: story-rise-near 360ms var(--ease-out) 520ms both;
    }

    @keyframes story-rise {
      from {
        opacity: 0;
        translate: 0 0.875rem;
      }
      to {
        opacity: 1;
        translate: 0 0;
      }
    }

    @keyframes story-rise-near {
      from {
        opacity: 0;
        translate: 0 0.5rem;
      }
      to {
        opacity: 1;
        translate: 0 0;
      }
    }

    @keyframes story-slap {
      from {
        opacity: 0;
        scale: 1.35;
        rotate: calc(var(--r) * 4);
      }
      60% {
        opacity: 1;
        scale: 0.96;
      }
      to {
        opacity: 1;
        scale: 1;
        rotate: var(--r);
