      opacity: 0;
      translate: 0 -0.25rem;
      pointer-events: none;
      transition:
        opacity 240ms var(--ease-out),
        translate 240ms var(--ease-out);
    }

    .globe__region:hover .globe__region-name,
    .globe__region.is-pointed .globe__region-name,
    .globe__region:focus-visible .globe__region-name {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* ---------- Desktop: the words wait for the phone ----------
     While the menu's photos fall onto the planet (meteors.ts, .is-landing), the region, the list, the message
     and the logos stay out of the way; once the phone has arrived they come in, one after another. */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .globe > .globe__stage > .globe__ticker,
    .globe > .globe__stage > .globe__intro,
