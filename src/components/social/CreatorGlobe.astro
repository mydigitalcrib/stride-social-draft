        transform 900ms var(--ease-out);
    }

    .globe > .globe__stage > .globe__intro {
      --w-delay: 140ms;
    }

    .globe > .globe__stage > .globe__messages {
      --w-delay: 280ms;
    }

    .globe.is-landing > .globe__stage > .globe__ticker,
    .globe.is-landing > .globe__stage > .globe__intro,
    .globe.is-landing > .globe__stage > .globe__messages {
      opacity: 0;
      translate: 0 1.75rem;
      pointer-events: none;
      transition-duration: 260ms;
      transition-delay: 0s;
    }
  }

  /* ---------- The close (every screen since 2026-11-13) ----------
     One more stretch of scroll after the last region (--end, 0 to 1, creator-globe.ts): the words and the phone
     go, the planet turns and sinks, its lit edge becoming a horizon, and the closing line rises over it with the
     way in (--close-in). */
  @media all {
    .globe:has(> .globe__stage > .globe__close) {
      height: calc(100svh + (var(--steps) - 1) * 55svh + 90svh);
