      background: none;
      color: rgb(var(--ink));
    }

    .globe__region[aria-selected='true'] .globe__region-num {
      color: inherit;
    }

    .globe__region[aria-selected='true']::after {
      scale: 1 1;
    }

    /* Out of sight but still the button's name, for screen readers. */
    .globe__region-name {
      position: absolute;
      top: calc(100% + 0.125rem);
      left: 0.625rem;
