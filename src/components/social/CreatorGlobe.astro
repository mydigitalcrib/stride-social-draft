---
// Stride Social's opening: the creator globe. A stylised, cut-away globe (the top of a sphere sliced across,
// its cross-section showing below the rim) acts as a region selector; a phone shows the selected
// region's creator content as a reel. Drag or swipe the globe, scroll through the section (the
// stage stays pinned while each region takes a turn), or use the region list. Behaviour:
// src/scripts/system/creator-globe.ts. Regions and creators: src/config/creator-regions.ts.
// A creator appears only if published (src/lib/roster.ts: in production, with confirmed consent) and with a
// recorded country; otherwise a region shows its case study's own footage, labelled "Interim", or a
// labelled empty state. Nothing is invented.
// On desktop with motion the brand ticker runs along the top of the screen, with no header over it; it
// stays through the regions and leaves with the stage.
// `embedded` (inside another page): an h2, not the page's h1.
// `background` (desktop): a video behind the stage, under a navy overlay and noise (.exp-haze).
// Desktop: the region is named once, large; the list is its numbers (the name shows on hover); the three messages
// share out the regions in order; the notification drops into the phone's own screen. `close` (desktop): after
// the last region the planet turns and sinks with the phone, and the closing line rises over its lit horizon
// with the way in (creator-globe.ts, --end), a word at a time, as light comes up behind the planet and settles.
// Desktop, with motion: a region chosen pings from its light on the planet, a signal runs up the beam and the phone
// catches it (.is-receiving); pointing at a light swells it and lights its number in the list (and the other way
// round), and a click on it travels there. The phone and everything in it is in rem on desktop, so it keeps its
// share of the screen however large.
import { getEntry, getEntries } from 'astro:content';
import BrandTicker from '../core/BrandTicker.astro';
import DraftTag from '../core/DraftTag.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';
import { creatorRegions } from '@/config/creator-regions';
import { getRoster, handleOf } from '@/lib/roster';
import { workPreviews } from '@/lib/previews';
import { routes } from '@/lib/routes';

export interface Props {
  copy: { status: 'approved' | 'draft'; items?: { label: string; copy?: string }[] };
  brands?: { name: string; logo: string }[];
  embedded?: boolean;
  background?: { video: string; poster: string; speed?: number };
  close?: { headline: string; label: string; href: string };
}

const { copy, brands = [], embedded = false, background, close } = Astro.props;
const Title = embedded ? 'h2' : 'h1';
const messages = copy.items ?? [];
const roster = await getRoster();
const byId = new Map(roster.map((c) => [c.id, c]));
const countryName = new Intl.DisplayNames(['en'], { type: 'region' });
const platformOf = (p: Record<string, string | undefined>) =>
  p.tiktok ? 'TikTok' : p.instagram ? 'Instagram' : p.youtube ? 'YouTube' : p.twitch ? 'Twitch' : undefined;

// What a region's phone plays: its creators' reels, or else its case study's footage, or nothing yet.
const creatorOf = async (id: string) => {
  const c = byId.get(id);
  if (!c?.data.country) return null;
  return {
    name: c.data.name,
    handle: handleOf(c) ?? `@${c.data.name}`,
    confirmed: c.data.consent.status === 'confirmed',
    href: routes.creator(c.id),
    country: countryName.of(c.data.country) ?? c.data.country,
    platform: platformOf(c.data.platforms),
    // The first of the niches in the sheet's words, which say more than its filter ("Other").
    niche: c.data.niche?.split(',')[0].trim() ?? (c.data.mainCategory ? (await getEntry(c.data.mainCategory))?.data.label : undefined),
  };
};
const regions = await Promise.all(
  creatorRegions.map(async (r) => {
    const reels = (
      await Promise.all(
        (r.reels ?? []).map(async (reel) => {
          const creator = await creatorOf(reel.creator);
          return creator ? { creator: { ...creator, country: reel.place ?? creator.country }, work: null, video: { src: reel.src, poster: reel.poster, label: `${creator.name}: creator video` } } : null;
        }),
      )
    ).filter((x) => !!x);
    const w = r.work && !reels.length ? await getEntry('work', r.work) : undefined;
    const brand = w ? await getEntry(w.data.client) : undefined;
    const services = w ? await getEntries(w.data.services) : [];
    const work = w
      ? {
          id: w.id,
          title: w.data.title,
          href: routes.caseStudy(w.id),
          brand: brand?.data.name ?? w.data.title,
          service: services[0]?.data.name,
          video: workPreviews[w.id],
          poster: (w.data.homeTile?.front ?? w.data.hero ?? w.data.card).src,
        }
      : null;
    const fallback = { creator: null, work, video: work?.video ? { src: work.video, poster: work.poster, label: `${work.brand} campaign footage` } : null };
    return { key: r.key, label: r.label, lat: r.lat, lon: r.lon, work, clips: reels.length ? reels : [fallback] };
  }),
);
const globeData = JSON.stringify(regions.map(({ key, label, lat, lon }) => ({ key, label, lat, lon })));
const pad = (n: number) => String(n).padStart(2, '0');
// The closing line, a word at a time (desktop, with motion); its text stays whole for screen readers.
const closeWords = close?.headline.split(/\s+/).filter(Boolean) ?? [];
---

<section class="globe" aria-labelledby="globe-title" data-tone="social" data-look="deep" data-creator-globe data-regions={globeData} style={`--steps: ${regions.length}`}>
  <div class="globe__stage">
    {background && (
      <div class="exp-haze globe__haze" aria-hidden="true">
        <video muted loop playsinline preload="none" poster={background.poster} tabindex="-1" data-haze-video data-speed={background.speed}>
          <source src={background.video} type="video/mp4" />
        </video>
      </div>
    )}
    <canvas class="globe__canvas" data-globe-canvas aria-hidden="true"></canvas>

    <div class="globe__intro" data-reveal="from-left">
      {/* The selected region, editorial-size. */}
      <div class="globe__readout" aria-hidden="true">
        {regions.map((r, i) => (
          <p class:list={['globe__now', { 'is-active': i === 0 }]} data-globe-now={i}>{r.label}</p>
        ))}
      </div>
      <div class="globe__regions" role="tablist" aria-label="Regions" data-globe-tabs>
        {regions.map((r, i) => (
          <button
            class="globe__region"
            type="button"
            role="tab"
            id={`globe-tab-${r.key}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls="globe-phone"
            tabindex={i === 0 ? 0 : -1}
            data-globe-tab={i}
          >
            <span class="globe__region-num" aria-hidden="true">{pad(i + 1)}</span><span class="globe__region-name">{r.label}</span>
          </button>
        ))}
      </div>
    </div>

    {/* The phone: one screen per region, the selected one in front, each playing its reels in turn. */}
    <div class="phone on-photo" id="globe-phone" role="tabpanel" aria-labelledby={`globe-tab-${regions[0].key}`} data-globe-phone>
      <div class="phone__body">
        <span class="phone__island" aria-hidden="true"></span>
        {regions.map((r, i) => (
          <div class:list={['phone__screen', { 'is-active': i === 0 }]} data-globe-screen={i} aria-hidden={i === 0 ? undefined : 'true'}>
            {r.clips.map((clip, k) => (
              <div class:list={['phone__clip', { 'is-active': k === 0 }]} data-globe-clip aria-hidden={k === 0 ? undefined : 'true'}>
                {clip.video ? (
                  <video class="phone__media" muted loop={r.clips.length === 1} playsinline preload="none" poster={clip.video.poster} aria-label={clip.video.label} data-globe-video>
                    <source src={clip.video.src} type="video/mp4" />
                  </video>
                ) : (
                  <PlaceholderNotice variant="block" label={`Creator for ${r.label}`} class="phone__empty">— awaiting Stride: creator, consent and content</PlaceholderNotice>
                )}

                <div class="phone__ui">
                  <p class="phone__top" aria-hidden="true"><span>Reels</span><span class="phone__cam"></span></p>
                  {clip.video && <ul class="phone__actions" role="list" aria-hidden="true">
                    <li><svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg></li>
                    <li><svg viewBox="0 0 24 24"><path d="M5 18.5V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8.5L5 18.5Z" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg></li>
                    <li><svg viewBox="0 0 24 24"><path d="M4 12 20 4l-6 16-2.5-6.5L4 12Z" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg></li>
                  </ul>}
                  <div class="phone__meta">
                    {clip.creator ? (
                      <a class="phone__handle" href={clip.creator.href}>{clip.creator.handle}</a>
                    ) : clip.work && (
                      <p class="phone__handle phone__handle--pending">Creator to be confirmed</p>
                    )}
                    {clip.work && <a class="phone__caption" href={clip.work.href}>{clip.work.brand}{clip.work.service && ` · ${clip.work.service}`}</a>}
                    <p class="phone__chips">
                      <span class="phone__chip"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 14s5-4.2 5-8A5 5 0 0 0 3 6c0 3.8 5 8 5 8Z M8 7.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" fill="none" stroke="currentColor" stroke-width="1.3"></path></svg>{clip.creator ? clip.creator.country : r.label}</span>
                      {clip.creator?.platform && <span class="phone__chip">{clip.creator.platform}</span>}
                      {clip.creator?.niche && <span class="phone__chip">{clip.creator.niche}</span>}
                    </p>
                  </div>
                </div>
                {clip.creator && !clip.creator.confirmed && <PlaceholderNotice label="Consent pending" class="phone__interim"><span class="phone__interim-text">— preview only until Stride confirms</span></PlaceholderNotice>}
                {!clip.creator && clip.work && <PlaceholderNotice label="Interim" class="phone__interim"><span class="phone__interim-text">— case study footage; creator and location to be confirmed</span></PlaceholderNotice>}
              </div>
            ))}
            {r.clips.length > 1 && (
              <span class="phone__dots" aria-hidden="true">
                {r.clips.map((_, k) => <i class:list={{ 'is-on': k === 0 }} data-globe-dot></i>)}
              </span>
            )}
          </div>
        ))}
        <button class="phone__toggle" type="button" data-globe-toggle aria-label="Pause video">
          <svg class="phone__icon phone__icon--pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2h3v12H4zM9 2h3v12H9z" fill="currentColor"></path></svg>
          <svg class="phone__icon phone__icon--play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2l10 6-10 6z" fill="currentColor"></path></svg>
        </button>
        <button class="phone__sound" type="button" aria-pressed="false" aria-label="Turn the sound on" data-globe-sound>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path class="phone__sound-speaker" d="M4 9.500v5h3.500L12 18.500v-13L7.500 9.500H4Z"></path>
            <path class="phone__sound-off" d="m16 9.500 5 5m0-5-5 5"></path>
            <path class="phone__sound-on" d="M15.500 9a4.200 4.200 0 0 1 0 6M18 6.500a7.800 7.800 0 0 1 0 11"></path>
          </svg>
        </button>
      </div>
    </div>

    {/* The message: a new one with each scroll step (the script). */}
    <div class="globe__messages" data-reveal="from-right">
      {messages.map((m, i) => {
        const Heading = i === 0 ? Title : 'p';
        return (
          <div class:list={['globe__message', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'} data-globe-message={i}>
            <Heading class="globe__title" id={i === 0 ? 'globe-title' : undefined}>{m.label}</Heading>
            {m.copy && <p class="globe__body">{m.copy}</p>}
          </div>
        );
      })}
      <DraftTag status={copy.status} />
    </div>

    <p class="globe__status" aria-live="polite" data-globe-status></p>

    <div class="globe__ticker"><BrandTicker brands={brands} /></div>

    {/* Desktop: the notification comes in at the top of the screen, outside the phone, as the homepage's do
        (the owner, 2026-11-13); the logo stripe fades under it while it's there. */}
    <div class="globe__note exp-note" aria-hidden="true" data-globe-note>
      <span class="exp-note__avatar">
        <svg viewBox="0 0 106 106">
          <path d="M53 53H0L53 0v53Z"></path>
          <path d="M53 106H0l53-53v53Z"></path>
          <path d="M106 53H53l53-53v53Z"></path>
          <path d="M106 106H53l53-53v53Z"></path>
        </svg>
      </span>
      <span class="exp-note__body">
        <span class="exp-note__from">Stride <span>now</span></span>
        <span class="exp-note__text">Scroll here for more reels · drag the globe to travel</span>
      </span>
    </div>

    {close && (
      <div class="globe__close" data-globe-close>
        <h2 class="globe__close-title" style={`--n: ${closeWords.length}`}>
          {closeWords.map((w, i) => <><span class="globe__close-word" style={`--k: ${i}`}>{w}</span>{i < closeWords.length - 1 ? ' ' : ''}</>)}
        </h2>
        <a class="globe__close-cta exp-pill exp-pill--glass" href={close.href} data-magnetic>
          {close.label}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
        </a>
      </div>
    )}
  </div>
</section>

<style>
  /* The section is as tall as one screen per region; the stage stays pinned while each takes a turn. */
  .globe {
    --end: 0;
    --close-in: 0;
    position: relative;
    height: calc(100svh + (var(--steps) - 1) * 55svh);
    color: rgb(var(--ink));
  }

  .globe__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--gutter);
    padding: calc(var(--header-h) + var(--space-5)) var(--margin) 0;
  }

  /* The night sky with its shooting stars (social-sky.mp4, also behind the menu above, so the two are one sky):
     barely blurred or shaded, or the stars and their trails would go. It melts in at both ends. */
  .globe__haze {
    --haze-blur: 0.0375rem;
    --haze-shade: 0.16;
    --haze-mask: linear-gradient(to bottom, transparent, #000 10%, #000 90%, transparent);
  }

  /* The globe fills the lower part of the stage, behind everything. */
  .globe__canvas {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 64%;
    /* The atmosphere fades out at the top of the canvas instead of stopping at its edge. */
    mask-image: linear-gradient(to bottom, transparent, #000 12%);
    touch-action: pan-y;
    cursor: grab;
  }

  .globe.is-dragging .globe__canvas {
    cursor: grabbing;
  }

  /* ---------- Left: the region and the list ---------- */
  .globe__intro {
    position: relative;
    align-self: start;
    display: grid;
    gap: var(--space-4);
    padding-top: clamp(8px, 4vh, 40px);
    container-type: inline-size;
  }

  /* ---------- Right: the message ---------- */
  .globe__messages {
    position: relative;
    align-self: start;
    justify-self: end;
    display: grid;
    max-width: 28rem;
    padding-top: clamp(0px, 2vh, 24px);
    text-align: right;
  }

  .globe__message {
    grid-area: 1 / 1;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    opacity: 0;
    transform: translateY(16px);
    filter: blur(6px);
    pointer-events: none;
    transition:
      opacity 400ms var(--ease-out),
      transform 600ms var(--ease-out),
      filter 500ms var(--ease-out);
  }

  .globe__message.is-active {
    opacity: 1;
    transform: none;
    filter: none;
    pointer-events: auto;
  }

  .globe__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.7vw, 3rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.95;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .globe__body {
    color: rgb(var(--ink) / 0.8);
  }

  .globe__regions {
    display: grid;
    justify-items: start;
    gap: 2px;
    margin-top: var(--space-4);
  }

  .globe__region {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 36px;
    padding: 0 var(--space-4) 0 var(--space-3);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--ink) / 0.74);
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .globe__region-num {
    color: var(--ice);
  }

  .globe__region:hover {
    color: rgb(var(--ink));
  }

  .globe__region[aria-selected='true'] {
    background: rgb(var(--tone-lit));
    color: rgb(var(--tone-on));
  }

  .globe__region[aria-selected='true'] .globe__region-num {
    color: rgb(var(--tone-on));
  }

  .globe__region:focus-visible {
    outline: 2px solid var(--ice);
    outline-offset: 2px;
  }

  /* ---------- Phone ---------- */
  .phone {
    position: relative;
    z-index: 2;
    align-self: start;
    margin-top: clamp(8px, 4vh, 40px);
  }

  .phone__body {
    position: relative;
    height: min(60svh, 600px);
    aspect-ratio: 9 / 19;
    overflow: hidden;
    border-radius: 44px;
    background: #000;
    box-shadow:
      0 0 0 2px var(--navy-500),
      0 0 0 9px var(--navy-900),
      0 0 0 10px var(--navy-500),
      0 40px 80px rgb(var(--shade) / 0.55);
    isolation: isolate;
  }

  .phone__island {
    position: absolute;
    top: 10px;
    left: 50%;
    z-index: 5;
    width: 30%;
    height: 24px;
    border-radius: 999px;
    background: #000;
    translate: -50% 0;
  }

  /* Screens stack; the selected one sits in front. A change slides the new reel up, like a swipe. */
  .phone__screen {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(100%);
    transition:
      transform 620ms var(--ease-out),
      opacity 300ms var(--ease-out),
      filter 620ms var(--ease-out);
  }

  .phone__screen.is-active {
    z-index: 1;
    opacity: 1;
    transform: none;
  }

  .phone__screen.is-before {
    transform: translateY(-30%);
    filter: blur(6px);
  }

  /* A region's reels, one after another: the next slides up, like a swipe. */
  .phone__clip {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(100%);
    transition:
      transform 620ms var(--ease-out),
      opacity 300ms var(--ease-out),
      filter 620ms var(--ease-out);
  }

  .phone__clip.is-active {
    z-index: 1;
    opacity: 1;
    transform: none;
  }

  .phone__clip.is-before {
    transform: translateY(-30%);
    filter: blur(6px);
  }

  .phone__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A region still waiting for its creator: a quiet, centred empty screen with its label. */
  .globe :global(.phone__empty) {
    position: absolute;
    inset: 0;
    align-content: center;
    justify-items: center;
    padding: var(--space-8) var(--space-5);
    border: 0;
    border-radius: 0;
    background:
      radial-gradient(90% 60% at 50% 40%, rgb(var(--ice-rgb) / 0.16), transparent 70%),
      var(--navy-700);
    text-align: center;
    font-size: var(--type-small);
    color: rgb(var(--ink) / 0.75);
  }

  .globe :global(.phone__interim) {
    top: 48px;
    left: var(--space-3);
    right: auto;
    max-width: calc(100% - var(--space-5));
  }

  .phone__ui {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 46px var(--space-4) var(--space-5);
    background: linear-gradient(to top, rgb(0 0 0 / 0.6), transparent 38%);
    pointer-events: none;
  }

  .phone__ui a {
    pointer-events: auto;
  }

  .phone__top {
    display: flex;
    justify-content: space-between;
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .phone__cam {
    width: 20px;
    height: 16px;
    border: 1.6px solid currentColor;
    border-radius: 4px;
  }

  .phone__actions {
    align-self: end;
    justify-self: end;
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .phone__actions svg {
    width: 26px;
    height: 26px;
  }

  .phone__meta {
    display: grid;
    gap: 6px;
    font-size: 0.8125rem;
  }

  .phone__handle {
    font-weight: 700;
  }

  .phone__handle--pending {
    color: rgb(var(--ink) / 0.7);
    font-weight: 500;
  }

  .phone__caption {
    color: rgb(var(--ink) / 0.9);
    text-decoration: underline;
    text-decoration-color: rgb(var(--white-rgb) / 0.4);
    text-underline-offset: 3px;
  }

  .phone__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .phone__chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgb(var(--white-rgb) / calc(0.16 * var(--fill-k)));
    font-size: 0.6875rem;
    backdrop-filter: blur(4px);
  }

  .phone__chip svg {
    width: 12px;
    height: 12px;
  }

  .phone__toggle {
    position: absolute;
    right: var(--space-3);
    top: 44px;
    z-index: 4;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.35);
    color: rgb(var(--ink));
  }

  .phone__toggle:focus-visible {
    outline: 2px solid var(--ice);
  }

  .phone__icon {
    width: 12px;
    height: 12px;
  }

  .phone__icon--play,
  .phone.is-paused .phone__icon--pause {
    display: none;
  }

  .phone.is-paused .phone__icon--play {
    display: block;
  }

  .phone.has-no-video .phone__toggle,
  .phone.has-no-video .phone__sound {
    display: none;
  }

  /* Desktop: play and stop in the middle of the screen, when the pointer is on the phone or it's stopped. */
  @media (min-width: 1024px) {
