    .globe.is-closing > .globe__stage > .globe__ticker,
    .globe.is-closing > .globe__stage > .globe__intro,
    .globe.is-closing > .globe__stage > .globe__messages {
      opacity: calc(1 - var(--end) * 3.4);
      pointer-events: none;
      transition: none;
    }

    .globe.is-closing .phone,
    .globe.is-closing .globe__canvas {
      pointer-events: none;
