    .globe.is-closing .phone {
      opacity: calc(1 - var(--end) * 2.2);
    }

    .globe__close {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: grid;
      align-content: center;
      justify-items: center;
      gap: clamp(1.5rem, 4vh, 2.5rem);
      padding: 0 var(--margin) 20vh;
      text-align: center;
      opacity: var(--close-in);
      pointer-events: none;
    }

    .globe.is-closed .globe__close {
      pointer-events: auto;
    }

    .globe__close-title {
      font-family: var(--font-display);
      font-size: clamp(2.75rem, 5.4vw, 6.25rem);
      font-weight: 850;
      font-stretch: var(--stretch-wide);
      line-height: 0.92;
      letter-spacing: -0.025em;
      text-transform: uppercase;
      text-wrap: balance;
      translate: 0 calc((1 - var(--close-in)) * 4.375rem);
    }

    /* Its rise is a transform, so the magnetic pull (translate, the global motion.ts) adds to it. */
    .globe__close-cta {
      gap: 0.75rem;
      min-height: 3.25rem;
      padding-inline: 1.75rem;
      transform: translateY(calc((1 - var(--close-in)) * 2.5rem));
    }

    .globe__close-cta svg {
      width: 1rem;
      height: 1rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: translate 300ms var(--ease-out);
    }

    .globe__close-cta:hover svg {
      translate: 0.1875rem 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* It sinks (its foot melting away where the stage ends is drawn on the canvas, creator-globe.ts, so only the
       move is left to the page here, and nothing repaints a mask over the whole width every frame). */
    .globe.is-closing .globe__canvas {
      translate: 0 calc(var(--end) * 34%);
    }

    .globe.is-closing .phone {
      translate: 0 calc(var(--end) * 60vh);
      scale: calc(1 - var(--end) * 0.35);
    }

    /* The closing line rises over the horizon a word at a time, all driven by --close-in, and lands whole. */
    .globe__close-word {
      --w: clamp(0, calc((var(--close-in) - var(--k) * 0.07) / max(0.3, 1 - (var(--n) - 1) * 0.07)), 1);
      display: inline-block;
      opacity: var(--w);
      translate: 0 calc((1 - var(--w)) * 0.55em);
    }

    /* The phone catches the signal sent up the beam (creator-globe.ts): a glow at its foot and a small nudge. */
    .phone::after {
      content: '';
      position: absolute;
      bottom: -1.25rem;
      left: -20%;
      z-index: -1;
      width: 140%;
      height: 2.5rem;
      border-radius: 50%;
      background: radial-gradient(closest-side, rgb(var(--ice-rgb) / 0.55), transparent);
      opacity: 0;
      pointer-events: none;
    }

    .phone.is-receiving::after {
