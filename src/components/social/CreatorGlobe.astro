  /* ---------- The list is its numbers (desktop; every screen since 2026-11-13) ----------
     The region is named once, large, above; each number lights with a line under it when its region is on, and
     shows its name below on hover or focus. */
  @media all {
    .globe__regions {
      grid-auto-flow: column;
