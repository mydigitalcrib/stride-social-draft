---
// How the Social service pages end: the enquiry headline in the page's wide type, over the lit horizon
// of the Social menu, and the way to the form (with the service prefilled, when there is one).
// Desktop: once the headline has risen into place, a band of light crosses it line by line, as across a lit sign
// (Social's name, Talent's headline), and the link's rim catches the same light. Once per visit to the page, only if
// it's still on screen, and nothing at rest.
export interface Props {
  headline: string;
  label: string;
  service?: string;
  /** Instead of the Social enquiry form. */
  href?: string;
  tone?: 'social' | 'talent' | 'education' | 'group';
  /** The palette colour it lives in. */
  look?: 'deep' | 'navy' | 'slate' | 'ice' | 'pale' | 'frost' | 'white';
  /** On desktop, another colour: for a page whose desktop version is a different colour from its phone one (Our
      Work). It then runs on from the page with no light of its own, so nothing marks where it starts. */
  deskLook?: 'deep' | 'navy' | 'slate' | 'ice' | 'pale' | 'frost' | 'white';
  /** On desktop, the button in frosted glass rather than a solid colour. */
  glass?: boolean;
}

const { headline, label, service, href, tone = 'group', look = 'navy', deskLook, glass = false } = Astro.props;
---

<section class:list={['eclose', { 'eclose--runs-on': !!deskLook }]} id="next" aria-labelledby="eclose-title" data-tone={tone} data-look={look} data-desk-look={deskLook}>
  <div class="eclose__inner container-wide">
    <h2 class="eclose__title" id="eclose-title" data-reveal-lines>{headline}</h2>
    <a class:list={['eclose__action', { 'eclose__action--glass': glass }]} href={href ?? `/social/enquire${service ? `?service=${service}` : ''}`} data-reveal="rise">
      {label}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
    </a>
  </div>
</section>
{/* Before the page's background reads the sections' colours (system/backdrop.ts). */}
{deskLook && (
  <script is:inline>
    (function () {
      var el = document.getElementById('next');
      if (el && el.dataset.deskLook && window.matchMedia('(min-width: 1024px)').matches) el.dataset.look = el.dataset.deskLook;
    })();
  </script>
)}

<script>
  import { DESKTOP } from '@/scripts/system/env';
  // The last light (desktop, motion allowed): when the headline's last line has risen (reveal-lines.ts), the band of
  // light crosses it, and a little after, the link's rim catches it (glass.css: --gb-glint at --gb-gx, --gb-gy).
  if (window.matchMedia(`${DESKTOP} and (prefers-reduced-motion: no-preference)`).matches) {
    document.querySelectorAll<HTMLElement>('.eclose__title').forEach((title) => {
      const link = title.closest('.eclose')?.querySelector<HTMLElement>('.eclose__action');
      let onScreen = false;
      new IntersectionObserver((e) => (onScreen = e[e.length - 1].isIntersecting)).observe(title);
      const shine = () => {
        const lines = title.querySelectorAll<HTMLElement>('.reveal-line__inner');
        const last = lines[lines.length - 1];
        if (!last) return;
        const risen = (e: TransitionEvent) => {
          if (e.target !== last || e.propertyName !== 'transform') return;
          last.removeEventListener('transitionend', risen);
          if (!onScreen) return;
          title.classList.add('is-sheen');
          last.addEventListener('animationend', () => title.classList.remove('is-sheen'), { once: true });
          window.setTimeout(() => {
            link?.animate(
              [
                { '--gb-gx': '-20%', '--gb-gy': '0%', '--gb-glint': 0 },
                { '--gb-glint': 0.85, offset: 0.5 },
                { '--gb-gx': '120%', '--gb-gy': '0%', '--gb-glint': 0 },
              ],
              { duration: 900, easing: 'ease-in-out' },
            );
          }, 900);
        };
        last.addEventListener('transitionend', risen);
      };
      const watch = new MutationObserver(() => {
        if (!title.classList.contains('is-revealed')) return;
        watch.disconnect();
        shine();
      });
      watch.observe(title, { attributes: true, attributeFilter: ['class'] });
    });
  }
</script>

<style>
  .eclose {
    position: relative;
    overflow: hidden;
    padding-block: clamp(96px, 16vh, 180px);
    background: radial-gradient(70% 42% at 50% 58%, rgb(var(--tone-wash) / 0.2), transparent);
    color: rgb(var(--ink));
  }

  .eclose::after {
    content: '';
    position: absolute;
    inset: auto 12% 0;
    height: 1px;
    background: linear-gradient(to right, transparent, rgb(var(--tone-lit) / 0.8), transparent);
    box-shadow: 0 0 22px 2px rgb(var(--tone-glow) / 0.5);
  }

  /* Desktop: no line, so the page runs on into the footer with nothing between them. */
  @media (min-width: 1024px) {
    .eclose::after {
      display: none;
    }
  }

  .eclose__inner {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
  }

  .eclose__title {
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 6rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .eclose__action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    padding-inline: var(--space-5);
    border-radius: 999px;
    background: rgb(var(--press));
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--press-on));
    transition: background-color 300ms var(--ease-out);
  }

  .eclose__action:hover {
    background: rgb(var(--press));
  }

  @media (min-width: 1024px) {
    .eclose--runs-on {
      background: none;
    }

    /* Frosted glass, as .exp-pill--glass (styles/system/glass.css). */
    .eclose__action--glass,
    .eclose__action--glass:hover {
      background: linear-gradient(135deg, rgb(var(--white-rgb) / calc(0.17 * var(--fill-k))), rgb(var(--white-rgb) / calc(0.05 * var(--fill-k))));
      box-shadow:
        inset 0 0 0 1px rgb(var(--hair) / 0.38),
        inset 0 1px 0 rgb(var(--hair) / 0.5),
        0 0.75rem 1.75rem -0.875rem rgb(3 10 24 / 0.85);
      color: rgb(var(--ink));
      backdrop-filter: blur(0.875rem) saturate(1.4);
      -webkit-backdrop-filter: blur(0.875rem) saturate(1.4);
    }

    .eclose__action--glass:hover {
      background: linear-gradient(135deg, rgb(var(--white-rgb) / calc(0.26 * var(--fill-k))), rgb(var(--white-rgb) / calc(0.1 * var(--fill-k))));
    }
  }

  .eclose__action:focus-visible {
    outline: 2px solid var(--ice);
    outline-offset: 3px;
  }

  .eclose__action svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The light crossing the headline (the script adds .is-sheen for the one pass): three times the line's width, so at
     either end only the words' own colour shows. */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .eclose__title.is-sheen :global(.reveal-line__inner) {
      background: linear-gradient(100deg, rgb(var(--ink)) 0 40%, rgb(var(--tone-hover)) 46%, rgb(var(--tone-lit)) 50%, rgb(var(--tone-hover)) 54%, rgb(var(--ink)) 60% 100%) 100% 0 / 300% 100% no-repeat;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: eclose-sheen 1300ms cubic-bezier(0.45, 0, 0.2, 1) calc(var(--line, 0) * 70ms) both;
    }

    @keyframes eclose-sheen {
      to {
        background-position: 0% 0;
      }
    }
  }

  /* Desktop: in rem, so the close grows with the screen past 1920×1080 (tokens.css); the same until then. */
  @media (min-width: 1024px) {
    .eclose {
      padding-block: clamp(6rem, 16vh, 11.25rem);
    }

    .eclose__action {
      min-height: 3rem;
    }

    .eclose__action svg {
      width: 0.9375rem;
      height: 0.9375rem;
    }
  }
</style>
