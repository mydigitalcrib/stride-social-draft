---
// A Stride Social service's page on desktop (the owner, 2026-11-12: the picture behind was blurry and the cards out of
// line), in front of Contact's background (the page's core/BackVideo; the owner, 2026-11-17: it was Stride Social's
// night sky). On the left its name, lit, what it is and its words, and what it includes as numbered lines (they no
// longer go into a brief: the owner, 2026-11-17, "delete anything related to add to brief"); then the way to talk to
// Stride. On the right a phone playing videos, one after another as reels do (the owner, 2026-11-17: "to humanize
// this section"; its case studies' own clips, then Stride's creators': config/service-phones.ts), muted until its sound
// is turned on, a press on its right going on and on its left back, leaning towards the pointer; without any clips,
// its pictures,
// sharp, in a tall frame that leans towards the pointer, one after another (its `hero`, then its `gallery`, from
// Stride's decks); a service without one stands in with a drawn picture, marked as a placeholder. Phones and tablets
// have the same opening in one column (the owner, 2026-11-13). Behaviour: service-hero.ts.
// Also: the frame's badge and dots float a little above its picture as it leans, and the dots choose a picture (named
// by its own alt text);
// "Read more" opens the words in place, the lines below gliding down. Sized in rem, so it grows with the screen.
import Breadcrumbs from '../global/Breadcrumbs.astro';
import { pad } from '@/lib/experience';
import { interfaceCopy } from '@/lib/ui-copy';

type Pic = { src: string; alt: string; position?: string };
type Clip = { src: string; poster: string; who: string; href: string; note: string; label: string };
export interface Props {
  name: string;
  number: number;
  descriptor: string;
  body: string[];
  items: string[];
  pictures: Pic[];
  /** What its phone plays, in order (config/service-phones.ts); none, and it shows its pictures. */
  clips?: Clip[];
  crumbs: { label: string; href?: string }[];
  talk: { label: string; href: string };
  serviceId: string;
}

const { name, number, descriptor, body, items, pictures, clips = [], crumbs, talk, serviceId } = Astro.props;
const t = await interfaceCopy();
const mark = '<svg viewBox="0 0 106 106" aria-hidden="true"><path d="M53 53H0L53 0v53Z"/><path d="M53 106H0l53-53v53Z"/><path d="M106 53H53l53-53v53Z"/><path d="M106 106H53l53-53v53Z"/></svg>';
---

<section class="shero" aria-labelledby="shero-title" data-tone="social" data-look="deep" data-service-hero data-service={serviceId}>
  <div class="shero__inner">
    <div class="shero__copy">
      <Breadcrumbs items={crumbs} tone="dark" />
      <h1 class="shero__title exp-title" id="shero-title" style={`--len: ${Math.max(6, ...name.split(/\s+/).map((w) => w.length))}`}>{name}</h1>
      <p class="shero__line">{descriptor}</p>
      {body.length > 0 && (
        <div class="shero__body" data-shero-body>
          {body.map((p, i) => <p class:list={{ 'is-more': i > 0 }}>{p}</p>)}
          {body.length > 1 && (
            <button class="shero__more" type="button" aria-expanded="false" data-shero-more data-less={t('service.less')}>
              <span>{t('service.more')}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9.5 12 15.5 18 9.5"></path></svg>
            </button>
          )}
        </div>
      )}

      {items.length > 0 && (
        <div class="shero__includes">
          <p class="exp-label">{t('service.includes')}</p>
          <ol class="shero__items" role="list">
            {items.map((item, i) => (
              <li class="shero__item">
                <span class="shero__no">{pad(i + 1)}</span>
                <span class="shero__name">{item}</span>
              </li>
            ))}
          </ol>
        </div>
      )}

      <p class="shero__ways">
        <a class="exp-pill" href={talk.href} data-magnetic>
          {talk.label}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
        </a>
      </p>
    </div>

    {clips.length > 0 ? (
      <div class="shero__frame shero__frame--phone" data-shero-frame>
        <div class="shero__phone" data-shero-phone>
          <span class="shero__island" aria-hidden="true"></span>
          {clips.map((c, i) => (
            <figure class:list={['shero__clip', { 'is-on': i === 0 }]} data-shero-clip={i} aria-hidden={i === 0 ? undefined : 'true'}>
              <video muted playsinline preload={i === 0 ? 'metadata' : 'none'} poster={c.poster} aria-label={c.label} tabindex="-1" data-shero-video data-sound="own">
                <source src={c.src} type="video/mp4" />
              </video>
              <figcaption class="shero__meta">
                <a class="shero__who" href={c.href} tabindex={i === 0 ? undefined : -1}>{c.who}</a>
                <span class="shero__note">{c.note}</span>
              </figcaption>
            </figure>
          ))}
          <div class="shero__ui" aria-hidden="true">
            <span class="shero__bars">{clips.map((_, i) => <i data-shero-bar={i}><b></b></i>)}</span>
            <span class="shero__top"><span>{t('phone.reels')}</span><span class="shero__cam"></span></span>
            <span class="shero__actions">
              <svg viewBox="0 0 24 24"><path d="M12 20.5s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.7C19.5 15.9 12 20.5 12 20.5Z"></path></svg>
              <svg viewBox="0 0 24 24"><path d="M4.5 18.5V7a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2H8.5l-4 2Z"></path></svg>
              <svg viewBox="0 0 24 24"><path d="M20 4 9.5 14.5M20 4l-6.5 16-3-6.5L4 10.5 20 4Z"></path></svg>
            </span>
          </div>
          <button class="shero__tap shero__tap--prev" type="button" aria-label={t('phone.prev')} data-shero-prev></button>
          <button class="shero__tap shero__tap--next" type="button" aria-label={t('phone.next')} data-shero-next></button>
          <button class="shero__sound" type="button" aria-pressed="false" aria-label={t('phone.soundOn')} data-on={t('phone.soundOff')} data-off={t('phone.soundOn')} data-shero-sound>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path class="shero__speaker" d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5H4Z"></path>
              <path class="shero__sound-off" d="m16 9.5 5 5m0-5-5 5"></path>
              <path class="shero__sound-on" d="M15.5 9a4.2 4.2 0 0 1 0 6M18 6.5a7.8 7.8 0 0 1 0 11"></path>
            </svg>
          </button>
        </div>
      </div>
    ) : (
    <div class="shero__frame" data-shero-frame>
      {pictures.length > 0 ? (
        pictures.map((p, i) => (
          <img class:list={{ 'is-on': i === 0 }} src={p.src} alt={i === 0 ? p.alt : ''} sizes="(min-width: 1024px) 40vw, 100vw" loading={i === 0 ? undefined : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" draggable="false" style={p.position ? `object-position: ${p.position}` : undefined} data-shero-pic={i} />
        ))
      ) : (
        <span class="shero__none" data-placeholder="service picture">
          <span class="shero__none-mark" aria-hidden="true" set:html={mark} />
          <span class="exp-label">{t('stories.picture')}</span>
        </span>
      )}
      <span class="shero__glare" aria-hidden="true"></span>
      <span class="shero__badge" aria-hidden="true"><b>{pad(number)}</b>Stride Social</span>
      {pictures.length > 1 && (
        <span class="shero__dots">
          {pictures.map((p, i) => (
            <button class:list={['shero__dot', { 'is-on': i === 0 }]} type="button" aria-label={p.alt} aria-current={i === 0 ? 'true' : undefined} data-shero-dot={i}><i></i></button>
          ))}
        </span>
      )}
    </div>
    )}
  </div>
</section>

<style>
  /* The frame's lean, read by its glare, badge and dots (service-hero.ts); registered so they can ease back. Names of
     their own: a registered property holds for the whole page, and other parts of it (the header, the decks) use
     --gx and --gy with lengths and fallbacks of their own. */
  @property --shero-gx {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 30%;
  }

  @property --shero-gy {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 20%;
  }

  @property --shero-nx {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  @property --shero-ny {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  .shero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding: calc(var(--header-h) + var(--space-4)) 0 var(--space-6);
    color: rgb(var(--ink));
  }

  .shero__inner {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2rem, 4.5vw, 5.25rem);
    align-items: center;
    margin-inline: var(--margin);
  }

  .shero__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    min-width: 0;
    container-type: inline-size;
  }

  .shero__title {
    font-size: min(clamp(3rem, 7vw, 7rem), calc(100cqi / (var(--len) * 0.82)));
  }

  .shero__line {
    max-width: 36ch;
    font-size: var(--type-lead);
    line-height: 1.35;
    color: rgb(var(--ink) / 0.92);
  }

  .shero__body {
    display: grid;
    justify-items: start;
    gap: 0.625rem;
    max-width: 44rem;
  }

  .shero__body p {
    font-size: 1rem;
    line-height: 1.6;
    color: rgb(var(--ink) / 0.8);
  }

  .shero__body p.is-more {
    display: none;
  }

  .shero__body.is-open p.is-more {
    display: block;
  }

  .shero__more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--tone-lit));
  }

  .shero__more svg {
    width: 0.9375rem;
    height: 0.9375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    transition: rotate 300ms var(--ease-out);
  }

  .shero__body.is-open .shero__more svg {
    rotate: 180deg;
  }

  /* What it includes: numbered lines, each added to the brief with a press. Pointed at or focused, its number and
     name lean in (moved, not laid out again); pressed, they give a little. */
  .shero__includes {
    display: grid;
    gap: 0.625rem;
    width: 100%;
    max-width: 44rem;
  }

  .shero__items {
    display: grid;
    border-top: 1px solid rgb(var(--hair) / 0.2);
  }

  .shero__item {
    position: relative;
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr);
    align-items: center;
    gap: 0.875rem;
    width: 100%;
    padding: 0.8125rem 0.25rem;
    border-bottom: 1px solid rgb(var(--hair) / 0.2);
  }

  .shero__no {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    color: rgb(var(--tone-lit));
  }

  .shero__name {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    font-weight: 800;
    line-height: 1.2;
  }

  .shero__ways {
    margin-top: 0.375rem;
  }

  /* ---------- Its pictures: a tall frame, sharp, leaning towards the pointer; it keeps its place at the top while
     the words open below ("Read more") and scroll ---------- */
  .shero__frame {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    align-self: start;
    aspect-ratio: 4 / 5;
    max-height: calc(100svh - var(--header-h) - 5rem);
    overflow: hidden;
    border-radius: 1.5rem;
    background: #050c1a;
    box-shadow:
      inset 0 0 0 1px rgb(var(--white-rgb) / 0.16),
      0 0 6.25rem -1.5rem rgb(var(--ice-rgb) / 0.4),
      0 3.75rem 6.25rem -3.125rem rgb(0 0 0 / 0.95);
    transform: perspective(75rem) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 380ms var(--ease-out),
      --shero-nx 380ms var(--ease-out),
      --shero-ny 380ms var(--ease-out),
      --shero-gx 600ms var(--ease-out),
      --shero-gy 600ms var(--ease-out);
  }

  /* Under the pointer the glare follows it exactly; it eases back once the pointer has gone. */
  .shero__frame:hover {
    transition:
      transform 380ms var(--ease-out),
      --shero-nx 380ms var(--ease-out),
      --shero-ny 380ms var(--ease-out);
  }

  /* Wider than 1920 (a 32:9 screen), where its height holds it narrower than its column: 4:5 at the height it may
     take, against the column's right edge, in line with what's below. Up to 1920 it fills its column, as drawn. */
  @media (min-width: 1921px) {
    .shero__frame {
      justify-self: end;
      width: min(100%, calc((100svh - var(--header-h) - 5rem) * 0.8));
    }
  }

  .shero__frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    scale: 1.05;
    transition:
      opacity 900ms var(--ease-out),
      scale 6s linear;
  }

  .shero__frame img.is-on {
    opacity: 1;
    scale: 1;
  }

  .shero__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(var(--navy-900-rgb) / 0.55), transparent 32%);
    pointer-events: none;
  }

  .shero__glare {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(50% 40% at var(--shero-gx, 30%) var(--shero-gy, 20%), rgb(var(--white-rgb) / 0.28), transparent 70%);
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  /* The badge and the dots float a little above the picture: as the frame leans they drift with the pointer (--shero-nx,
     --shero-ny: 0 at rest). */
  .shero__badge {
    position: absolute;
    top: 1.125rem;
    left: 1.125rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.875rem 0.5rem 0.5rem;
    border-radius: 999px;
    background: rgb(var(--navy-900-rgb) / 0.62);
    box-shadow: inset 0 0 0 1px rgb(var(--white-rgb) / 0.25);
    font-size: 0.8125rem;
    font-weight: 600;
    backdrop-filter: blur(0.75rem);
    -webkit-backdrop-filter: blur(0.75rem);
    translate: calc(var(--shero-nx, 0) * 0.625rem) calc(var(--shero-ny, 0) * 0.5rem);
  }

  .shero__badge b {
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    border-radius: 50%;
    background: var(--white);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--navy-900);
  }

  /* Each dot a button for its picture: its line where it was drawn, the press around it taller. */
  .shero__dots {
    position: absolute;
    bottom: calc(1.125rem - (1.5rem - 0.1875rem) / 2);
    left: 50%;
    z-index: 2;
    display: flex;
    gap: 0.375rem;
    translate: calc(-50% + var(--shero-nx, 0) * 0.375rem) calc(var(--shero-ny, 0) * 0.375rem);
  }

  .shero__dot {
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.5rem;
    border-radius: 0.25rem;
  }

  .shero__dot i {
    width: 100%;
    height: 0.1875rem;
    border-radius: 0.1875rem;
    background: rgb(var(--white-rgb) / 0.35);
    transition: background-color 300ms var(--ease-out);
  }

  .shero__dot:hover i {
    background: rgb(var(--white-rgb) / 0.7);
  }

  .shero__dot.is-on i {
    background: var(--white);
  }

  .shero__dot:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 2px;
  }

  .shero__none {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1rem;
    background:
      radial-gradient(60% 40% at 30% 25%, rgb(var(--ice-rgb) / 0.32), transparent 70%),
      radial-gradient(70% 50% at 80% 70%, rgb(80 130 200 / 0.36), transparent 70%),
      linear-gradient(170deg, #1d3a66, var(--navy-900));
    color: rgb(var(--ink) / 0.6);
  }

  .shero__none-mark :global(svg) {
    width: 6rem;
    fill: rgb(var(--ice-rgb) / 0.7);
    filter: drop-shadow(0 0 1.5rem rgb(var(--ice-rgb) / 0.6));
  }

  /* ---------- Its phone: videos one after another, as reels play (the owner, 2026-11-17) ----------
     The frame keeps its place at the top and its lean, but holds a phone instead of a picture: black glass in a navy
     rim, a soft light of ice around it; inside, the clip playing, a bar a clip along the top, the meta at its foot. */
  .shero__frame--phone {
    justify-self: center;
    aspect-ratio: auto;
    max-height: none;
    overflow: visible;
    border-radius: 0;
    background: none;
    box-shadow: none;
  }

  .shero__frame--phone::after {
    display: none;
  }

  .shero__phone {
    position: relative;
    height: min(calc(100svh - var(--header-h) - 5rem), 46rem);
    aspect-ratio: 9 / 19;
    overflow: hidden;
    border-radius: 2.75rem;
    background: #000;
    box-shadow:
      0 0 0 2px var(--navy-500),
      0 0 0 0.5625rem var(--navy-900),
      0 0 0 calc(0.5625rem + 1px) rgb(var(--ice-rgb) / 0.35),
      0 0 5rem -1rem rgb(var(--ice-rgb) / 0.35),
      0 2.5rem 5rem -1.5rem rgb(0 0 0 / 0.8);
    isolation: isolate;
    color: var(--white);
  }

  .shero__island {
    position: absolute;
    top: 0.625rem;
    left: 50%;
    z-index: 6;
    width: 30%;
    height: 1.5rem;
    border-radius: 999px;
    background: #000;
    translate: -50% 0;
  }

  /* A clip coming on slides up from below, as a swipe brings the next reel; the one before goes up and softens. */
  .shero__clip {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transform: translateY(100%);
    transition:
      transform 620ms var(--ease-out),
      opacity 300ms var(--ease-out),
      filter 620ms var(--ease-out);
  }

  .shero__clip.is-on {
    z-index: 1;
    opacity: 1;
    transform: none;
  }

  .shero__clip.is-before {
    transform: translateY(-30%);
    filter: blur(6px);
  }

  .shero__clip video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Who it is (their page, or the case study) and what it is, over a shade at the foot. */
  .shero__meta {
    position: absolute;
    inset: auto 0 0;
    z-index: 4;
    display: grid;
    justify-items: start;
    gap: 0.375rem;
    padding: 4rem 3.75rem 1.5rem 1rem;
    background: linear-gradient(to top, rgb(0 0 0 / 0.65), transparent);
    font-size: 0.875rem;
  }

  .shero__who {
    font-weight: 700;
    color: var(--white);
    text-decoration: none;
  }

  .shero__who:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .shero__who:focus-visible {
    outline: 2px solid var(--ice);
    outline-offset: 2px;
  }

  .shero__note {
    padding: 0.1875rem 0.5rem;
    border-radius: 999px;
    background: rgb(var(--white-rgb) / 0.18);
    font-size: 0.6875rem;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .shero__ui {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  /* A bar a clip: those played full, the one playing filling (--p, service-hero.ts). */
  .shero__bars {
    position: absolute;
    top: 2.625rem;
    left: 0.875rem;
    right: 0.875rem;
    display: flex;
    gap: 0.25rem;
  }

  .shero__bars i {
    flex: 1;
    height: 0.1875rem;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(var(--white-rgb) / 0.32);
  }

  .shero__bars b {
    display: block;
    height: 100%;
    background: var(--white);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }

  .shero__top {
    position: absolute;
    top: 3.5rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9375rem;
    font-weight: 700;
    text-shadow: 0 1px 0.5rem rgb(0 0 0 / 0.4);
  }

  .shero__cam {
    width: 1.25rem;
    height: 1rem;
    border: 1.6px solid currentColor;
    border-radius: 0.25rem;
  }

  .shero__actions {
    position: absolute;
    right: 0.875rem;
    bottom: 6.5rem;
    display: grid;
    gap: 1.125rem;
  }

  .shero__actions svg {
    width: 1.625rem;
    height: 1.625rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
    filter: drop-shadow(0 1px 0.375rem rgb(0 0 0 / 0.5));
  }

  /* A press on its left goes back, anywhere else on: invisible, over the clip, under its links and its sound. */
  .shero__tap {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    cursor: pointer;
  }

  .shero__tap--prev {
    left: 0;
    width: 32%;
  }

  .shero__tap--next {
    right: 0;
    width: 68%;
  }

  .shero__tap:focus-visible {
    outline: 2px solid var(--ice);
    outline-offset: -0.5rem;
    border-radius: 2rem;
  }

  .shero__sound {
    position: absolute;
    top: 5.25rem;
    right: 0.75rem;
    z-index: 5;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
