---
// Contact: a conversation in a glass window. Stride asks who you are; tap your answer and it shows up as
// your message, Stride types for a moment, then replies with what that team does and the way to reach
// them. Change your answer whenever you like. Direct details sit beside it. Without the script the answers
// are plain links. Behaviour: src/scripts/system/contact-chat.ts.
// Motion (contact-chat.ts, every screen): the first message is typed live as the window comes into view, then the answers
// come up; Stride's mark turns while it types; what you send travels into the conversation from where you pressed or
// typed it; once the conversation has scrolled, its top edge fades instead of cutting off.
import Breadcrumbs from '../global/Breadcrumbs.astro';
import { interfaceCopy } from '@/lib/ui-copy';

export interface Props {
  copy: { eyebrow?: string; headline?: string; body?: string };
  routes: { key?: string; audience?: string; label: string; copy?: string; href?: string }[];
  details: { label: string; links: { label: string; href: string; external?: boolean }[] }[];
  crumbs: { label: string; href?: string }[];
}

const { copy, routes, details, crumbs } = Astro.props;
const t = await interfaceCopy();
const flow = JSON.stringify({ name: t('chat.name'), email: t('chat.email'), emailBad: t('chat.emailBad'), topic: t('chat.topic'), message: t('chat.message'), ready: t('chat.ready'), send: t('chat.send') });
---

<section class="chat" aria-labelledby="chat-title" data-chat data-flow={flow} data-tone="group" data-look="deep">
  <div class="chat__inner container-wide">
    <div class="chat__lead" data-reveal="from-left">
      <Breadcrumbs items={crumbs} tone="dark" />
      <h1 class="chat__title exp-title" id="chat-title">{copy.headline}</h1>
      <dl class="chat__details">
        {details.map((d) => (
          <div>
            <dt class="exp-label">{d.label}</dt>
            <dd>
              {d.links.map((l, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>
                    {l.label}{l.external && <span class="visually-hidden"> (opens in a new tab)</span>}
                  </a>
                </>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="chat__window glass" data-chat-window>
      <header class="chat__top">
        <span class="chat__avatar on-photo" aria-hidden="true">
          <svg viewBox="0 0 106 106">
            <path d="M53 53H0L53 0v53Z" fill="currentColor"></path>
            <path d="M53 106H0l53-53v53Z" fill="currentColor"></path>
            <path d="M106 53H53l53-53v53Z" fill="currentColor"></path>
            <path d="M106 106H53l53-53v53Z" fill="currentColor"></path>
          </svg>
        </span>
        <p class="chat__who">Stride</p>
      </header>

      <div class="chat__log" role="log" aria-live="polite" data-chat-log data-lenis-prevent>
        <p class="bubble bubble--them">{copy.body}</p>
      </div>

      <div class="chat__answers" data-chat-answers>
        {routes.map((r) => (
          <a class="chat__answer" href={r.href} data-route={r.key} data-audience={r.audience} data-reply={r.copy} data-label={r.label}>{r.audience}</a>
        ))}
      </div>

      <form class="chat__composer" hidden data-chat-composer>
        <input type="text" placeholder={t('chat.placeholder')} aria-label={t('chat.placeholder')} maxlength="254" autocomplete="off" />
        <textarea placeholder={t('chat.placeholder')} aria-label={t('chat.placeholder')} rows="2" maxlength="2000" hidden data-lenis-prevent></textarea>
        <button class="exp-round" type="submit" aria-label={t('chat.submit')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5.5M6.5 11 12 5.5 17.5 11"></path></svg>
        </button>
      </form>
    </div>
  </div>
  {/* Desktop with motion: the first message and the answers wait, from the first frame, for the conversation to
      start live (contact-chat.ts). If its script never runs, they show after a few seconds anyway. */}
  <script is:inline>
    (function () {
      var root = document.currentScript && document.currentScript.closest('[data-chat]');
      if (!root || !matchMedia('(min-width: 1024px)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      root.classList.add('is-held', 'is-arriving');
      root.dataset.arriving = String(setTimeout(function () { root.classList.remove('is-held', 'is-arriving'); }, 4000));
    })();
  </script>
</section>

<style>
  .chat {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + var(--space-3)) var(--space-6);
    overflow: clip;
    color: rgb(var(--ink));
  }

  .chat__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: var(--space-6) var(--gutter);
    align-items: center;
    width: 100%;
  }

  .chat__lead {
    display: grid;
    gap: var(--space-5);
    container-type: inline-size;
  }

  .chat__title {
    font-size: clamp(3rem, 19cqi, 8rem);
  }

  .chat__details {
    display: grid;
    gap: var(--space-3);
  }

  .chat__details dd {
    margin-top: 3px;
  }

  .chat__details a {
    text-decoration: underline;
    text-decoration-color: rgb(var(--tone-lit) / 0.6);
    text-underline-offset: 3px;
  }

  /* ---------- The window ---------- */
  .chat__window {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: min(76svh, 42rem);
    overflow: hidden;
  }

  .chat__top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid rgb(var(--hair) / 0.14);
  }

  .chat__avatar {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: var(--navy-900);
    box-shadow: inset 0 0 0 1px rgb(var(--hair) / 0.3);
  }

  .chat__avatar svg {
    width: 17px;
    height: 17px;
  }

  .chat__who {
    font-weight: 700;
  }

  .chat__log {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: var(--space-5);
    overflow-y: auto;
    scrollbar-width: none;
  }

  .bubble,
  .chat__log :global(.bubble) {
    align-self: flex-start;
    max-width: 82%;
    padding: 11px 15px;
    border-radius: 20px 20px 20px 6px;
    background: rgb(var(--white-rgb) / calc(0.13 * var(--fill-k)));
    box-shadow: inset 0 0 0 1px rgb(var(--hair) / 0.12);
    line-height: 1.34;
    animation: chat-in 420ms cubic-bezier(0.2, 1.4, 0.35, 1);
  }

  .chat__log :global(.bubble--me) {
    align-self: flex-end;
    border-radius: 20px 20px 6px 20px;
    background: rgb(var(--tone-lit));
    box-shadow: none;
    color: rgb(var(--tone-on));
    font-weight: 600;
  }

  @keyframes chat-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.94);
    }
  }

  .chat__log :global(.bubble--typing) {
    display: flex;
    gap: 5px;
    padding-block: 15px;
  }

  .chat__log :global(.bubble--typing span) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgb(var(--white-rgb) / calc(0.7 * var(--fill-k)));
    animation: chat-dot 1s ease-in-out infinite;
  }

  .chat__log :global(.bubble--typing span:nth-child(2)) {
    animation-delay: 140ms;
  }

  .chat__log :global(.bubble--typing span:nth-child(3)) {
    animation-delay: 280ms;
  }

  @keyframes chat-dot {
    50% {
      opacity: 0.35;
      transform: translateY(-4px);
    }
  }

  .chat__log :global(.chat__go) {
    align-self: flex-start;
    margin-top: 4px;
    animation: chat-in 420ms cubic-bezier(0.2, 1.4, 0.35, 1);
  }

  .chat__answers {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid rgb(var(--hair) / 0.14);
  }

  .chat__answer {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding-inline: var(--space-4);
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(var(--tone-lit) / 0.7);
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(var(--ink));
    transition:
      background-color 300ms var(--ease-out),
      color 300ms var(--ease-out),
      translate 300ms var(--ease-out);
  }

  .chat__answer:hover {
    translate: 0 -2px;
    background: rgb(var(--tone-lit));
    color: rgb(var(--tone-on));
  }

  .chat__answer:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 2px;
  }

  /* Desktop: the window is frosted glass you can see the footage moving through, its edge catching the light, a
     sheen across it; the bubbles and answers are glass too (the owner, 2026-11-12: "more glassdoor effect").
     Its lengths are in rem, so past 1920×1080 the corners, the avatar, the bubbles and the answers grow with the
     screen as the window does (tokens.css); up to it they're the pixels they were. Hairlines stay in px. */
  @media all {
    .chat__details dd {
      margin-top: 0.1875rem;
    }

    .chat__details a {
      text-underline-offset: 0.1875rem;
    }

    .chat__window {
      position: relative;
      isolation: isolate;
      border-radius: 2rem;
      background: linear-gradient(160deg, rgb(var(--white-rgb) / 0.17), rgb(var(--white-rgb) / 0.06) 36%, rgb(var(--white-rgb) / 0.025) 62%, rgb(var(--white-rgb) / 0.09));
      box-shadow:
        inset 0 0 0 1px rgb(var(--white-rgb) / 0.24),
        inset 0 1.5px 0.5px rgb(var(--white-rgb) / 0.55),
        inset 0 -1px 0.5px rgb(var(--white-rgb) / 0.14),
        inset 0 -3.75rem 5rem -4.375rem rgb(var(--white-rgb) / 0.3),
        0 0 0 1px rgb(2 8 22 / 0.32),
        0 2.75rem 5.625rem -2.75rem rgb(0 0 0 / 0.75);
      backdrop-filter: blur(1.875rem) saturate(185%) brightness(1.04);
      -webkit-backdrop-filter: blur(1.875rem) saturate(185%) brightness(1.04);
    }

    /* The light along its top edge, and a sheen crossing it. */
    .chat__window::before,
    .chat__window::after {
      content: '';
      position: absolute;
      z-index: -1;
      border-radius: inherit;
      pointer-events: none;
    }

    .chat__window::before {
      inset: 0 0 auto;
      height: 32%;
      background: linear-gradient(to bottom, rgb(var(--white-rgb) / 0.09), transparent);
    }

    .chat__window::after {
      inset: 0;
      background: linear-gradient(115deg, transparent 26%, rgb(var(--white-rgb) / 0.08) 40%, rgb(var(--white-rgb) / 0.02) 48%, transparent 58%);
    }

    .chat__top,
    .chat__answers,
    .chat__composer,
    .chat__window :global(.chat__choices) {
      border-color: rgb(var(--white-rgb) / 0.16);
    }

    .chat__avatar {
      width: 2.375rem;
      height: 2.375rem;
      border-radius: 0.75rem;
      background: linear-gradient(180deg, rgb(var(--white-rgb) / 0.22), rgb(var(--white-rgb) / 0.06));
      box-shadow:
        inset 0 0 0 1px rgb(var(--white-rgb) / 0.3),
        inset 0 1px 0.5px rgb(var(--white-rgb) / 0.6);
    }

    .chat__avatar svg {
      width: 1.0625rem;
      height: 1.0625rem;
    }

    .chat__log {
      gap: 0.5rem;
    }

    /* The bubbles are glass in the window's own glass: the window already blurs the footage behind it, so they don't
       blur again (one backdrop filter for the whole conversation, however long it gets). */
    .chat__log :global(.bubble) {
      padding: 0.6875rem 0.9375rem;
      border-radius: 1.25rem 1.25rem 1.25rem 0.375rem;
      background: linear-gradient(180deg, rgb(var(--white-rgb) / 0.16), rgb(var(--white-rgb) / 0.07));
      box-shadow:
        inset 0 0 0 1px rgb(var(--white-rgb) / 0.2),
        inset 0 1px 0.5px rgb(var(--white-rgb) / 0.42);
      animation-name: chat-in-desk;
    }

    /* Each grows from its tail: Stride's from the left, yours from the right. (The reply's button keeps its centre:
       it's a glass button, and the site-wide press pushes it in from there.) */
    .chat__log :global(.bubble--them) {
      transform-origin: 0 100%;
    }

    .chat__log :global(.bubble--me) {
      border-radius: 1.25rem 1.25rem 0.375rem 1.25rem;
      background: linear-gradient(180deg, rgb(var(--white-rgb) / 0.9), rgb(var(--tone-lit) / 0.82));
      box-shadow:
        inset 0 0 0 1px rgb(var(--white-rgb) / 0.5),
        inset 0 1px 0.5px rgb(var(--white-rgb) / 0.9);
      color: var(--navy-900);
      transform-origin: 100% 100%;
    }

    .chat__log :global(.bubble--typing) {
      gap: 0.3125rem;
      padding-block: 0.9375rem;
    }

    .chat__log :global(.bubble--typing span) {
      width: 0.4375rem;
      height: 0.4375rem;
      animation-name: chat-dot-desk;
    }

    .chat__log :global(.chat__go) {
      margin-top: 0.25rem;
      animation-name: chat-in-desk;
    }

    @keyframes chat-in-desk {
      from {
        opacity: 0;
        transform: translateY(0.625rem) scale(0.94);
      }
    }

    @keyframes chat-dot-desk {
      50% {
        opacity: 0.35;
        transform: translateY(-0.25rem);
      }
    }

    /* Once the conversation has scrolled, its top edge fades rather than cutting off against the header's line.
       Until then there's no mask at all. */
    .chat__log.is-scrollable {
      -webkit-mask-image: linear-gradient(transparent, #000 var(--chat-fade));
      mask-image: linear-gradient(transparent, #000 var(--chat-fade));
      transition: --chat-fade 240ms var(--ease-out);
    }

    .chat__log.is-scrolled {
      --chat-fade: 1.75rem;
    }

    .chat__answers {
      gap: 0.375rem;
    }

    .chat__answer {
      min-height: 2.5rem;
    }

    .chat__answer:hover {
      translate: 0 -0.125rem;
    }

    /* What you sent, on its way into the conversation (contact-chat.ts): a copy of your bubble, the pill's glass on
       top fading into the bubble's own. */
    .chat__window :global(.chat__ghost) {
      position: absolute;
      z-index: 2;
      transform-origin: 0 0;
      pointer-events: none;
    }

    .chat__window :global(.chat__ghost > span) {
      position: absolute;
      inset: 0;
      padding: 0.6875rem 0.9375rem;
      border-radius: inherit;
      font-weight: 600;
      line-height: 1.34;
    }

    .chat__window :global(.chat__ghost-glass) {
      background: var(--gb-fill-on);
      box-shadow:
        inset 0 0 0 1px rgb(var(--white-rgb) / 0.44),
        inset 0 1px 0.5px rgb(var(--white-rgb) / 0.85);
      color: var(--white);
    }

    .chat__window :global(.chat__ghost-ink) {
      background: linear-gradient(180deg, rgb(var(--white-rgb) / 0.9), rgb(var(--tone-lit) / 0.82));
      box-shadow:
        inset 0 0 0 1px rgb(var(--white-rgb) / 0.5),
        inset 0 1px 0.5px rgb(var(--white-rgb) / 0.9);
      color: var(--navy-900);
    }
  }

  /* The fade's edge, registered so it can ease in. */
  @property --chat-fade {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Waiting for the conversation to start live (the inline script below the section adds these; the script takes
       them off): the first message, and then the answers. */
    /* The first message is held out of the flow too (still in the log for screen readers), so Stride's typing
       shows where it will land rather than below an empty space. */
    .chat.is-held .chat__log > .bubble:first-child {
      position: absolute;
      opacity: 0;
      pointer-events: none;
      animation: none;
    }

    .chat.is-arriving .chat__answer {
      opacity: 0;
    }

    /* While Stride types, its mark turns: the four triangles dim one after another, round the square. */
    .chat.is-typing .chat__avatar path {
      animation: chat-mark 900ms ease-in-out infinite;
    }

    .chat.is-typing .chat__avatar path:nth-child(3) {
      animation-delay: 110ms;
    }

    .chat.is-typing .chat__avatar path:nth-child(4) {
      animation-delay: 220ms;
    }

    .chat.is-typing .chat__avatar path:nth-child(2) {
      animation-delay: 330ms;
    }

    @keyframes chat-mark {
      50% {
        opacity: 0.35;
      }
    }
  }

  /* Phones and tablets: the same glass window (the owner, 2026-11-13), under the words, as tall as the screen allows. */
  @media (max-width: 1023px) {
    .chat__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .chat__window {
      height: min(72svh, 40rem);
      border-radius: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat__log :global(.bubble),
    .chat__log :global(.chat__go),
    .chat__log :global(.bubble--typing span) {
      animation: none;
    }
  }

  .chat__answers[hidden] {
    display: none;
  }

  /* While the chat is asking: tap an answer, or type one. */
  .chat__window :global(.chat__choices) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid rgb(var(--hair) / 0.14);
  }

  .chat__window :global(.chat__choices .chat__answer) {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding-inline: var(--space-4);
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(var(--tone-lit) / 0.7);
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(var(--ink));
    transition:
      background-color 300ms var(--ease-out),
      color 300ms var(--ease-out);
  }

  .chat__window :global(.chat__choices .chat__answer:hover) {
    background: rgb(var(--tone-lit));
    color: rgb(var(--tone-on));
  }

  .chat__composer {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid rgb(var(--hair) / 0.14);
  }

  .chat__composer[hidden] {
    display: none;
  }

  .chat__composer input,
  .chat__composer textarea {
    flex: 1;
    min-width: 0;
    padding: 10px 16px;
    border: 0;
    border-radius: 20px;
    background: rgb(var(--panel) / 0.5);
    box-shadow: inset 0 0 0 1px rgb(var(--hair) / 0.24);
    font: inherit;
    color: rgb(var(--ink));
    resize: none;
  }

  .chat__composer input::placeholder,
  .chat__composer textarea::placeholder {
    color: rgb(var(--ink) / 0.74);
  }

  .chat__composer input:focus-visible,
  .chat__composer textarea:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 1px;
  }

  /* Desktop: the same rem sizes, and the glass, for the parts styled just above (here, after them, so they apply). */
  @media all {
    .chat__composer,
    .chat__window :global(.chat__choices) {
      border-color: rgb(var(--white-rgb) / 0.16);
    }

    .chat__window :global(.chat__choices) {
      gap: 0.375rem;
    }

    .chat__window :global(.chat__choices .chat__answer) {
      min-height: 2.5rem;
    }

    .chat__composer input,
    .chat__composer textarea {
      padding: 0.625rem 1rem;
      border-radius: 1.25rem;
      background: linear-gradient(180deg, rgb(var(--white-rgb) / 0.1), rgb(var(--white-rgb) / 0.04));
      box-shadow:
        inset 0 0 0 1px rgb(var(--white-rgb) / 0.22),
        inset 0 1px 0.5px rgb(var(--white-rgb) / 0.3);
    }
  }
</style>

<script>
  import { initContactChats } from '@/scripts/system/contact-chat';
  initContactChats();
</script>
