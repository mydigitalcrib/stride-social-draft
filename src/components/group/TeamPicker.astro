---
// "Don't see your role?": pick the team you'd fit, and its people slide in while the email to the careers
// inbox is addressed for you, with that team in the subject. Only real teams, real faces and real counts,
// from the team collection.
// It carries straight on from the roles, in the same navy, with no panel (the owner, 2026-11-12: it mustn't look like a
// second section; on desktop in front of the same clip): the teams are big words, in outline until pointed at or
// picked, and the one picked brings its people up in a fan of photographs. Phones and tablets the same (2026-11-13): a
// tap picks a team; the fan sizes to the screen.
// Desktop motion: picked, a word's ink fills its outline along the line (and drains out of the one it replaces); the
// fan sizes to its column (116px faces at 1920, growing past it); changing team gathers the old fan into a pile and
// deals the new one out from the middle; with the pointer over it, the fan opens a little and the cards nearest it
// lift. A word is picked once the pointer rests on it (so sweeping across them doesn't flick through every team), at
// once by a click, and by the arrow keys, Home and End, which move along the words (one tab stop for the group).
import { pad } from '@/lib/experience';

export interface Props {
  eyebrow?: string;
  headline?: string;
  body?: string;
  email: string;
  teams: { id: string; label: string; count: number; faces: { src: string; alt: string }[] }[];
  pick: string;
  send: string;
}

const { eyebrow, headline, body, email, teams, pick, send } = Astro.props;
const subject = (team?: string) => `mailto:${email}?subject=${encodeURIComponent(team ? `Application: ${team} team` : 'Application')}`;
---

<section class="picker" aria-labelledby="picker-title" data-picker data-tone="group" data-look="navy">
  <div class="picker__inner container-wide">
    <div class="picker__lead">
      {eyebrow && <p class="exp-label">{eyebrow}</p>}
      <h2 class="picker__title exp-title" id="picker-title">{headline}</h2>
      {body && <p class="picker__body">{body}</p>}
    </div>

    <div class="picker__board glass">
      <p class="exp-label">{pick}</p>
      <div class="picker__teams" role="group" aria-label={pick} data-picker-teams>
        {teams.map((t, i) => (
          <button class="picker__team" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-picker-team={t.id} data-href={subject(t.label)}>
            <span class="picker__team-n" aria-hidden="true">{pad(t.count)}</span>
            <span class="picker__word">{t.label}</span>
          </button>
        ))}
      </div>

      <div class="picker__stage" data-picker-stage>
        {teams.map((t, i) => (
          <ul class:list={['picker__faces', { 'is-active': i === 0 }]} role="list" aria-hidden={i === 0 ? undefined : 'true'} data-picker-faces={t.id} style={`--m: ${(t.faces.length - 1) / 2}`}>
            {t.faces.map((f, k) => (
              <li style={`--k: ${k}`}><img src={f.src} alt={f.alt} sizes="(min-width: 1921px) 6.1vw, 120px" loading="lazy" decoding="async" /></li>
            ))}
          </ul>
        ))}
      </div>

      <a class="exp-pill" href={subject(teams[0]?.label)} data-picker-send>
        {send}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .picker {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: var(--space-8);
    overflow: clip;
    background: radial-gradient(70% 28% at 50% 72%, rgb(var(--tone-wash) / 0.2), transparent);
    color: rgb(var(--ink));
  }

  .picker__inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-6) var(--gutter);
    align-items: center;
    width: 100%;
  }

  .picker__lead {
    display: grid;
    gap: var(--space-4);
    container-type: inline-size;
  }

  .picker__title {
    font-size: clamp(2.25rem, 13cqi, 5rem);
  }

  .picker__body {
    max-width: 30rem;
    font-size: var(--type-lead);
    line-height: 1.36;
    color: rgb(var(--ink) / 0.88);
  }

  .picker__board {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: clamp(20px, 2.4vw, 36px);
  }

  .picker__teams {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .picker__team {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: var(--space-4);
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(var(--hair) / 0.26);
    font-weight: 600;
    color: rgb(var(--ink));
    transition:
      background-color 300ms var(--ease-out),
      color 300ms var(--ease-out);
  }

  .picker__team:hover {
    background: rgb(var(--white-rgb) / calc(0.08 * var(--fill-k)));
  }

  .picker__team[aria-pressed='true'] {
    background: rgb(var(--tone-lit));
    color: rgb(var(--tone-on));
  }

  .picker__team:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 2px;
  }

  .picker__team-n {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    opacity: 0.7;
  }

  .picker__stage {
    display: grid;
    width: 100%;
    min-height: clamp(120px, 11vw, 170px);
  }

  .picker__faces {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    padding-left: 18px;
    visibility: hidden;
  }

  .picker__faces li {
    flex: 0 1 clamp(84px, 8.4vw, 124px);
    min-width: 0;
    aspect-ratio: 4 / 5;
    margin-left: -18px;
    overflow: hidden;
    border-radius: 16px;
    background: var(--navy-700);
    box-shadow:
      0 0 0 2px rgb(var(--tone-surface)),
      0 14px 26px -14px rgb(var(--shade) / 0.8);
    opacity: 0;
    transform: translateY(26px) rotate(calc((var(--k) - 4) * 1.4deg)) scale(0.86);
  }

  .picker__faces img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .picker__faces.is-active {
    visibility: visible;
  }

  .picker__faces.is-active li {
    opacity: 1;
    transform: rotate(calc((var(--k) - 4) * 1.4deg));
    transition:
      opacity 340ms var(--ease-out) calc(var(--k) * 38ms),
      transform 620ms cubic-bezier(0.2, 1.4, 0.35, 1) calc(var(--k) * 38ms);
  }

  .picker__faces.is-active li:hover {
    z-index: 2;
    transform: translateY(-8px) scale(1.12);
  }

  @media (max-width: 1023px) {
    .picker__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- No panel; big words and a fan of faces (every screen; phones' own sizes below) ----------
     Lengths in rem, so past 1920×1080 the words' spacing, the fan and its faces grow with the screen (tokens.css);
     up to it they're the pixels they were. */
  @media all {
    .picker {
      background: none;
      padding-block: var(--space-6) var(--space-8);
    }

    .picker__board.glass {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
      padding: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .picker__board > .exp-label,
    .picker__board > [data-picker-send] {
      grid-column: 1 / -1;
    }

    .picker__teams {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0.125rem;
    }

    .picker__team {
      align-items: baseline;
      gap: 0.625rem;
      min-height: 0;
      padding: 0.125rem 0;
      border-radius: 0;
      box-shadow: none;
      font-family: var(--font-display);
      font-size: clamp(1.75rem, 3vw, 3.25rem);
      font-weight: 850;
      font-stretch: var(--stretch-wide);
      line-height: 1.02;
      letter-spacing: -0.02em;
      text-align: left;
      text-transform: uppercase;
      color: transparent;
      transition: translate 380ms var(--ease-out);
    }

    .picker__team:hover {
      background: none;
    }

    .picker__team[aria-pressed='true'] {
      background: none;
      text-shadow: 0 0 1.875rem rgb(var(--ice-rgb) / 0.45);
      translate: 0.625rem 0;
    }

    /* The word's ink is a fill that can drain out of its letters and leave the outline (a rem stroke, so it keeps its
       weight on a 4K or 8K screen). Picked, the ink fills back in along the line, and once it's there the solid colour
       takes over from the fill (sized to nothing), so the picked word is just its colour, its glow under the letters
       as it always was, untinted. The soft edge sits between the two halves of the 210% gradient, so it only shows
       while it moves; at rest it's exactly the solid or the outline. */
    .picker__word {
      background: linear-gradient(90deg, rgb(var(--ink)) 48%, transparent 52%) 100% 0 / 210% 100% no-repeat;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-stroke: 0.0625rem rgb(var(--ink) / 0.5);
      transition:
        background-position 480ms var(--ease-in-out),
        -webkit-text-stroke-color 200ms var(--ease-out);
    }

    .picker__team:is(:hover, :focus-visible) .picker__word {
      -webkit-text-stroke-color: rgb(var(--ink));
    }

    .picker__team[aria-pressed='true'] .picker__word {
      background-position: 0 0;
      background-size: 0 0;
      color: rgb(var(--ink));
      -webkit-text-stroke-color: rgb(var(--ink));
      transition:
        background-position 480ms var(--ease-in-out),
        -webkit-text-stroke-color 200ms var(--ease-out),
        background-size 0s linear 480ms,
        color 0s linear 480ms;
    }

    .picker__team-n {
      order: 1;
      font-size: var(--type-label);
      font-weight: 400;
      letter-spacing: 0.1em;
      color: rgb(var(--tone-lit));
      -webkit-text-stroke: 0;
      opacity: 1;
    }

    /* The fan sizes to its column (container units). On a narrow laptop the stage also takes a little of the empty
       margin on its right, up to half of it at 1024, none from 1440. */
    .picker__stage {
      container-type: inline-size;
      width: calc(100% + clamp(0px, (1440px - 100vw) * 0.25, var(--margin) * 0.5));
      min-height: clamp(10.625rem, 16vw, 14.375rem);
    }

    /* The faces in a fan under the words, rising one after another: 116px as they were wherever the fan still fits its
       column (from about 1780 wide), smaller on a laptop so it does, larger past 1920. Each overlaps the one before by
       a little over a third, and the last swings out about 0.77 of a face to the right of its place, so nine of them
       take 7.01 faces (14.26% of the column, at most). The first swings as far to the left, and below about 1680 wide
       the lead's text reaches the edge of its column, so there the fan starts further in, by as much as it needs (all
       of that swing by 1440), and the faces ease down to 12.95% of the column by 1600 to make room for it. */
    .picker__faces {
      --face: min(7.25rem, clamp(12.95cqi, 12.95cqi + (100vw - 1600px) * 0.115, 14.26cqi));
      justify-content: flex-start;
      padding-left: calc(var(--face) * 0.345 + clamp(0px, (1680px - 100vw) * 0.3, var(--face) * 0.77));
      pointer-events: none;
    }

    .picker__faces.is-active {
      pointer-events: auto;
    }

    /* Put away, a fan's cards are gathered in a pile on its middle card, square and a little smaller. The same
       functions in every state, so each change moves straight from one to the other. */
    .picker__faces li {
      flex: 0 0 var(--face);
      margin-left: calc(var(--face) * -0.345);
      border-radius: 0.875rem;
      box-shadow:
        0 0 0 0.1875rem var(--white),
        0 1.375rem 2.25rem -1rem rgb(0 0 0 / 0.85);
      transform: translateX(calc((var(--m, 4) - var(--k)) * var(--face) * 0.655)) rotate(0deg) translateY(0) scale(0.92);
      transform-origin: 50% 160%;
    }

    /* --spread and --lift: the fan opening towards the pointer (below). */
    .picker__faces.is-active li {
      transform: translateX(0) rotate(calc((var(--k) - var(--m, 4)) * var(--spread, 6deg))) translateY(calc(var(--lift, 0) * -0.75rem)) scale(1);
    }

    .picker__faces.is-active li:hover {
      transform: translateX(0) rotate(calc((var(--k) - var(--m, 4)) * var(--spread, 6deg))) translateY(-1rem) scale(1.1);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The fan put away stays in sight while it gathers (last card first), then hides. */
    .picker__faces {
      transition: visibility 0s linear 320ms;
    }

    .picker__faces.is-active {
      transition-delay: 0s;
    }

    .picker__faces li {
      transition:
        transform 200ms cubic-bezier(0.4, 0, 1, 1) calc((var(--m, 4) * 2 - var(--k)) * 15ms),
        opacity 200ms cubic-bezier(0.4, 0, 1, 1) calc((var(--m, 4) * 2 - var(--k)) * 15ms);
    }

    /* Dealt out of the pile from the middle, like a hand of cards (.is-dealing is only on for the deal, so a hover
       afterwards answers at once). */
    .picker__faces.is-active li {
      transition:
        transform 420ms var(--ease-out),
        opacity 340ms var(--ease-out);
    }

    .picker__faces.is-active.is-near li {
      transition:
        transform 280ms var(--ease-out),
        opacity 340ms var(--ease-out);
    }

    .picker__faces.is-active.is-dealing li {
      transition:
        transform 620ms var(--spring-pop, cubic-bezier(0.2, 1.4, 0.35, 1)) calc(80ms + max(var(--k) - var(--m, 4), var(--m, 4) - var(--k)) * 38ms),
        opacity 340ms var(--ease-out) calc(80ms + max(var(--k) - var(--m, 4), var(--m, 4) - var(--k)) * 38ms);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .picker__faces.is-active li {
      transition: none;
    }
  }

  /* The words' slide and their ink change at once too. [aria-pressed] so it also wins over the picked word's own
     transitions. */
  @media (prefers-reduced-motion: reduce) {
    .picker__team,
    .picker__team[aria-pressed] .picker__word {
      transition: none;
    }
  }

  /* Phones and tablets: the words as large as a phone allows, the fan across the whole column (nine faces take about
     7.8 faces with the first one's swing, so a face is 12.8% of it), a little shorter stage. */
  @media (max-width: 1023px) {
    .picker {
      padding-block: var(--space-5) var(--space-7);
    }

    .picker__team {
      font-size: clamp(1.625rem, 8vw, 2.75rem);
    }

    .picker__stage {
      width: 100%;
      min-height: clamp(8.5rem, 34vw, 12rem);
    }

    .picker__faces {
      --face: min(6rem, 12.8cqi);
      padding-left: calc(var(--face) * 1.115);
    }
  }
</style>

<script>
  import { reduced } from '@/scripts/system/env';

  document.querySelectorAll<HTMLElement>('[data-picker]').forEach((root) => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const teams = [...root.querySelectorAll<HTMLButtonElement>('[data-picker-team]')];
    const faces = [...root.querySelectorAll<HTMLElement>('[data-picker-faces]')];
    const send = root.querySelector<HTMLAnchorElement>('[data-picker-send]');
    const stage = root.querySelector<HTMLElement>('[data-picker-stage]');
    const hover = window.matchMedia('(hover: hover)').matches;
    const steer = hover && window.matchMedia('(pointer: fine)').matches && !reduced();
    let current = Math.max(0, teams.findIndex((t) => t.getAttribute('aria-pressed') === 'true'));
    let dealt = 0;
    let near = false;

    // Desktop: the fan opens a little towards the pointer (--spread on the fan), and the cards nearest it lift (--lift
    // on each, by how many cards away the pointer is). Where each card's middle is gets read once on the way in.
    let centres: number[] = [];
    let step = 1;
    let queued = false;
    let px = 0;
    const measure = (fan: HTMLElement) => {
      const cards = [...fan.children] as HTMLElement[];
      const left = fan.getBoundingClientRect().left;
      const m = (cards.length - 1) / 2;
      const w = cards[0]?.offsetWidth ?? 0;
      step = Math.max(1, w * 0.655);
      // Each card turns about a point 1.1 card-heights below its middle (transform-origin 50% 160%, 4:5 cards).
      centres = cards.map((c, k) => left + c.offsetLeft - fan.offsetLeft + w / 2 + 1.375 * w * Math.sin(((k - m) * 6.75 * Math.PI) / 180));
    };
    const lean = () => {
      queued = false;
      const fan = faces[current];
      if (!near || !fan) return;
      ([...fan.children] as HTMLElement[]).forEach((c, k) => {
        const d = (px - (centres[k] ?? px)) / step;
        c.style.setProperty('--lift', Math.exp(-(d * d) / 1.2).toFixed(3));
      });
    };
    const settle = (fan: HTMLElement | undefined) => {
      if (!fan) return;
      fan.classList.remove('is-near');
      fan.style.removeProperty('--spread');
      ([...fan.children] as HTMLElement[]).forEach((c) => c.style.removeProperty('--lift'));
    };
    const approach = (fan: HTMLElement | undefined) => {
      if (!fan) return;
      measure(fan);
      fan.classList.add('is-near');
      fan.style.setProperty('--spread', '7.5deg');
      if (!queued) {
        queued = true;
        requestAnimationFrame(lean);
      }
    };
    if (steer && stage) {
      stage.addEventListener('pointerenter', (e) => {
        near = true;
        px = e.clientX;
        approach(faces[current]);
      });
      stage.addEventListener(
        'pointermove',
        (e) => {
          px = e.clientX;
          if (!near || queued) return;
          queued = true;
          requestAnimationFrame(lean);
        },
        { passive: true },
      );
      stage.addEventListener('pointerleave', () => {
        near = false;
        settle(faces[current]);
      });
    }

    const choose = (i: number) => {
      if (i === current || !teams[i]) return;
      const was = faces[current];
      current = i;
      teams.forEach((t, k) => {
        t.setAttribute('aria-pressed', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      settle(was);
      faces.forEach((f, k) => {
        f.classList.toggle('is-active', k === i);
        if (k === i) f.removeAttribute('aria-hidden');
        else f.setAttribute('aria-hidden', 'true');
      });
      // Dealt from the middle out: the deal's stagger is only on for as long as it takes.
      const fan = faces[i];
      if (fan) {
        window.clearTimeout(dealt);
        faces.forEach((f) => f.classList.toggle('is-dealing', f === fan));
        const m = (fan.children.length - 1) / 2;
        dealt = window.setTimeout(() => fan.classList.remove('is-dealing'), 80 + m * 38 + 620 + 60);
        if (near) approach(fan);
      }
      if (send && teams[i].dataset.href) send.href = teams[i].dataset.href;
    };

    // Pointed at (with a mouse), a team is picked too, once the pointer has rested on it for a moment.
    let intent = 0;
    teams.forEach((t, i) => {
      t.addEventListener('click', () => {
        window.clearTimeout(intent);
        choose(i);
      });
      if (!hover) return;
      t.addEventListener('pointerenter', () => {
        window.clearTimeout(intent);
        intent = window.setTimeout(() => choose(i), 90);
      });
      t.addEventListener('pointerleave', () => window.clearTimeout(intent));
    });

    // The keyboard: one tab stop for the words; the arrow keys, Home and End move along them and pick.
    {
      teams.forEach((t, k) => (t.tabIndex = k === current ? 0 : -1));
      root.querySelector<HTMLElement>('[data-picker-teams]')?.addEventListener('keydown', (e) => {
        const at = teams.indexOf(e.target as HTMLButtonElement);
        if (at < 0) return;
        const moves: Record<string, number> = { ArrowDown: at + 1, ArrowRight: at + 1, ArrowUp: at - 1, ArrowLeft: at - 1, Home: 0, End: teams.length - 1 };
        const to = moves[e.key];
        if (to === undefined) return;
        e.preventDefault();
        const next = Math.max(0, Math.min(teams.length - 1, to));
        teams[next].focus();
        choose(next);
      });
    }
  });
</script>
