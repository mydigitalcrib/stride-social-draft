---
// The brand partners' logos in white on a continuous ticker across the full width (sized and paced like
// the live site's). Used under the homepage's three cards (home/ContentsIndex) and along the top of the
// Social page's first screen (social/CreatorGlobe). On desktop, pointed at, it slows to a stop rather than halting dead,
// and picks up speed again as the pointer leaves.
export interface Props {
  brands: { name: string; logo: string }[];
}

const { brands } = Astro.props;
---

{brands.length > 0 && (
  <div class="brand-ticker" style={`--logo-count: ${brands.length}`} data-brand-ticker>
    {[0, 1].map((copyIndex) => (
      <ul
        class="brand-ticker__track"
        role="list"
        aria-label={copyIndex === 0 ? 'Brand partners' : undefined}
        aria-hidden={copyIndex === 1 ? 'true' : undefined}
      >
        {brands.map((b) => (
          <li class="brand-ticker__logo">
            {/* 9rem: 144px up to 1920 wide, 7.5vw past it, as the root size grows (tokens.css). */}
            <img src={b.logo} alt={copyIndex === 0 ? b.name : ''} width="1080" height="1080" loading="lazy" decoding="async" sizes="(min-width: 1921px) 7.5vw, 144px" />
          </li>
        ))}
      </ul>
    ))}
  </div>
)}

<style>
  /* Two copies of the row side by side, moving left by one row's width and starting over, so it never
     ends. It pauses while hovered and fades out at both edges. Each file is a square with the mark
     drawn inside at its own size (as on the live site), so the squares sit edge to edge with a fixed
     gap, and the row tucks into the room above and below the marks. */
  .brand-ticker {
    display: flex;
    justify-self: stretch;
    overflow: hidden;
    margin-block: -24px;
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }

  .brand-ticker__track {
    display: flex;
    flex: none;
    animation: brand-ticker calc(var(--logo-count) * 1.35s) linear infinite; /* a little slower (the owner, 2026-11-17: it was 1s a logo) */
  }

  /* Desktop: the fades span the page margin, so the logos are gone before they pass under the
     radial navigation on the left (and the right matches). In rem, as the rest of the page past 1920×1080. */
  @media (min-width: 1024px) {
    .brand-ticker {
      margin-block: -1.5rem;
      mask-image: linear-gradient(
        to right,
        transparent 4.5rem,
        #000 var(--margin),
        #000 calc(100% - var(--margin)),
        transparent calc(100% - 4.5rem)
      );
    }
  }

  /* Phones and tablets: it pauses while hovered (desktop eases to a stop instead, below; without the script, it pauses
     there too). */
  @media (max-width: 1023px) {
    .brand-ticker:hover .brand-ticker__track {
      animation-play-state: paused;
    }
  }

  @media (min-width: 1024px) {
    :global(html:not(.js)) .brand-ticker:hover .brand-ticker__track {
      animation-play-state: paused;
    }
  }

  @keyframes brand-ticker {
    to {
      transform: translateX(-100%);
    }
  }

  .brand-ticker__logo {
    flex: none;
    margin-right: 2.5rem;
  }

  .brand-ticker__logo img {
    display: block;
    width: 9rem;
    height: 9rem;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  @media (max-width: 767px) {
    .brand-ticker {
      margin-block: -18px;
    }

    .brand-ticker__logo {
      margin-right: 1.75rem;
    }

    .brand-ticker__logo img {
      width: 7rem;
      height: 7rem;
    }
  }

  /* No ticker: the logos stand still, wrapped and centred. */
  @media (prefers-reduced-motion: reduce) {
    .brand-ticker {
      mask-image: none;
    }

    .brand-ticker__track {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0 2.5rem;
      width: 100%;
      padding-inline: var(--margin);
      animation: none;
    }

    .brand-ticker__track[aria-hidden] {
      display: none;
    }

    .brand-ticker__logo {
      margin-right: 0;
    }
  }

  :global(html[data-ink='light']) .brand-ticker__logo img {
    filter: brightness(0) invert(0.08);
  }
</style>

<script>
  import { DESKTOP } from '@/scripts/system/env';
  // Desktop: the pointer slows the ticker to a stop over 600ms (easing out) and leaving speeds it back up over 800ms
  // (easing in), both copies together, by the speed of their own animation. Reduced motion has a still row already.
  if (window.matchMedia(`${DESKTOP} and (prefers-reduced-motion: no-preference)`).matches) {
    document.querySelectorAll<HTMLElement>('[data-brand-ticker]').forEach((ticker) => {
      let raf = 0;
      let rate = 1;
      const ease = (to: number, ms: number, curve: (t: number) => number) => {
        cancelAnimationFrame(raf);
        const from = rate;
        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - start) / ms);
          rate = from + (to - from) * curve(t);
          ticker.querySelectorAll('.brand-ticker__track').forEach((track) => track.getAnimations().forEach((a) => (a.playbackRate = rate)));
          raf = t < 1 ? requestAnimationFrame(step) : 0;
        };
        raf = requestAnimationFrame(step);
      };
      ticker.addEventListener('pointerenter', () => ease(0, 600, (t) => 1 - (1 - t) ** 3));
      ticker.addEventListener('pointerleave', () => ease(1, 800, (t) => t * t * t));
    });
  }
</script>
