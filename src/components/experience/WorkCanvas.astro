---
// Our Work on desktop: an endless canvas of case studies, curved like the inside of a bowl: the tiles in the middle
// face you, those towards the edges come closer and turn in. They cover the screen and go on in every direction;
// drag it, or move it with the wheel or trackpad, and it glides to where it's been sent (it never jumps), drifting
// slowly when left alone. A tile is a large campaign photograph, a little dimmed, with the client and its services
// written on it; each is one sheet that bends with the bowl and, like paper, stretches and curls with the speed it's
// moved at. Around the pointer the canvas swells, the tiles there larger and their neighbours eased aside; the tile
// under it comes to life while the rest dim further, its picture following the pointer a little inside the frame
// (its footage plays, if it has some). A click opens the whole case study over the canvas, without
// leaving the page (work-preview.ts): the tile grows into its picture on the left (its footage playing, its clips a
// press away) and the case rises in on the right, to read down: the campaign, the brief, the strategy and the
// execution, verified results, a verified quote, its creators; the previous and next projects a step away. A list
// view is there for reading. A notification from Stride says how it works, once, with the chime. Turn the camera on and the canvas
// follows your hand, a fist over a project opens it and a fist again closes it (hand-motion.ts: a hand-tracking
// model that runs on the visitor's device, fetched when the camera is turned on; nothing recorded or sent).
// The canvas is drawn with WebGL (work-canvas.ts) from the pictures below, each fetched at the size a tile needs; the
// keyboard gets a link per case study, which brings its tile to the middle (the arrow keys walk from tile to tile).
// Without WebGL it opens as the list. Only visible case studies, as before. Phones and tablets have the same
// canvas, moved with a finger, its tiles in proportion to the screen (the owner, 2026-11-13).
// On a screen larger than 1920×1080 all of it grows with the root size, the canvas too, so it keeps its composition;
// below 1280 wide the words at the foot take a line of their own above the controls. The motion that answers a
// visitor: a press dimples the paper, an opened tile lifts out of its place (its neighbours easing into the gap) and
// lands back in it, a drag let go is thrown, the tiles are laid down from the middle as the page opens, and the
// canvas sinks back into the dark as the page goes on or the list takes its place; the list's pictures wipe in from
// the way the pointer went, a swapped project's picture travels in from the edge it waited at, and verified results
// count up. Without motion, none of it moves.
import { interfaceCopy } from '@/lib/ui-copy';
import { pad } from '@/lib/experience';
import PlaceholderNotice from '@/components/core/PlaceholderNotice.astro';

/** The whole case study, by the case study page's rules (pages/work/index.astro filters it). */
type Story = {
  summary?: string | null;
  facts: string[];
  sections: { label: string; parts: string[] }[];
  /** The previous site's copy, where the story isn't rewritten yet: preview only. */
  legacy: string[];
  results: { label: string; value: string; source: string }[];
  resultsSummary?: string | null;
  /** Figures awaiting verification: preview only. */
  unverified: string[];
  quote?: string | null;
  creators: { name: string; href: string }[];
  clips: { src: string; caption: string }[];
};

export interface Props {
  items: { key: string; name: string; meta?: string; image?: { src: string; alt: string } | null; href: string; video?: string; story?: Story }[];
  headline?: string;
  body?: string;
  /** Where the page goes on from (the closing section), for the button at the foot. */
  next?: { label: string; href: string };
  /** The headline's element: the page's h1, unless another version of the page has it (the phones' wall on Our
      Work): then a paragraph that is still announced as the level-one heading, so the page has one h1 in all. */
  heading?: 'h1' | 'p';
}

const { items, headline, body, next, heading = 'h1' } = Astro.props;
const Heading = heading;
const t = await interfaceCopy();
// What the canvas draws: the words on each tile, where it leads, its footage. (Its picture is the <img> below.)
const data = items.map((item) => ({ key: item.key, name: item.name, meta: item.meta ?? '', href: item.href, video: item.video ?? '' }));
const json = JSON.stringify(data).replace(/</g, '\\u003c');
// Each case study's panel: where it is in the list, and its story (the slashes joined here, not written in the markup,
// where the compiler's scanner can take them for a regular expression).
const empty: Story = { facts: [], sections: [], legacy: [], results: [], unverified: [], creators: [], clips: [] };
const legacyNote = ['— from the previous site, awaiting the brief', 'strategy', 'execution rewrite (Q6)'].join(' / ');
// (The name's longest word sets how large it can be, so a long one like ALIEXPRESS fits whole: --len, the styles.)
const longest = (name: string) => Math.max(6, ...name.split(' ').map((w) => w.length));
const panels = items.map((item, i) => ({ item, story: item.story ?? empty, count: [pad(i + 1), pad(items.length)].join(' / '), len: longest(item.name) }));
// Each panel's chapters, in the order its parts come (the bar at the top of the column, work-preview.ts).
const chaptersOf = (s: Story) => [
  ...s.sections.map((x) => x.label.replace(/^The (.)/, (_, c: string) => c.toUpperCase())),
  ...(s.legacy.length ? ['Story'] : []),
  ...(s.results.length ? [t('work.results')] : []),
  ...(s.quote ? [t('work.words')] : []),
  ...(s.creators.length ? [t('work.creators')] : []),
];
const mark = `<svg viewBox="0 0 106 106" aria-hidden="true"><path d="M53 53H0L53 0v53Z"/><path d="M53 106H0l53-53v53Z"/><path d="M106 53H53l53-53v53Z"/><path d="M106 106H53l53-53v53Z"/></svg>`;
---

<section class="wcanvas" aria-label={headline} data-tone="social" data-look="deep" data-work-canvas>
  <div class="wcanvas__field" data-lenis-prevent data-canvas-field>
    <canvas class="wcanvas__gl" aria-hidden="true" data-canvas-gl></canvas>
  </div>

  {/* The pictures the canvas paints from (the script fetches each at the size it needs, from the srcset the build adds). */}
  <template data-canvas-sources>
    {items.map((item) => item.image && <img src={item.image.src} alt="" data-canvas-src={item.key} />)}
  </template>
  <script type="application/json" data-canvas-items set:html={json} />

  {/* For the keyboard and screen readers: each case study, as a link. */}
  <ul class="wcanvas__links visually-hidden" role="list" data-canvas-links>
    {items.map((item) => (
      <li>
        <a href={item.href} data-canvas-link={item.key}>{`${item.name}${item.meta ? `: ${item.meta}` : ''}`}</a>
      </li>
    ))}
  </ul>

  {/* The case study a tile opens into (work-preview.ts): one per case study, hidden (its pictures and footage not
      loaded), copied in when it's opened. */}
  {panels.map(({ item, story, count, len }) => {
    const chapters = chaptersOf(story);
    let part = 0;
    const no = () => pad(++part);
    return (
    <div class="wpreview__source" hidden data-preview-for={item.key}>
      {/* The client's name, huge and in outline, behind it all: it runs past, over and over (--n: its length, for
          a steady pace). */}
      <span class="wpreview__ghost" aria-hidden="true" style={`--n: ${item.name.length}`}><span>{[0, 1, 2, 3].map(() => <i>{item.name}</i>)}</span></span>
      <div class="wpreview__side">
        {/* A glow in the picture's own colours, behind it (its picture, set by the script). */}
        <span class="wpreview__aura" aria-hidden="true" data-preview-aura></span>
        <div class="wpreview__media" data-preview-media>
          {item.image && <img class="wpreview__picture" src={item.image.src} alt={item.image.alt} sizes="60vw" loading="lazy" decoding="async" />}
          {story.clips.map((clip, n) => <video class="wpreview__film" muted playsinline preload="none" aria-hidden="true" data-src={clip.src} data-clip={n} data-caption={clip.caption}></video>)}
          <span class="wpreview__sheen" aria-hidden="true"></span>
          {/* Its clips, as stories: a bar each along the top, filling as it plays; a press on the picture goes on to the next. */}
          {story.clips.length > 0 && (
            <div class="wpreview__bars" role="group" aria-label={t('work.clips')}>
              {story.clips.map((_, n) => <button type="button" aria-label={`${t('work.clip')} ${n + 1}`} aria-pressed={n === 0 ? 'true' : 'false'} data-clip-pick={n}><i></i></button>)}
            </div>
          )}
        </div>
        {story.clips.some((clip) => clip.caption) && <p class="wpreview__caption" data-clip-caption>{story.clips[0].caption}</p>}
      </div>
      <div class="wpreview__body" data-preview-body>
        <p class="wpreview__eyebrow">{t('work.case')}<span>{count}</span></p>
        <h2 class="wpreview__name" style={`--len: ${len}`}>{item.name}</h2>
        {story.summary && <p class="wpreview__lead">{story.summary}</p>}
        {item.meta && <p class="wpreview__services">{item.meta.split(' · ').map((m) => <span>{m}</span>)}</p>}
        {story.facts.length > 0 && <p class="wpreview__chips">{story.facts.map((x) => <span>{x}</span>)}</p>}
        {chapters.length > 1 && (
          /* Its chapters: they stay at the top of the column as it's read; the one being read is lit. */
          <nav class="wpreview__chapters" aria-label={t('work.chapters')} data-preview-chapters>
            {chapters.map((c, n) => <button type="button" aria-current={n === 0 ? 'true' : undefined} data-chapter={n}><span>{pad(n + 1)}</span>{c}</button>)}
            <i class="wpreview__chapter-line" aria-hidden="true" data-chapter-line></i>
          </nav>
        )}
        {story.sections.map((x) => (
          <section class="wpreview__part" data-part>
            <h3 class="wpreview__label"><span class="wpreview__no">{no()}</span>{x.label}</h3>
            {x.parts.map((text) => <p class="wpreview__text">{text}</p>)}
          </section>
        ))}
        {story.legacy.length > 0 && (
          <section class="wpreview__part" data-part>
            <span class="wpreview__no" aria-hidden="true">{no()}</span>
            <PlaceholderNotice label="Original copy">{legacyNote}</PlaceholderNotice>
            {story.legacy.map((text) => <p class="wpreview__text">{text}</p>)}
          </section>
        )}
        {story.results.length > 0 && (
          <section class="wpreview__part" data-part>
            <h3 class="wpreview__label"><span class="wpreview__no">{no()}</span>{t('work.results')}</h3>
            {story.resultsSummary && <p class="wpreview__text">{story.resultsSummary}</p>}
            <dl class="wpreview__stats">
              {story.results.map((r) => <div><dd data-count={r.value}>{r.value}</dd><dt>{r.label}</dt><span class="wpreview__from">{r.source}</span></div>)}
            </dl>
          </section>
        )}
        {story.unverified.length > 0 && <PlaceholderNotice label="Results awaiting verification">{story.unverified.join(' · ')}</PlaceholderNotice>}
        {story.quote && (
          <figure class="wpreview__part wpreview__quote" data-part>
            <h3 class="wpreview__label"><span class="wpreview__no">{no()}</span>{t('work.words')}</h3>
            <blockquote>{story.quote}</blockquote>
            <figcaption>{item.name}</figcaption>
          </figure>
        )}
        {story.creators.length > 0 && (
          <section class="wpreview__part" data-part>
            <h3 class="wpreview__label"><span class="wpreview__no">{no()}</span>{t('work.creators')}</h3>
            <p class="wpreview__people">{story.creators.map((c) => <a href={c.href}>{c.name}</a>)}</p>
          </section>
        )}
      </div>
    </div>
    );
  })}
  <div class="wpreview" role="dialog" aria-modal="true" hidden data-preview data-lenis-prevent>
    <div class="wpreview__shade" data-preview-close></div>
    <div class="wpreview__stage" data-preview-stage></div>
    <button class="wpreview__close" type="button" aria-label={t('work.close')} data-preview-close>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>
    {/* How far down the case has been read. */}
    <i class="wpreview__read" aria-hidden="true" data-preview-read></i>
    {/* The projects either side: their pictures at the screen's edges, half in view, each with its arrow; pointed
        at, one comes forward with its name, and a press swaps it in. */}
    <button class="wpreview__peek wpreview__peek--prev" type="button" aria-label={t('work.prev')} data-preview-step="-1">
      <span class="wpreview__peek-pic" data-preview-step-thumb></span>
      <span class="wpreview__peek-go"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5.5M11 6.5 5.5 12 11 17.5"></path></svg></span>
      <span class="wpreview__peek-name" data-preview-step-name></span>
    </button>
    <button class="wpreview__peek wpreview__peek--next" type="button" aria-label={t('work.next')} data-preview-step="1">
      <span class="wpreview__peek-pic" data-preview-step-thumb></span>
      <span class="wpreview__peek-go"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg></span>
      <span class="wpreview__peek-name" data-preview-step-name></span>
    </button>
  </div>

  {/* The list, for reading: every case study, one to a line; the picture of the one that's picked floats beside the
      pointer, and a press opens it as a tile does (work-list.ts). */}
  <div class="wcanvas__list" hidden data-lenis-prevent data-canvas-list>
    <ol role="list">
      {items.map((item, i) => (
        <li style={`--i: ${i}`}>
          <a href={item.href} data-canvas-row={item.key}>
            <span class="wcanvas__list-no">{pad(i + 1)}</span>
            <span class="wcanvas__list-name">{item.name}</span>
            <span class="wcanvas__list-meta">{item.meta}</span>
            <svg class="wcanvas__list-go" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
          </a>
        </li>
      ))}
    </ol>
  </div>
  <div class="wcanvas__peek" aria-hidden="true" data-canvas-peek><img alt="" /></div>

  <div class="wcanvas__foot" data-canvas-foot>
    <div class="wcanvas__intro">
      {headline && <Heading class="wcanvas__title exp-title" role={heading === 'p' ? 'heading' : undefined} aria-level={heading === 'p' ? 1 : undefined}>{headline}</Heading>}
      {body && <p class="wcanvas__body">{body}</p>}
    </div>
    <div class="wcanvas__middle">
      <div class="wcanvas__views" role="group" aria-label={t('work.views')}>
        <button type="button" aria-pressed="true" data-canvas-view="grid">{t('work.grid')}</button>
        <button type="button" aria-pressed="false" data-canvas-view="list">{t('work.list')}</button>
      </div>
      {/* The camera: off until pressed. */}
      <button class="wcanvas__hand-toggle" type="button" aria-pressed="false" data-label-on={t('work.hand')} data-label-off={t('work.handOff')} data-label-wait={t('work.handStart')} data-canvas-hand>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 7.5h3l1.6-2.2h7.8l1.6 2.2h3v11h-17z"></path><circle cx="12" cy="12.8" r="3.4"></circle></svg>
        <span data-canvas-hand-label>{t('work.hand')}</span>
      </button>
    </div>
    {next && (
      <a class="exp-pill exp-pill--glass wcanvas__next" href={next.href} data-magnetic>
        {next.label}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v13.5M6.5 13 12 18.5 17.5 13"></path></svg>
      </a>
    )}
  </div>

  {/* The camera's picture, mirrored, with where it sees your hand; and that same place on the canvas. */}
  <div class="wcanvas__cam" hidden data-canvas-cam>
    <div class="wcanvas__cam-frame">
      <video muted playsinline aria-hidden="true" data-canvas-cam-video></video>
      <i class="wcanvas__cam-dot" aria-hidden="true" data-canvas-cam-dot></i>
    </div>
    <span>{t('work.handPrivate')}</span>
  </div>
  <span class="wcanvas__hand" aria-hidden="true" data-canvas-hand-dot><i></i></span>
  <span hidden data-canvas-hand-note={t('work.handNote')} data-canvas-hand-no={t('work.handNo')}></span>

  {/* How it works: a notification from Stride, once (work-canvas.ts). */}
  <div class="wcanvas__note exp-note" role="status" data-canvas-note>
    <span class="exp-note__avatar" set:html={mark} />
    <span class="exp-note__body">
      <span class="exp-note__from">{t('opening.from')} <span>{t('opening.when')}</span></span>
      <span class="exp-note__text">{t('work.hint')}</span>
    </span>
  </div>
</section>

<style>
  /* (A desktop-only component: its sizes are in rem, exactly its px at 1920×1080 and below, so on a larger screen it
     grows with the root size, styles/system/tokens.css. Hairlines stay in px.) */
  .wcanvas {
    /* Frosted glass for the controls here, as the site's glass buttons (.exp-pill--glass, styles/system/glass.css). */
    --glass: linear-gradient(135deg, rgb(var(--white-rgb) / calc(0.17 * var(--fill-k))), rgb(var(--white-rgb) / calc(0.05 * var(--fill-k))));
    --glass-lit: linear-gradient(135deg, rgb(var(--white-rgb) / calc(0.26 * var(--fill-k))), rgb(var(--white-rgb) / calc(0.1 * var(--fill-k))));
    --glass-edge: inset 0 0 0 1px rgb(var(--hair) / 0.38), inset 0 1px 0 rgb(var(--hair) / 0.5), 0 0.75rem 1.75rem -0.875rem rgb(3 10 24 / 0.85);
    --glass-blur: blur(0.875rem) saturate(1.4);
    position: relative;
    height: 100svh;
    min-height: 38.75rem;
    overflow: hidden;
    color: rgb(var(--ink));
  }

  /* The canvas: drawn by the script, the size of the section. Towards the foot the tiles fade away into the page's
     own background, so the words there read and nothing marks where the next section starts. (The fade as it was
     drawn, at every width: a fixed height, growing with the root size; it doesn't follow how tall the words are, so a
     small laptop, where they wrap, keeps the same light on its tiles.) */
  .wcanvas__field {
    position: absolute;
    inset: 0;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 20.625rem), rgb(0 0 0 / 0.3) calc(100% - 10.625rem), transparent calc(100% - 1.25rem));
    mask-image: linear-gradient(to bottom, #000 calc(100% - 20.625rem), rgb(0 0 0 / 0.3) calc(100% - 10.625rem), transparent calc(100% - 1.25rem));
  }

  /* Its edges sink into the dark (fading out with it at the foot). */
  .wcanvas__field::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 95% at 50% 45%, transparent 55%, rgb(4 12 28 / 0.6) 100%);
    pointer-events: none;
  }

  .wcanvas.is-dragging .wcanvas__field {
    cursor: grabbing;
  }

  .wcanvas__gl {
    display: block;
    width: 100%;
    height: 100%;
  }

  .wcanvas__gl[data-press] {
    cursor: pointer;
  }

  /* ---------- The list ---------- */
  /* Every case study, one to a line, in the page's wide type. The line under the pointer (or the keyboard) comes
     forward, the rest step back, a lit line runs out under it and its picture floats beside the pointer
     (work-list.ts). It scrolls inside itself, fading at both ends, with no scrollbar. */
  .wcanvas__list {
    position: absolute;
    inset: calc(var(--header-h) + var(--space-3)) var(--margin) calc(max(8.125rem, var(--foot, 0px)) + 4.375rem); /* ends above the words at the foot */
    z-index: 2;
    padding-block: 1.875rem 4.375rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 2.875rem, #000 calc(100% - 5.25rem), transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 2.875rem, #000 calc(100% - 5.25rem), transparent);
  }

  .wcanvas__list::-webkit-scrollbar {
    display: none;
  }

  .wcanvas__list[hidden] {
    display: none;
  }

  /* The canvas gone, once it has sunk away behind the list (work-canvas.ts). */
  .wcanvas.is-receded .wcanvas__field {
    visibility: hidden;
  }

  .wcanvas__list a {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto 1.375rem;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: 0.9375rem;
    border-top: 1px solid rgb(var(--hair) / 0.14);
    color: rgb(var(--ink) / 0.76);
    transition: color 320ms var(--ease-out);
  }

  .wcanvas__list li:last-child a {
    border-bottom: 1px solid rgb(var(--hair) / 0.14);
  }

  .wcanvas__list a::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 1px;
    background: linear-gradient(to right, rgb(var(--tone-lit)), rgb(var(--tone-lit) / 0));
    scale: 0 1;
    transform-origin: 0 50%;
    transition: scale 700ms var(--ease-out);
  }

  .wcanvas__list:has(a:hover, a:focus-visible) a:not(:hover, :focus-visible) {
    color: rgb(var(--ink) / 0.3);
  }

  .wcanvas__list a:hover,
  .wcanvas__list a:focus-visible {
    color: rgb(var(--ink));
  }

  .wcanvas__list a:hover::after,
  .wcanvas__list a:focus-visible::after {
    scale: 1 1;
  }

  .wcanvas__list a:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 2px;
    border-radius: 0.375rem;
  }

  .wcanvas__list-no {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.12em;
    color: rgb(var(--ink) / 0.42);
    transition: color 320ms var(--ease-out);
  }

  .wcanvas__list a:hover .wcanvas__list-no,
  .wcanvas__list a:focus-visible .wcanvas__list-no {
    color: rgb(var(--tone-lit));
  }

  .wcanvas__list-name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.1vw, 3rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 1;
    text-transform: uppercase;
    transition: translate 520ms var(--ease-out);
  }

  .wcanvas__list a:hover .wcanvas__list-name,
  .wcanvas__list a:focus-visible .wcanvas__list-name {
    translate: 1rem 0;
  }

  .wcanvas__list-meta {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.1em;
    text-align: right;
    text-transform: uppercase;
    color: rgb(var(--ink) / 0.6);
  }

  .wcanvas__list a:not(:hover, :focus-visible) .wcanvas__list-meta {
    color: inherit;
    opacity: 0.8;
  }

  .wcanvas__list-go {
    align-self: center;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    translate: -0.625rem 0;
    transition:
      opacity 320ms var(--ease-out),
      translate 520ms var(--ease-out);
  }

  .wcanvas__list a:hover .wcanvas__list-go,
  .wcanvas__list a:focus-visible .wcanvas__list-go {
    opacity: 1;
    translate: 0 0;
  }

  /* Coming in: the lines rise one after another, as the canvas sinks away behind them. Going, they leave together,
     a little upwards, before it comes back. */
  .wcanvas.is-list .wcanvas__list li {
    animation: wlist-in 640ms var(--ease-out) backwards;
    animation-delay: calc(120ms + min(var(--i, 0), 12) * 34ms);
  }

  @keyframes wlist-in {
    from {
      opacity: 0;
      translate: 0 1.5rem;
    }
  }

  .wcanvas__list.is-leaving li {
    opacity: 0;
    translate: 0 -0.75rem;
    transition:
      opacity 160ms var(--ease-out),
      translate 160ms var(--ease-out);
  }

  /* The picked line's picture: beside the pointer, leaning the way it's carried (placed every frame by the script). */
  .wcanvas__peek {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    width: clamp(15rem, 23vw, 21.875rem);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 1rem;
    background: rgb(14 24 42);
    box-shadow:
      inset 0 0 0 1px rgb(var(--hair) / 0.3),
      0 2.5rem 4.375rem -1.875rem rgb(0 0 0 / 0.95);
    opacity: 0;
    transform: translate(var(--px, 0), var(--py, 0)) rotate(var(--pr, 0deg)) scale(var(--ps, 0.86));
    transition: opacity 260ms var(--ease-out);
    pointer-events: none;
  }

  .wcanvas__peek.is-on {
    --ps: 1;
    opacity: 1;
  }

  /* (Its pictures stack: the next line's wipes in over the last, work-list.ts.) */
  .wcanvas__peek img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    opacity: 0;
    scale: 1.08;
    transition:
      opacity 320ms var(--ease-out),
      scale 900ms var(--ease-out);
  }

  .wcanvas__peek img.is-in {
    opacity: 1;
    scale: 1;
  }

  .wcanvas:not(.is-list) .wcanvas__peek {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .wcanvas.is-list .wcanvas__list li {
      animation: none;
    }

    .wcanvas__list a::after,
    .wcanvas__list-name,
    .wcanvas__list-go,
    .wcanvas__list.is-leaving li,
    .wcanvas__peek img {
      transition: none;
    }

    .wcanvas__list-go,
    .wcanvas__list a:hover .wcanvas__list-name,
    .wcanvas__list a:focus-visible .wcanvas__list-name {
      translate: none;
    }

    .wcanvas__peek img {
      scale: none;
    }
  }

  /* ---------- The foot: what this is, the views, the way on ---------- */
  .wcanvas__foot {
    position: absolute;
    right: var(--margin);
    bottom: 1.75rem;
    left: var(--margin);
    z-index: 4;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(max-content, 1fr);
    align-items: end;
    gap: var(--space-5);
    pointer-events: none;
  }

  .wcanvas__foot > * {
    pointer-events: auto;
  }

  .wcanvas__intro {
    display: grid;
    gap: 0.5rem;
    max-width: 30rem;
  }

  .wcanvas__title {
    font-size: clamp(2rem, 3.4vw, 3.25rem);
  }

  .wcanvas__body {
    font-size: 0.9375rem;
    color: rgb(var(--ink) / 0.78);
  }

  .wcanvas__middle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .wcanvas__hand-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--glass);
    box-shadow: var(--glass-edge);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--ink) / 0.86);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    transition:
      background 240ms var(--ease-out),
      color 240ms var(--ease-out),
      scale 380ms var(--spring-pop, cubic-bezier(0.2, 1.4, 0.35, 1));
  }

  .wcanvas__hand-toggle:hover,
  .wcanvas__hand-toggle[aria-pressed='true'] {
    background: var(--glass-lit);
    color: rgb(var(--ink));
  }

  /* Starting (the camera, then the model: a few seconds the first time), a light sweeps across it meanwhile. */
  .wcanvas__hand-toggle[aria-busy='true'] {
    background-image: linear-gradient(100deg, transparent 30%, rgb(var(--hair) / 0.18) 50%, transparent 70%), var(--glass);
    background-size: 200% 100%, auto;
    animation: whand-wait 1.6s linear infinite;
  }

  @keyframes whand-wait {
    from {
      background-position: 150% 0, 0 0;
    }

    to {
      background-position: -50% 0, 0 0;
    }
  }

  .wcanvas__hand-toggle:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 2px;
  }

  .wcanvas__hand-toggle svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .wcanvas__hand-toggle[hidden] {
    display: none;
  }

  /* The camera's picture: small, mirrored, above the way on, with a dot where it sees your hand. */
  .wcanvas__cam {
    position: absolute;
    right: var(--margin);
    bottom: 6rem;
    z-index: 5;
    display: grid;
    gap: 0.375rem;
    width: 11.75rem;
  }

  .wcanvas__cam[hidden] {
    display: none;
  }

  .wcanvas__cam-frame {
    position: relative;
    overflow: hidden;
    border-radius: 0.875rem;
    box-shadow:
      inset 0 0 0 1px rgb(var(--hair) / 0.3),
      0 1rem 1.875rem -1rem rgb(0 0 0 / 0.9);
  }

  .wcanvas__cam video {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transform: scaleX(-1);
  }

  .wcanvas__cam-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.875rem;
    height: 0.875rem;
    margin: -0.4375rem 0 0 -0.4375rem;
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 2px var(--white),
      0 0 0.625rem 0.125rem rgb(var(--tone-glow) / 0.8);
    opacity: 0;
    transition:
      opacity 200ms var(--ease-out),
      left 90ms linear,
      top 90ms linear;
  }

  .wcanvas__cam.is-seen .wcanvas__cam-dot {
    opacity: 1;
  }

  .wcanvas__cam span {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--ink) / 0.6);
  }

  /* Where the camera sees your hand: a ring of light on the canvas (placed every frame by the script), faint until
     it sees one, brighter and larger while it's moving the canvas, with a tick pointing the way it's going; small
     and full when the hand is a fist. As the camera starts, it pulses out once from the middle. */
  .wcanvas__hand {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    width: 3.625rem;
    height: 3.625rem;
    margin: -1.8125rem 0 0 -1.8125rem;
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 2px rgb(var(--hair) / 0.75),
      0 0 1.875rem 0.25rem rgb(var(--tone-glow) / 0.5);
    opacity: 0;
    transform: translate(var(--hx, 50vw), var(--hy, 50vh)) scale(var(--hs, 0.8));
    transition:
      opacity 300ms var(--ease-out),
      box-shadow 200ms var(--ease-out);
    pointer-events: none;
  }

  .wcanvas__hand::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 2px rgb(var(--hair) / 0.9),
      0 0 1.875rem 0.25rem rgb(var(--tone-glow) / 0.6);
    opacity: 0;
  }

  .wcanvas__hand i {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: rotate(var(--ha, 0deg));
    transition: opacity 200ms var(--ease-out);
  }

  .wcanvas__hand i::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -0.75rem;
    width: 0.5625rem;
    height: 0.5625rem;
    margin-top: -0.28125rem;
    border-top: 2px solid rgb(var(--hair) / 0.9);
    border-right: 2px solid rgb(var(--hair) / 0.9);
    transform: rotate(45deg);
  }

  .wcanvas.is-hand .wcanvas__hand {
    opacity: 0.18;
  }

  .wcanvas.is-hand .wcanvas__hand.is-seen {
    opacity: 0.7;
  }

  .wcanvas.is-hand .wcanvas__hand.is-moving,
  .wcanvas.is-hand .wcanvas__hand.is-fist,
  .wcanvas.is-hand .wcanvas__hand.is-start {
    opacity: 1;
  }

  .wcanvas__hand.is-start::before {
    animation: whand-start 700ms var(--ease-out);
  }

  @keyframes whand-start {
    from {
      opacity: 0.6;
      scale: 0.6;
    }

    to {
      opacity: 0;
      scale: 1.5;
    }
  }

  .wcanvas__hand.is-fist {
    box-shadow:
      inset 0 0 0 2px rgb(var(--hair) / 0.95),
      inset 0 0 0 2.5rem rgb(var(--hair) / 0.22),
      0 0 2.125rem 0.5rem rgb(var(--tone-glow) / 0.7);
  }

  .wcanvas__cam.is-fist .wcanvas__cam-dot {
    box-shadow:
      inset 0 0 0 0.4375rem var(--white),
      0 0 0.625rem 0.125rem rgb(var(--tone-glow) / 0.8);
  }

  .wcanvas__hand.is-moving i {
    opacity: 1;
  }

  .wcanvas__views {
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 999px;
    background: var(--glass);
    box-shadow: var(--glass-edge);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
  }

  .wcanvas__views button {
    min-height: 2.25rem;
    padding: 0 1rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--ink) / 0.72);
    transition:
      background 240ms var(--ease-out),
      box-shadow 240ms var(--ease-out),
      color 240ms var(--ease-out),
      scale 380ms var(--spring-pop, cubic-bezier(0.2, 1.4, 0.35, 1));
  }

  .wcanvas__views button:hover {
    color: rgb(var(--ink));
  }

  .wcanvas__views button[aria-pressed='true'] {
    background: rgb(var(--white-rgb) / calc(0.2 * var(--fill-k)));
    box-shadow: inset 0 0 0 1px rgb(var(--hair) / 0.3);
    color: rgb(var(--ink));
  }

  .wcanvas__views button:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 2px;
  }

  .wcanvas__views button:disabled {
    opacity: 0.4;
  }

  /* Pressed, they give a little, and spring back. */
  .wcanvas__hand-toggle:active,
  .wcanvas__views button:not(:disabled):active {
    scale: 0.97;
  }

  .wcanvas__next {
    justify-self: end;
    white-space: nowrap;
  }

  /* Below 1280 wide the three can't share a line: the words take one of their own, the views and the way on below. */
  @media (max-width: 1279px) {
    .wcanvas__foot {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'intro intro'
        'middle next';
      row-gap: var(--space-4);
    }

    .wcanvas__intro {
      grid-area: intro;
    }

    .wcanvas__middle {
      grid-area: middle;
    }

    .wcanvas__next {
      grid-area: next;
    }
  }

  /* The notification, at the top of the screen, as elsewhere: solid, not blurred, over the moving canvas (centred on
     its own width, styles/system/glass.css). */
  .wcanvas__note {
    position: absolute;
    top: 1.625rem;
    left: 50%;
    z-index: 101;
    margin-left: calc(min(27.5rem, 34vw) / -2);
    background: rgb(14 24 42 / 0.94);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    translate: 0 -1.125rem;
  }

  .wcanvas__note.is-on {
    translate: 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .wcanvas__hand-toggle[aria-busy='true'],
    .wcanvas__hand.is-start::before {
      animation: none;
    }

    .wcanvas__hand-toggle:active,
    .wcanvas__views button:not(:disabled):active {
      scale: none;
    }
  }

  /* ---------- The case study: over the whole screen, the canvas dimmed behind ---------- */
  .wpreview {
    position: fixed;
    inset: 0;
    z-index: 150;
    overflow: hidden;
    color: rgb(var(--ink));
  }

  .wpreview[hidden] {
    display: none;
  }

  :global(html.wpreview-on) {
    overflow: hidden;
  }

  .wpreview__shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 70% at 30% 50%, rgb(var(--tone-depth) / 0.35), transparent 70%),
      rgb(4 12 28 / 0.97);
    opacity: 0;
    transition: opacity 180ms var(--ease-out);
  }

  .wpreview.is-open .wpreview__shade {
    opacity: 1;
    transition-duration: 420ms;
  }

  /* The picture on the left, the case on the right to read down; no box around them. */
  .wpreview__stage {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.25rem, 4.5vw, 5rem);
    padding: 6rem var(--margin) 6rem;
    isolation: isolate;
    pointer-events: none;
    transition: opacity 200ms var(--ease-out);
  }

  .wpreview__stage.is-swapping {
    opacity: 0;
  }

  .wpreview__stage > :global(*) {
    pointer-events: auto;
  }

  /* The picture leans a little towards the pointer (--lx, --ly: -1 to 1, the script), and a light moves across it. */
  .wpreview__side {
    position: relative;
    display: grid;
    gap: 0.875rem;
    transform: perspective(93.75rem) rotateY(calc(var(--lx, 0) * 5deg)) rotateX(calc(var(--ly, 0) * -4deg));
  }

  /* A glow in the picture's own colours, behind it: the picture itself, very blurred, breathing slowly. */
  .wpreview__aura {
    position: absolute;
    inset: -16% -12%;
    z-index: -1;
    border-radius: 50%;
    background: center / cover no-repeat;
    filter: blur(4rem) saturate(1.8);
    opacity: 0;
    scale: 0.92;
    transition: opacity 300ms var(--ease-out);
    pointer-events: none;
  }

  .wpreview__stage.is-shown .wpreview__aura {
    opacity: 0.5;
    transition: opacity 1400ms var(--ease-out) 320ms;
    animation: waura 8s ease-in-out 1.6s infinite alternate;
  }

  @keyframes waura {
    to {
      opacity: 0.66;
      scale: 1.06;
    }
  }

  .wpreview__sheen {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(70% 70% at calc(50% + var(--lx, 0) * 42%) calc(42% + var(--ly, 0) * 42%), rgb(var(--white-rgb) / 0.2), transparent 70%);
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  /* The client's name, huge and in outline, behind it all: it runs past slowly, over and over, and shifts against the
     pointer. (Its outline grows with the screen, as the type does.) */
  .wpreview__stage > .wpreview__ghost {
    position: absolute;
    bottom: 2svh;
    left: 0;
    z-index: -1;
    font-family: var(--font-display);
    font-size: clamp(12rem, 26vw, 30rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.8;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 0.0625rem rgb(var(--hair) / 0.15);
    opacity: 0;
    translate: calc(var(--lx, 0) * -2.875rem) calc(var(--ly, 0) * -1.25rem);
    transition: opacity 400ms var(--ease-out);
    pointer-events: none;
    user-select: none;
  }

  /* (Four copies: half of them is exactly two, so it comes round without a jump. Longer names take longer.) */
  .wpreview__ghost > span {
    display: inline-flex;
    animation: wghost calc((var(--n, 6) * 9 + 4) * 1s) linear infinite;
  }

  .wpreview__ghost i {
    padding-right: 0.32em;
    font-style: normal;
  }

  @keyframes wghost {
    to {
      transform: translateX(-50%);
    }
  }

  .wpreview__stage.is-shown > .wpreview__ghost {
    opacity: 1;
    transition: opacity 900ms var(--ease-out) 260ms;
  }

  /* (It grows from, and shrinks back to, where it was on the screen about its own middle: work-preview.ts.) */
  .wpreview__media {
    position: relative;
    width: 100%;
    max-height: calc(100svh - 14.75rem);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 1.25rem;
    background: rgb(14 24 42);
    box-shadow:
      inset 0 0 0 1px rgb(var(--hair) / 0.18),
      0 3.125rem 5.625rem -2.5rem rgb(0 0 0 / 0.95);
    touch-action: pan-y;
    user-select: none;
    transition: scale 320ms var(--ease-out);
  }

  /* Held, the clip waits (as stories do): the picture gives a little under the press. */
  .wpreview__media.is-held {
    scale: 0.982;
  }

  .wpreview__media.is-held .wpreview__film {
    filter: brightness(0.82);
  }

  .wpreview__media img,
  .wpreview__media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .wpreview__media img {
    -webkit-user-drag: none;
  }

  .wpreview__film {
    opacity: 0;
    transition:
      opacity 600ms var(--ease-out),
      filter 220ms var(--ease-out);
  }

  .wpreview__film.is-in {
    opacity: 1;
  }

  /* The tile's own footage, carrying on from where it was: it doesn't fade in slowly again, only quickly over the
     picture for the moment it takes to start. */
  .wpreview__film.is-cut {
    transition:
      opacity 180ms var(--ease-out),
      filter 220ms var(--ease-out);
  }

  /* A tall clip (a reel) stands whole in the frame, over its picture softened and darkened. */
  .wpreview__film.is-tall {
    object-fit: contain;
  }

  .wpreview__media.is-tall .wpreview__picture {
    filter: blur(1.75rem) brightness(0.45);
    scale: 1.15;
  }

  /* Its clips, as stories: a bar each along the top of the picture, filling as it plays (--p, the script); the ones
     already played stay full. A press on the picture goes on to the next (on its left edge, back). They wait until
     the picture has arrived (.is-growing). */
  .wpreview__media:has(.wpreview__bars)::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, rgb(4 12 28 / 0.5), transparent 24%);
    pointer-events: none;
  }

  .wpreview__media:has(.wpreview__bars button + button) {
    cursor: pointer;
  }

  .wpreview__bars {
    position: absolute;
    top: 0.5rem;
    right: 0.875rem;
    left: 0.875rem;
    z-index: 2;
    display: flex;
    gap: 0.3125rem;
    transition: opacity 240ms var(--ease-out);
  }

  .wpreview__media.is-growing .wpreview__bars {
    opacity: 0;
    transition: none;
  }

  /* (Taller to press than the bar it shows.) */
  .wpreview__bars button {
    position: relative;
    flex: 1;
    height: 1.375rem;
  }

  .wpreview__bars button::before,
  .wpreview__bars i {
    content: '';
    position: absolute;
    top: 0.5625rem;
    left: 0;
    width: 100%;
    height: 0.1875rem;
    border-radius: 0.1875rem;
    background: rgb(var(--white-rgb) / 0.3);
  }

  .wpreview__bars i {
    background: var(--white);
    scale: var(--p, 0) 1;
    transform-origin: 0 50%;
  }

  .wpreview__bars .is-done i {
    scale: 1 1;
  }

  .wpreview__bars button:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 0;
    border-radius: 0.25rem;
  }

  .wpreview__caption {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--ink) / 0.6);
  }

  /* The case, to read down (the wheel anywhere on the stage scrolls it); its foot fades so more reads as more. */
  .wpreview__body {
    display: grid;
    align-content: safe center;
    gap: 1.25rem;
    max-height: calc(100svh - 12rem);
    padding: 0.375rem 0.625rem 3.5rem 0.125rem;
    container-type: inline-size;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    mask-image: linear-gradient(to bottom, #000 calc(100% - 4rem), transparent);
  }

  .wpreview__body::-webkit-scrollbar {
    display: none;
  }

  /* How far down it's been read (--read, the script): a hairline beside the case, lit from the top. */
  .wpreview__read {
    position: absolute;
    top: 6.5rem;
    right: calc(var(--margin) - 1.25rem);
    bottom: 6.5rem;
    width: 2px;
    border-radius: 2px;
    background: rgb(var(--hair) / 0.14);
    opacity: 0;
    transition: opacity 300ms var(--ease-out);
  }

  .wpreview__read::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 2px;
    background: rgb(var(--tone-lit));
    scale: 1 var(--read, 0);
    transform-origin: 50% 0;
  }

  .wpreview.is-open .wpreview__read:not(.is-off) {
    opacity: 1;
    transition-delay: 300ms;
  }

  /* Each part rises in as the picture grows, one after another (--i, the script); out quickly, all together. */
  .wpreview__body > * {
    opacity: 0;
    translate: 0 1rem;
    transition:
      opacity 180ms var(--ease-out),
      translate 180ms var(--ease-out);
  }

  .wpreview__stage.is-shown .wpreview__body > * {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 500ms var(--ease-out) calc(min(var(--i, 0), 8) * 55ms + 160ms),
      translate 650ms var(--ease-out) calc(min(var(--i, 0), 8) * 55ms + 160ms);
  }

  .wpreview__eyebrow,
  .wpreview__label {
    display: flex;
    gap: 0.875rem;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--ink) / 0.6);
  }

  .wpreview__eyebrow span {
    color: rgb(var(--ink) / 0.4);
  }

  /* As large as the column allows for its longest word (--len), up to the usual size; words never break. */
  .wpreview__name {
    font-family: var(--font-display);
    font-size: min(clamp(2.5rem, 4.6vw, 5rem), calc(100cqi / (var(--len, 8) * 0.84)));
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  /* It comes in letter by letter, each rising into its place (the script cuts it into words and letters: --k). */
  .wpreview__name :global(.wpreview__word) {
    display: inline-block;
    overflow: clip;
    overflow-clip-margin: 0.06em;
    white-space: nowrap;
    vertical-align: top;
  }

  .wpreview__name :global(.wpreview__word > span) {
    display: inline-block;
    translate: 0 108%;
    rotate: 9deg;
    transform-origin: 0 100%;
    transition:
      translate 180ms var(--ease-out),
      rotate 180ms var(--ease-out);
  }

  .wpreview__stage.is-shown .wpreview__name :global(.wpreview__word > span) {
    translate: 0 0;
    rotate: 0deg;
    transition:
      translate 760ms var(--ease-out) calc(var(--k, 0) * 26ms + 240ms),
      rotate 760ms var(--ease-out) calc(var(--k, 0) * 26ms + 240ms);
  }

  .wpreview__lead {
    max-width: 34rem;
    font-size: 1.25rem;
    line-height: 1.45;
    letter-spacing: -0.005em;
    color: rgb(var(--ink) / 0.94);
  }

  /* What it was and where: pills, the services lit, the facts quieter. */
  .wpreview__services,
  .wpreview__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .wpreview__services span,
  .wpreview__chips span {
    padding: 0.375rem 0.6875rem;
    border-radius: 999px;
  }

  .wpreview__services span {
    background: rgb(var(--tone-lit) / 0.16);
    box-shadow: inset 0 0 0 1px rgb(var(--tone-lit) / 0.5);
    color: rgb(var(--ink));
  }

  .wpreview__chips span {
    box-shadow: inset 0 0 0 1px rgb(var(--hair) / 0.24);
    color: rgb(var(--ink) / 0.68);
  }

  /* Its chapters: they stay at the top of the column as it's read, over a band of the panel's dark; the one being read
     lit, a line of light sliding under it (--cx, --cw: work-preview.ts; its length by scaling, a line of 100px to the
     button's width). */
  .wpreview__chapters {
    position: sticky;
    top: -0.375rem;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.125rem;
    justify-self: stretch;
    margin-inline: -0.75rem;
    padding: 0.875rem 0.75rem 0.75rem;
    background: rgb(8 16 34 / 0.985);
    backdrop-filter: blur(0.75rem);
    -webkit-backdrop-filter: blur(0.75rem);
  }

  /* Its edge melts into the column below it. */
  .wpreview__chapters::after {
    content: '';
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    height: 1.375rem;
    background: linear-gradient(rgb(8 16 34 / 0.985), rgb(8 16 34 / 0));
    pointer-events: none;
  }

  .wpreview__chapters button {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4375rem;
    padding: 0.25rem 0;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--ink) / 0.5);
    transition: color 240ms var(--ease-out);
  }

  .wpreview__chapters button span {
    color: rgb(var(--ink) / 0.32);
    transition: color 240ms var(--ease-out);
  }

  .wpreview__chapters button:hover {
    color: rgb(var(--ink) / 0.85);
  }

  .wpreview__chapters button[aria-current='true'] {
    color: rgb(var(--ink));
  }

  .wpreview__chapters button[aria-current='true'] span {
    color: rgb(var(--tone-lit));
  }

  .wpreview__chapters button:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 3px;
    border-radius: 0.25rem;
  }

  .wpreview__chapter-line {
    position: absolute;
    bottom: 0.5rem;
    left: 0;
    width: 100px;
    height: 2px;
    border-radius: 2px;
    background: rgb(var(--tone-lit));
    box-shadow: 0 0 0.75rem rgb(var(--tone-glow) / 0.9);
    transform: translateX(var(--cx, 0px)) scaleX(calc(var(--cw, 0) / 100));
    transform-origin: 0 50%;
    transition: transform 420ms cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  /* Each part of the story under a hairline, numbered; the parts not being read a little quieter. */
  .wpreview__part {
    display: grid;
    gap: 0.75rem;
    max-width: 34rem;
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(var(--hair) / 0.16);
    scroll-margin-top: 4rem;
    transition: opacity 420ms var(--ease-out);
  }

  .wpreview__body.has-chapters .wpreview__part:not(.is-current) {
    opacity: 0.55;
  }

  /* (Its quieting answers at once, not after the rise-in's delay.) */
  .wpreview__stage.is-shown .wpreview__body.has-chapters > .wpreview__part {
    transition:
      opacity 420ms var(--ease-out),
      translate 650ms var(--ease-out) calc(min(var(--i, 0), 8) * 55ms + 160ms);
  }

  .wpreview__label .wpreview__no,
  .wpreview__part > .wpreview__no {
    font-family: var(--font-mono);
    color: rgb(var(--tone-lit));
  }

  .wpreview__part .wpreview__label {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    letter-spacing: 0.01em;
    color: rgb(var(--ink));
  }

  .wpreview__part .wpreview__label .wpreview__no {
    align-self: center;
    font-size: var(--type-label);
    font-weight: 400;
    letter-spacing: 0.12em;
  }

  .wpreview__text {
    font-size: 1.03rem;
    line-height: 1.62;
    color: rgb(var(--ink) / 0.8);
  }

  /* The first paragraph of a part, a step larger, to read into it. */
  .wpreview__label + .wpreview__text {
    font-size: 1.125rem;
    line-height: 1.55;
    color: rgb(var(--ink) / 0.92);
  }

  .wpreview__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.125rem 2.5rem;
  }

  .wpreview__stats div {
    display: grid;
    gap: 0.25rem;
  }

  .wpreview__stats dd {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 1;
  }

  /* Counting up (work-preview.ts): its figures all as wide meanwhile, so it doesn't shake. */
  .wpreview__stats dd.is-counting {
    font-variant-numeric: tabular-nums;
  }

  .wpreview__stats dt,
  .wpreview__from {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--ink) / 0.6);
  }

  .wpreview__from {
    color: rgb(var(--ink) / 0.4);
  }

  .wpreview__quote blockquote {
    font-family: var(--font-text);
    font-size: 1.375rem;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: rgb(var(--ink) / 0.92);
  }

  .wpreview__quote figcaption {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--ink) / 0.5);
  }

  .wpreview__people {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .wpreview__people a {
    color: rgb(var(--ink) / 0.85);
    text-decoration: underline;
    text-decoration-color: rgb(var(--hair) / 0.3);
    text-underline-offset: 0.25rem;
    transition: color 220ms var(--ease-out);
  }

  .wpreview__people a:hover {
    color: rgb(var(--ink));
  }

  .wpreview__peek svg,
  .wpreview__close svg {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .wpreview__close {
    position: absolute;
    top: 1.5rem;
    right: var(--margin);
    z-index: 3;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--glass);
    box-shadow: var(--glass-edge);
    color: rgb(var(--ink));
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    opacity: 0;
    transition:
      opacity 180ms var(--ease-out),
      background 220ms var(--ease-out),
      rotate 420ms var(--ease-out);
  }

  .wpreview__close:hover {
    background: var(--glass-lit);
    rotate: 90deg;
  }

  .wpreview.is-open .wpreview__close {
    opacity: 1;
    transition:
      opacity 400ms var(--ease-out) 240ms,
      background 220ms var(--ease-out),
      rotate 420ms var(--ease-out);
  }

  /* The projects either side: their pictures at the screen's edges, more than half out of view, turned away and
     dim, each with its arrow; pointed at (or focused), one comes forward, in its colours, and its name shows. A
     press swaps it in, from its side. (They keep to the page's margin, clear of the case's words.) */
  .wpreview__peek {
    --w: clamp(12.5rem, 19vw, 18.75rem);
    position: absolute;
    top: 50%;
    z-index: 2;
    width: var(--w);
    aspect-ratio: 4 / 3;
    margin-top: calc(var(--w) * -0.375);
    border-radius: 1.125rem;
    color: rgb(var(--ink));
    opacity: 0;
    transition:
      opacity 180ms var(--ease-out),
      translate 560ms var(--ease-out),
      rotate 560ms var(--ease-out),
      scale 560ms var(--ease-out);
  }

  .wpreview__peek--prev {
    left: calc(var(--w) * -0.54);
    rotate: -6deg;
  }

  .wpreview__peek--next {
    right: calc(var(--w) * -0.54);
    rotate: 6deg;
  }

  .wpreview.is-open .wpreview__peek {
    opacity: 1;
    transition:
      opacity 500ms var(--ease-out) 380ms,
      translate 560ms var(--ease-out),
      rotate 560ms var(--ease-out),
      scale 560ms var(--ease-out);
  }

  .wpreview__peek:hover,
  .wpreview__peek:focus-visible {
    scale: 1.05;
  }

  .wpreview__peek--prev:hover,
  .wpreview__peek--prev:focus-visible {
    translate: calc(var(--w) * 0.1) 0;
    rotate: -2deg;
  }

  .wpreview__peek--next:hover,
  .wpreview__peek--next:focus-visible {
    translate: calc(var(--w) * -0.1) 0;
    rotate: 2deg;
  }

  .wpreview__peek:active {
    scale: 1;
  }

  .wpreview__peek-pic {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgb(14 24 42) center / cover no-repeat;
    box-shadow:
      inset 0 0 0 1px rgb(var(--hair) / 0.3),
      0 2.25rem 4.375rem -1.875rem rgb(0 0 0 / 0.95);
    filter: brightness(0.5) saturate(0.7);
    transition: filter 360ms var(--ease-out);
  }

  .wpreview__peek:hover .wpreview__peek-pic,
  .wpreview__peek:focus-visible .wpreview__peek-pic {
    filter: none;
  }

  /* Its arrow, in glass, on the corner that's in view: which way it goes, before it's pointed at. */
  .wpreview__peek-go {
    position: absolute;
    top: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    border-radius: 50%;
    background: var(--glass);
    box-shadow: var(--glass-edge);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    transition: background 220ms var(--ease-out);
  }

  .wpreview__peek-go svg {
    transition: translate 320ms var(--ease-out);
  }

  .wpreview__peek:hover .wpreview__peek-go {
    background: var(--glass-lit);
  }

  .wpreview__peek--prev:hover .wpreview__peek-go svg {
    translate: -0.1875rem 0;
  }

  .wpreview__peek--next:hover .wpreview__peek-go svg {
    translate: 0.1875rem 0;
  }

  .wpreview__peek-name {
    position: absolute;
    bottom: 0.75rem;
    max-width: calc(var(--w) * 0.52 - 0.75rem);
    padding: 0 0.6875rem;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(var(--navy-900-rgb) / 0.72);
    box-shadow: inset 0 0 0 1px rgb(var(--hair) / 0.3);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    line-height: 2rem;
    letter-spacing: 0.02em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
    backdrop-filter: blur(0.625rem);
    -webkit-backdrop-filter: blur(0.625rem);
    opacity: 0;
    translate: 0 0.5rem;
    transition:
      opacity 300ms var(--ease-out),
      translate 420ms var(--ease-out);
  }

  .wpreview__peek--prev .wpreview__peek-go,
  .wpreview__peek--prev .wpreview__peek-name {
    right: 0.75rem;
  }

  .wpreview__peek--next .wpreview__peek-go,
  .wpreview__peek--next .wpreview__peek-name {
    left: 0.75rem;
  }

  .wpreview__peek:hover .wpreview__peek-name,
  .wpreview__peek:focus-visible .wpreview__peek-name {
    opacity: 1;
    translate: 0 0;
  }

  .wpreview__close:focus-visible,
  .wpreview__peek:focus-visible,
  .wpreview__people a:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 3px;
  }

  /* Below 1280 wide, the case's column takes a little of the margin, as far as the projects at the edges allow: half
     of one shows (--w, above), turned, and a little more pointed at; the column and its hairline stay clear of it. */
  @media (max-width: 1279px) {
    .wpreview__stage {
      padding-inline: calc(clamp(12.5rem, 19vw, 18.75rem) * 0.5 + 3rem);
    }

    .wpreview__read {
      right: calc(clamp(12.5rem, 19vw, 18.75rem) * 0.5 + 1.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wpreview__shade,
    .wpreview__stage,
    .wpreview__body > *,
    .wpreview__close,
    .wpreview__peek,
    .wpreview__peek-pic,
    .wpreview__peek-go svg,
    .wpreview__peek-name,
    .wpreview__film,
    .wpreview__media,
    .wpreview__aura,
    .wpreview__bars,
    .wpreview__chapter-line,
    .wpreview__stage > .wpreview__ghost {
      transition: none;
    }

    .wpreview__side {
      transform: none;
    }

    .wpreview__ghost > span,
    .wpreview__stage.is-shown .wpreview__aura {
      animation: none;
    }

    .wpreview__name :global(.wpreview__word > span),
    .wpreview__stage.is-shown .wpreview__name :global(.wpreview__word > span) {
      translate: 0 0;
      rotate: 0deg;
      transition: none;
    }
  }

  /* ---------- Phones and tablets: the same canvas, moved with a finger (the owner, 2026-11-13) ----------
     Its tiles are in proportion to the screen (work-canvas.ts); the words, the views and the way on stack at its foot,
     where the tiles fade into the page. No camera (the hand is the finger here). A tile opens its case study over the
     page, its picture at the top and the case to read below it, the projects either side as two arrows at the foot. */
  @media (max-width: 1023px) {
    .wcanvas {
      min-height: 32rem;
    }

    .wcanvas__field {
      -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - var(--foot, 16rem) - 8rem), rgb(0 0 0 / 0.3) calc(100% - var(--foot, 16rem) + 1rem), transparent calc(100% - var(--foot, 16rem) + 5rem));
      mask-image: linear-gradient(to bottom, #000 calc(100% - var(--foot, 16rem) - 8rem), rgb(0 0 0 / 0.3) calc(100% - var(--foot, 16rem) + 1rem), transparent calc(100% - var(--foot, 16rem) + 5rem));
    }

    .wcanvas__foot {
      bottom: max(1.25rem, env(safe-area-inset-bottom));
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'intro'
        'middle'
        'next';
      row-gap: var(--space-3);
    }

    .wcanvas__next {
      justify-self: start;
    }

    .wcanvas__title {
      font-size: clamp(2.25rem, 10vw, 3.25rem);
    }

    .wcanvas__body {
      max-width: 34ch;
    }

    .wcanvas__hand-toggle {
      display: none;
    }

    .wcanvas__note {
      top: max(0.75rem, env(safe-area-inset-top));
      right: var(--margin);
      left: var(--margin);
      width: auto;
      margin-left: 0;
    }

    .wcanvas__list a {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .wcanvas__list-meta,
    .wcanvas__list-go {
      display: none;
    }

    .wcanvas__peek {
      display: none;
    }

    /* The case study: the picture at the top, the case scrolling under it. */
    .wpreview__stage {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      align-items: stretch;
      gap: var(--space-4);
      padding: calc(max(0.75rem, env(safe-area-inset-top)) + 3.75rem) var(--margin) calc(max(0.75rem, env(safe-area-inset-bottom)) + 4.5rem);
    }

    .wpreview__side {
      transform: none;
    }

    .wpreview__media {
      max-height: 34svh;
      margin-inline: auto;
      border-radius: 1rem;
    }

    .wpreview__body {
      align-content: start;
      max-height: none;
      padding: 0 0 3rem;
    }

    .wpreview__read {
      display: none;
    }

    .wpreview__close {
      top: max(0.75rem, env(safe-area-inset-top));
      width: 2.75rem;
      height: 2.75rem;
    }

    /* The projects either side: two arrows at the foot. */
    .wpreview__peek,
    .wpreview__peek--prev,
    .wpreview__peek--next {
      --w: 3rem;
      top: auto;
      bottom: max(0.75rem, env(safe-area-inset-bottom));
      aspect-ratio: 1;
      margin-top: 0;
      rotate: none;
      translate: none;
    }

    .wpreview__peek--prev {
      left: var(--margin);
    }

    .wpreview__peek--next {
      right: var(--margin);
    }

    .wpreview__peek-pic,
    .wpreview__peek-name {
      display: none;
    }

    .wpreview__peek-go {
      position: static;
      width: 100%;
      height: 100%;
    }
  }

  /* Tablets: a larger picture; the views and the way on share a line again. */
  @media (min-width: 768px) and (max-width: 1023px) {
    .wpreview__media {
      max-height: 40svh;
    }

    .wcanvas__foot {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'intro intro'
        'middle next';
    }

    .wcanvas__next {
      justify-self: end;
    }
  }
</style>

<script>
  import { initWorkCanvas } from '@/scripts/system/work-canvas';
  initWorkCanvas();
</script>
