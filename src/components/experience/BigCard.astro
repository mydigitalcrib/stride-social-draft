---
// The big card a glass card grows into (src/scripts/system/grow.ts): the navy and glow of the stages,
// the cards' hairline edge, a wide uppercase name, mono labels, footage in the hero's grade, and inside
// it whatever that card holds: services, case studies, verified results, a quote, a video.
// Desktop: it opens like a lens coming into focus (the photo settles, the words follow it in, the close button turns
// in), closes clean (its contents fade before it shrinks), and holds the keyboard while it's open (grow.ts).
// In a deck that opens (Stride Social and its services, `opens`) it's a spread (the owner, 2026-11-17: "the colors
// inside the box are off" and "it's weird to have to scroll"): on navy glass, the photo and the name on the left, and
// what it holds side by side on the right, a column a service, no boxes, sized to fit (grow.ts sets --fit), so nothing
// scrolls; on a phone, a sheet over the whole screen that scrolls as a page does.
import type { Card } from '@/lib/experience';
import { pad } from '@/lib/experience';
import { interfaceCopy } from '@/lib/ui-copy';

export interface Props {
  card: Card;
  growKey: string;
  eyebrow: string;
  index?: number;
  total?: number;
  /** In a deck that opens (experience/Deck.astro, `spines`): on desktop the photo is a third of the card, or all of
   *  it when the card has only its story to tell. */
  opens?: boolean;
}

const { card: c, growKey, eyebrow, index, total, opens = false } = Astro.props;
const t = await interfaceCopy();
// How wide the photo shows on desktop (the content is about 82vw), so a large screen fetches a large enough file.
const storyOnly = !(c.blocks?.length || c.stats?.length);
const sizes = opens ? (storyOnly ? '(min-width: 1024px) 82vw, 100vw' : '(min-width: 1024px) 28vw, 100vw') : '50vw';
// The spread's columns: a column a service (three at most); case studies two to a row.
const listy = !!c.blocks?.some((b) => b.list?.length);
const cols = c.blocks?.length ? Math.min(c.blocks.length, listy ? 3 : 2) : 1;
---

<div class:list={['bigcard', { 'bigcard--spread': opens, 'bigcard--film': opens && !!c.video }]} role="dialog" aria-label={c.name} hidden data-grow-detail={growKey} data-lenis-prevent>
  {/* A film's own picture, blurred into a glow behind it. */}
  {opens && c.video && c.image && <img class="bigcard__glow" src={c.image.src} alt="" sizes="40vw" loading="lazy" decoding="async" />}
  {c.image && !c.video && <img class="bigcard__image" src={c.image.src} alt={c.image.alt} style={c.image.position ? `object-position: ${c.image.position}` : undefined} sizes={sizes} loading="lazy" decoding="async" />}
  <button class="bigcard__close" type="button" aria-label="Close" data-grow-close>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
  </button>
  <div class="bigcard__body">
    <header class="bigcard__head">
      <p class="bigcard__eyebrow">{eyebrow}{index !== undefined && total !== undefined && <span>{pad(index + 1)} / {pad(total)}</span>}</p>
      <h3 class="bigcard__name">{c.name}</h3>
      {c.text && <p class="bigcard__copy">{c.text}</p>}
      {c.chips && c.chips.length > 0 && <p class="bigcard__chips">{c.chips.map((x) => <span>{x}</span>)}</p>}
    </header>

    <div class="bigcard__rest" data-fit={opens ? '' : undefined}>
    {c.quote && (
      <figure class="bigcard__quote">
        <blockquote>{c.quote}</blockquote>
        {c.attribution && <figcaption>{c.attribution}</figcaption>}
      </figure>
    )}

    {c.html && <div class="bigcard__html" set:html={c.html} />}

    {c.video && (
      <video class="bigcard__video" controls playsinline preload="none" poster={c.image?.src} aria-label={c.name}>
        <source src={c.video} type="video/mp4" />
      </video>
    )}

    {c.stats && c.stats.length > 0 && (
      <dl class="bigcard__stats">
        {c.stats.map((r) => <div><dt>{r.label}</dt><dd>{r.value}</dd></div>)}
      </dl>
    )}

    {c.blocks && c.blocks.length > 0 && (
      <ul class="bigcard__blocks" role="list" data-cols={cols}>
        {c.blocks.map((b, bi) => (
          <li class="bigcard__slot">
            <a class="bigcard__block" href={b.href} aria-label={`${b.action}: ${b.title}`}>
              <h4 class="bigcard__block-title" data-n={pad(bi + 1)}>{b.title}</h4>
              {b.text && <p class="bigcard__block-text">{b.text}</p>}
              {b.list && b.list.length > 0 && (
                <ol class="bigcard__block-list" role="list">
                  {b.list.map((x, n) => <li><span aria-hidden="true">{pad(n + 1)}</span>{x}</li>)}
                </ol>
              )}
              <span class="bigcard__go" aria-hidden="true">{b.action}</span>
              <span class="bigcard__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
              </span>
            </a>
            {b.keep && (
              <button class="bigcard__keep exp-pill exp-pill--ghost" type="button" aria-pressed="false" data-keep={b.keep.list} data-keep-id={b.keep.id} data-keep-label={b.keep.label} data-keep-group={b.keep.group}>
                <span class="keep-off">{t('door.add')}</span><span class="keep-on">{t('door.added')}</span>
              </button>
            )}
          </li>
        ))}
      </ul>
    )}

    {c.action && (
      <a class="bigcard__action" href={c.action.href} target={c.action.external ? '_blank' : undefined} rel={c.action.external ? 'noopener' : undefined}>
        {c.action.label}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
      </a>
    )}
    </div>
  </div>
</div>

<style>
  .bigcard {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow-y: auto;
    border-radius: 26px;
    background:
      radial-gradient(70% 60% at 18% 0%, rgb(var(--tone-depth) / 0.5), transparent 70%),
      radial-gradient(70% 50% at 70% 110%, rgb(var(--tone-wash) / 0.22), transparent 72%),
      rgb(var(--tone-surface));
    box-shadow:
      inset 0 0 0 1px rgb(var(--hair) / 0.26),
      inset 0 1px 0 rgb(var(--white-rgb) / 0.3),
      0 0 34px -8px rgb(var(--tone-glow) / 0.45),
      0 30px 60px -30px rgb(var(--shade) / 0.8);
    color: rgb(var(--ink));
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--hair) / 0.3) transparent;
  }

  .bigcard[hidden] {
    display: none;
  }

  .bigcard__image {
    position: absolute;
    inset: 0 0 auto auto;
    width: 56%;
    height: min(100%, 460px);
    max-width: none;
    object-fit: cover;
    opacity: 0.62;
    filter: contrast(1.1) saturate(1.18) brightness(0.94);
    mask-image:
      linear-gradient(to left, #000 35%, transparent 100%),
      linear-gradient(to top, transparent, #000 45%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
    pointer-events: none;
  }

  .bigcard__close {
    position: sticky;
    top: 18px;
    z-index: 2;
    float: right;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin: 18px 18px 0 0;
    border-radius: 50%;
    background: rgb(var(--white-rgb) / calc(0.05 * var(--fill-k)));
    box-shadow: inset 0 0 0 1px rgb(var(--hair) / 0.34);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      background-color 400ms var(--ease-out),
      color 400ms var(--ease-out);
  }

  .bigcard__close:hover {
    background: rgb(var(--press));
    color: rgb(var(--press-on));
  }

  .bigcard__rest {
    display: contents;
  }

  .bigcard__go {
    display: none;
  }

  .bigcard__slot {
    position: relative;
  }

  /* In rem: it grows with the screen past 1920×1080 (tokens.css). */
  .bigcard__keep {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    min-height: 2.5rem;
    padding: 0.375rem 0.875rem;
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  .bigcard__close:focus-visible,
  .bigcard__action:focus-visible,
  .bigcard__block:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 3px;
  }

  .bigcard__close svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .bigcard__body {
    position: relative;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: clamp(var(--space-5), 4vh, var(--space-7));
    padding: clamp(28px, 3.4vw, 56px);
  }

  .bigcard__head {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
  }

  .bigcard__eyebrow {
    display: flex;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--ink) / 0.72);
  }

  .bigcard__eyebrow span {
    color: rgb(var(--tone-lit));
  }

  .bigcard__name {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, min(4.4vw, 9vh), 4.5rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    text-shadow: 0 2px 24px rgb(var(--halo) / 0.5);
  }

  .bigcard__copy {
    max-width: 34rem;
    font-size: var(--type-lead);
    line-height: 1.4;
    color: rgb(var(--ink) / 0.88);
    text-shadow: 0 1px 14px rgb(var(--halo) / 0.6);
  }

  .bigcard__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .bigcard__chips span {
    padding: 5px 12px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(var(--hair) / 0.3);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .bigcard__quote {
    display: grid;
    gap: var(--space-4);
    max-width: 46rem;
  }

  .bigcard__quote blockquote {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 2.25rem);
    font-weight: 700;
    line-height: 1.12;
    text-shadow: 0 1px 14px rgb(var(--halo) / 0.6);
  }

  .bigcard__quote figcaption {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--tone-lit));
  }

  .bigcard__html {
    display: grid;
    gap: var(--space-3);
    max-width: 44rem;
    color: rgb(var(--ink) / 0.86);
    text-shadow: 0 1px 14px rgb(var(--halo) / 0.6);
  }

  .bigcard__video {
    width: min(100%, 300px);
    aspect-ratio: 9 / 16;
    border-radius: 26px;
    object-fit: cover;
    background: var(--navy-700);
    box-shadow: 0 0 0 1px rgb(var(--white-rgb) / 0.22);
  }

  .bigcard__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-8);
  }

  .bigcard__stats div {
    display: grid;
    gap: var(--space-2);
  }

  .bigcard__stats dd {
    order: -1;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 3.5rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: rgb(var(--tone-lit));
  }

  .bigcard__stats dt {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--ink) / 0.74);
  }

  .bigcard__blocks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: clamp(12px, 1.3vw, 20px);
    width: 100%;
  }

  .bigcard__block {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: start;
    gap: var(--space-3);
    height: 100%;
    padding: clamp(20px, 1.8vw, 28px);
    padding-bottom: 76px;
    overflow: hidden;
    border-radius: 22px;
    background: linear-gradient(165deg, rgb(var(--white-rgb) / calc(0.13 * var(--fill-k))), rgb(var(--white-rgb) / calc(0.05 * var(--fill-k))) 42%, rgb(var(--white-rgb) / calc(0.025 * var(--fill-k))) 62%, rgb(var(--white-rgb) / calc(0.07 * var(--fill-k))));
    box-shadow:
      inset 0 0 0 1px rgb(var(--hair) / 0.18),
      inset 0 1px 0 rgb(var(--white-rgb) / 0.3),
      0 24px 50px -30px rgb(var(--shade) / 0.8);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    transition:
      translate 500ms var(--ease-out),
      box-shadow 500ms var(--ease-out);
  }

  .bigcard__block::before {
    content: '';
    position: absolute;
    inset: auto -25% -42%;
    z-index: -1;
    height: 70%;
    background: radial-gradient(50% 50% at 50% 50%, rgb(var(--tone-wash) / 0.22), transparent 72%);
  }

  .bigcard__block:hover {
    translate: 0 -4px;
    box-shadow:
      inset 0 0 0 1.5px rgb(var(--tone-lit) / 0.9),
      0 0 26px -4px rgb(var(--tone-glow) / 0.55),
      0 24px 50px -30px rgb(var(--shade) / 0.8);
  }

  .bigcard__block:hover .bigcard__arrow {
    background: rgb(var(--press));
    color: rgb(var(--press-on));
  }

  .bigcard__block-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.7vw, 1.75rem);
    font-weight: 800;
    line-height: 1.02;
    text-transform: uppercase;
  }

  .bigcard__block-text {
    font-size: 0.9375rem;
    line-height: 1.42;
    color: rgb(var(--ink) / 0.8);
  }

  .bigcard__block-list {
    display: grid;
    gap: 7px;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    line-height: 1.35;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--ink) / 0.74);
  }

  .bigcard__block-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
  }

  .bigcard__block-list span {
    color: rgb(var(--tone-lit));
  }

  .bigcard__arrow {
    position: absolute;
    right: 16px;
    bottom: 16px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgb(var(--navy-900-rgb) / 0.45);
    color: var(--white);
    box-shadow: inset 0 0 0 1px rgb(var(--hair) / 0.4);
    transition:
      background-color 400ms var(--ease-out),
      color 400ms var(--ease-out);
  }

  .bigcard__arrow svg,
  .bigcard__action svg {
    flex: none;
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bigcard__action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    padding: 8px var(--space-5);
    border-radius: 999px;
    background: rgb(var(--press));
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--press-on));
    transition: background-color 300ms var(--ease-out);
  }

  .bigcard__action:hover {
    background: rgb(var(--press-hover));
  }

  /* Desktop: the sizes above in rem, so the card grows with the screen past 1920×1080 (tokens.css); the same until
     then. Hairlines stay fine lines. */
  @media (min-width: 1024px) {
    .bigcard {
      border-radius: 1.625rem;
      box-shadow:
        inset 0 0 0 1px rgb(var(--hair) / 0.26),
        inset 0 1px 0 rgb(var(--white-rgb) / 0.3),
        0 0 2.125rem -0.5rem rgb(var(--tone-glow) / 0.45),
        0 1.875rem 3.75rem -1.875rem rgb(var(--shade) / 0.8);
    }

    .bigcard__image {
      height: min(100%, 28.75rem);
    }

    .bigcard__close {
      top: 1.125rem;
      width: 2.875rem;
      height: 2.875rem;
      margin: 1.125rem 1.125rem 0 0;
      backdrop-filter: blur(0.625rem);
      -webkit-backdrop-filter: blur(0.625rem);
    }

    .bigcard__close svg {
      width: 1rem;
      height: 1rem;
    }

    .bigcard__body {
      padding: clamp(1.75rem, 3.4vw, 3.5rem);
    }

    .bigcard__name {
      text-shadow: 0 0.125rem 1.5rem rgb(var(--halo) / 0.5);
    }

    .bigcard__copy,
    .bigcard__quote blockquote,
    .bigcard__html {
      text-shadow: 0 1px 0.875rem rgb(var(--halo) / 0.6);
    }

    .bigcard__chips span {
      padding: 0.3125rem 0.75rem;
    }

    .bigcard__video {
      width: min(100%, 18.75rem);
      border-radius: 1.625rem;
    }

    .bigcard__blocks {
      gap: clamp(0.75rem, 1.3vw, 1.25rem);
    }

    .bigcard__block {
      padding: clamp(1.25rem, 1.8vw, 1.75rem);
      padding-bottom: 4.75rem;
      border-radius: 1.375rem;
      box-shadow:
        inset 0 0 0 1px rgb(var(--hair) / 0.18),
        inset 0 1px 0 rgb(var(--white-rgb) / 0.3),
        0 1.5rem 3.125rem -1.875rem rgb(var(--shade) / 0.8);
      backdrop-filter: blur(1.25rem) saturate(150%);
      -webkit-backdrop-filter: blur(1.25rem) saturate(150%);
    }

    .bigcard__block:hover {
      translate: 0 -0.25rem;
      box-shadow:
        inset 0 0 0 1.5px rgb(var(--tone-lit) / 0.9),
        0 0 1.625rem -0.25rem rgb(var(--tone-glow) / 0.55),
        0 1.5rem 3.125rem -1.875rem rgb(var(--shade) / 0.8);
    }

    .bigcard__block-list {
      gap: 0.4375rem;
    }

    .bigcard__arrow {
      right: 1rem;
      bottom: 1rem;
      width: 2.5rem;
      height: 2.5rem;
    }

    .bigcard__arrow svg,
    .bigcard__action svg {
      width: 0.9375rem;
      height: 0.9375rem;
    }

    .bigcard__action {
      min-height: 2.75rem;
      padding: 0.5rem var(--space-5);
    }
  }

  @media (max-width: 1023px) {
    .bigcard__image {
      opacity: 0.32;
      width: 100%;
    }
  }

  /* ---------- The spread: in a deck that opens (Stride Social and its services), every screen ----------
     The owner, 2026-11-17: a new style ("the colors inside the box are off", and no scrolling inside it). Navy glass
     with a rim of ice; the photo and the name on the left; on the right what the card holds side by side, a column a
     service (case studies two to a row), parted by hairlines of ice, the services read as plain numbered lines and
     nothing boxed. Its sizes scale with --fit, which grow.ts lowers until everything fits the card, so it never
     scrolls. A phone has a sheet over the whole screen instead, read as a page (below). */
  .bigcard.bigcard--spread {
    --ink: 255 255 255;
    --tone-lit: var(--ice-rgb);
    --halo: var(--navy-900-rgb);
    --fit: 1;
    overflow: hidden;
    border-radius: 1.625rem;
    background:
      radial-gradient(55% 65% at 100% 0%, rgb(var(--ice-rgb) / 0.1), transparent 62%),
      radial-gradient(70% 80% at 40% 120%, rgb(41 67 104 / 0.5), transparent 70%),
      linear-gradient(160deg, rgb(12 39 83 / 0.95), rgb(var(--navy-900-rgb) / 0.98) 62%);
    box-shadow:
      inset 0 0 0 1px rgb(var(--ice-rgb) / 0.22),
      inset 0 1px 0 rgb(var(--white-rgb) / 0.24),
      0 0 3rem -1.25rem rgb(var(--ice-rgb) / 0.4),
      0 2rem 4rem -2rem rgb(0 0 0 / 0.75);
    color: var(--white);
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--ice-rgb) / 0.3) transparent;
  }

  .bigcard--spread .bigcard__eyebrow {
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    color: rgb(var(--ice-rgb) / 0.82);
  }

  .bigcard--spread .bigcard__eyebrow span {
    color: var(--white);
  }

  .bigcard--spread .bigcard__name,
  .bigcard--spread .bigcard__copy {
    text-shadow: none;
  }

  .bigcard--spread .bigcard__copy {
    color: rgb(var(--white-rgb) / 0.86);
  }

  /* What it holds: no boxes. */
  .bigcard--spread .bigcard__blocks {
    gap: 0;
  }

  .bigcard--spread .bigcard__slot {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 0;
    container-type: inline-size;
  }

  /* A soft light behind the column pointed at. */
  .bigcard--spread .bigcard__slot::before {
    content: '';
    position: absolute;
    inset: -30% -12% auto;
    height: 75%;
    background: radial-gradient(50% 50% at 50% 50%, rgb(var(--ice-rgb) / 0.12), transparent 70%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 500ms var(--ease-out);
  }

  .bigcard--spread .bigcard__slot:hover::before {
    opacity: 1;
  }

  .bigcard--spread .bigcard__block,
  .bigcard--spread .bigcard__block:hover {
    position: relative;
    isolation: auto;
    display: flex;
    flex-direction: column;
    gap: calc(0.625rem * var(--fit));
    flex: 1 1 auto;
    min-height: 0;
    height: auto;
    padding: 0;
    overflow: visible;
    border-radius: 0;
    background: none;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    translate: none;
  }

  .bigcard--spread .bigcard__block::before {
    display: none;
  }

  /* The room its foot needs (the way in, and Add to brief beside it), kept as part of what it holds, so a column that
     runs too long shows as running over and the spread fits itself smaller (grow.ts) instead of covering its foot. */
