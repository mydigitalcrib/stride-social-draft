---
// Homepage section 2, "Three sides of Stride": the intro (heading, one line) above the three businesses.
// Desktop: three giant rows, one per division, margin to margin ("STRIDE" and the name both solid), who it
// is for on the right (the owner's choice, 2026-11-12). Pointed at (or focused), a row opens: it takes most of
// the height while the others close up and dim, and its world comes up behind it (Social: Stride's photographs side by side, as
// behind /social's closing row, lib/social-pictures.ts; the owner, 2026-11-18; Talent: its creators, side by side in black and white; Academy: a creator's setup in
// its colour, as it isn't open yet), with its line and the way in. Phones and tablets: a row of glass cards (an icon, the name,
// who it is for, an arrow). Below, the brand partners: a scroll cue and the logos on their ticker (core/BrandTicker).
// Desktop, in motion (the script below): the rows arrive with their lines drawing in and their names rising out of
// them; a row opens only once the pointer has moved (never as the page scrolls under a still one) or from the
// keyboard (the arrows move between the rows); its world opens as a soft circle from where the pointer came in, its
// photographs drift a little against the pointer and its lines catch the light under it; Talent's faces develop into
// colour under the pointer; the ticker rests while it's off the screen (its eased stop while pointed at is
// core/BrandTicker's own).
// On desktop this sits over the hero's frosted footage (home/HeroScene.astro); elsewhere on its own
// navy. Logos follow the brand approval rule (lib/partners.ts).
import { getEntry } from 'astro:content';
import BrandTicker from '../core/BrandTicker.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';
import { getPartners } from '@/lib/partners';
import { getRoster } from '@/lib/roster';
import { getSocialPictures } from '@/lib/social-pictures';

type Division = 'social' | 'talent' | 'education';

export interface Props {
  headline: string;
  body?: string;
  items: {
    key: Division;
    label: string; // "Social"
    audience: string; // "For brands"
    copy?: string; // its line, shown when its row opens (desktop)
    cta: string; // "Explore Stride Social" (the link's description)
    href: string;
  }[];
  /** The brand partners strip: its cue and the brands (ids in the brands collection), in order. */
  partners?: { cue: string; brands: string[] };
}

const { headline, body, items, partners } = Astro.props;

const { shown, awaiting, interim } = await getPartners(partners?.brands ?? []);
const full = (s: string) => (/[.!?]$/.test(s) ? s : `${s}.`);
// Stride Academy isn't open yet: its row says so, in its own page's words.
const soon = ((await getEntry('pages', 'education'))?.data.sections.soon?.lines ?? []).join(' ');
// The worlds behind the rows (desktop): real photographs already on the site.
const worlds: Record<Division, { src: string; alt: string }[]> = {
  social: [], // its photographs side by side, below
  talent: [],
  // Academy has no photography of its own yet: a licensed stock photograph of a creator's setup (a phone on a
  // tripod under a ring light), never presented as Stride's talent. Source and licence: docs/ASSET-SOURCES.md.
  education: [{ src: '/assets/site/academy-creator-setup.jpg', alt: '' }],
};
// Talent's world: the creators Stride Talent's own page features, through the roster's rules (consent, a photo).
const featured = (await getEntry('pages', 'talent'))?.data.sections.hero?.featured ?? [];
const roster = await getRoster();
const faces = featured
  .map((id) => roster.find((c) => c.id === id))
  .filter((c) => c?.data.portrait)
  .slice(0, 7)
  .map((c) => ({ src: c!.data.portrait!.src, alt: '' }));
// Social's world: the same photographs as behind /social's closing row, side by side in colour (the owner, 2026-11-18).
const socialPictures = await getSocialPictures();
---

<section class="sides on-photo" aria-labelledby="sides-title">
  {/* Where the Stride Group button lands (src/scripts/system/edge-nav.ts): this section filling the screen. */}
  <span class="sides__anchor" id="stride-group" aria-hidden="true"></span>
  <div class="sides__inner container-wide">
    <header class="sides__intro">
      {/* No reveal of their own: they come up with the scroll out of the hero's frost (home/HeroScene.astro, --sides-in). */}
      <h2 class="sides__title" id="sides-title">{headline}</h2>
      {body && <p class="sides__lede">{body}</p>}
    </header>

    {/* The giant rows (every screen; on phones and tablets the one in the middle of the screen stands open). */}
    <ol class="sides__rows" role="list" data-sides-rows>
      {items.map((item, i) => (
        <li class={`sides__row sides__row--${item.key}`} style={`--i: ${i}`}>
          <a class="sides__row-link" href={item.href} aria-label={`${item.cta}: ${full(item.audience)}`}>
            <span class="sides__world" aria-hidden="true">
              {worlds[item.key].map((w, k) => (
                <img src={w.src} alt={w.alt} sizes="100vw" loading="lazy" decoding="async" draggable="false" style={`--k: ${k}; --of: ${worlds[item.key].length}`} />
              ))}
              {item.key === 'social' && socialPictures.length > 0 && (
                <span class="sides__world-faces sides__world-faces--photos">
                  {socialPictures.map((f, k) => <img src={f.src} alt="" sizes="16vw" loading="lazy" decoding="async" draggable="false" style={`--k: ${k}${f.position ? `; object-position: ${f.position}` : ''}`} />)}
                </span>
              )}
              {item.key === 'talent' && faces.length > 0 && (
                <span class="sides__world-faces">
                  {faces.map((f, k) => <img src={f.src} alt={f.alt} sizes="16vw" loading="lazy" decoding="async" draggable="false" style={`--k: ${k}`} />)}
                </span>
              )}
            </span>
            <span class="sides__row-name"><span class="sides__row-stride">Stride</span> <span>{item.label}</span></span>
            <span class="sides__row-side">
              <span class="sides__row-audience">{full(item.audience)}</span>
              {item.copy && <span class="sides__row-copy">{item.copy}</span>}
              <span class="sides__row-actions">
                {item.key === 'education' && soon && <span class="sides__row-soon">{soon}</span>}
                <span class="sides__row-go">
                  {item.cta}
                  <svg viewBox="0 0 24 24"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
                </span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ol>

  </div>

  {partners && (
    <div class="sides__partners">
      <p class="sides__cue">
        <span>{partners.cue}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9.5 6 6 6-6"></path></svg>
      </p>
      <BrandTicker brands={shown} />
      {(interim || awaiting.length > 0) && (
        <div class="sides__notes container-wide">
          {interim && <PlaceholderNotice variant="inline" label="Interim logos">— from the previous site, awaiting approval (Q5)</PlaceholderNotice>}
          {awaiting.length > 0 && <PlaceholderNotice variant="inline" label="Logos needed">— {awaiting.join(', ')}: logo files and display approval</PlaceholderNotice>}
        </div>
      )}
    </div>
  )}
</section>

<script>
  import { desktop } from '@/scripts/system/env';
  // The rows' behaviour around the CSS that opens them: on desktop the pointer's row, on phones and tablets the row in
  // the middle of the screen (below).
  const rows = document.querySelector<HTMLElement>('[data-sides-rows]');
  if (rows) {
    const desk = desktop();
    const motion = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    const STEP = 110; // ms between the rows as they arrive
    const LANDS = 270 + 900; // ms from a row's start to its division's word landing
    const links = [...rows.querySelectorAll<HTMLAnchorElement>('.sides__row-link')];

    /* ---------- Arriving ----------
       As the rows come onto the screen (the owner, 2026-11-18: one smooth movement from the footage, not a wait once
       they're up): their lines draw in and their names rise (the CSS). Only if
       they start below the screen; a row can open once the last has landed (and the pointer moves). The keyboard
       doesn't wait. */
    if (motion && rows.getBoundingClientRect().top > window.innerHeight) {
      // Still too (below), so a row can't open while its name is still waiting under it.
      rows.classList.add('is-waiting', 'is-still');
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          rows.classList.replace('is-waiting', 'is-rising');
          window.setTimeout(() => {
            rows.classList.remove('is-rising');
            rows.classList.add('is-still');
          }, (links.length - 1) * STEP + LANDS + 60);
        },
        { rootMargin: '0px 0px -6% 0px' },
      );
      io.observe(rows);
      rows.addEventListener(
        'focusin',
        () => {
          io.disconnect();
          rows.classList.remove('is-waiting', 'is-rising');
        },
        { once: true },
      );
    }

    /* ---------- The keyboard: up and down (Home, End) move between the three rows ---------- */
    rows.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
      const i = links.indexOf(e.target as HTMLAnchorElement);
      if (i < 0) return;
      const moves: Record<string, number> = { ArrowDown: i + 1, ArrowUp: i - 1, Home: 0, End: links.length - 1 };
      const to = moves[e.key];
      if (to === undefined || !links[to]) return;
      e.preventDefault();
      links[to].focus();
    });

    if (desk) {
    /* ---------- The open row under the pointer ----------
       Its world opens from where the pointer came in (--px, --py, once), its photographs drift a little against the
       pointer (--dx, --dy) and its lines catch the light under it (--lx), each eased behind the pointer, in one loop
       that runs only while the pointer moves over an open row. Talent's face under the pointer develops (.is-lit),
       the faces' places re-read while their strip still slides. With reduced motion, only the faces. */
    type Aim = { row: HTMLElement; world: HTMLElement; photos: boolean; strip: HTMLElement | null; faces: HTMLElement[]; box: DOMRect; left: number; width: number; at: number };
    let aim: Aim | null = null;
    let ux = 0.5; // the pointer in the world, 0 to 1 each way
    let uy = 0.5;
    let dx = 0;
    let dy = 0;
    let lx = 50;
    let lit: HTMLElement | null = null;
    let raf = 0;
    let lastX = -1; // where the pointer last really moved to
    let lastY = -1;

    const light = (face: HTMLElement | null) => {
      if (face === lit) return;
      lit?.classList.remove('is-lit');
      face?.classList.add('is-lit');
      lit = face;
    };
    const place = (e: PointerEvent) => {
      if (!aim) return;
      ux = Math.min(1, Math.max(0, (e.clientX - aim.box.left) / aim.box.width));
      uy = Math.min(1, Math.max(0, (e.clientY - aim.box.top) / aim.box.height));
    };
    const frame = (now: number) => {
      raf = 0;
      if (!aim) return;
      let more = false;
      if (aim.strip && aim.faces.length) {
        const r = aim.strip.getBoundingClientRect();
        light(aim.faces[Math.floor(((lastX - r.left) / r.width) * aim.faces.length)] ?? null);
        more = now - aim.at < 2400;
      }
      if (motion) {
        const tx = (0.5 - ux) * 2.4; // %, against the pointer
        const ty = (0.5 - uy) * 4;
        const tl = ((lastX - aim.left) / aim.width) * 100;
        dx += (tx - dx) * 0.08;
        dy += (ty - dy) * 0.08;
        lx += (tl - lx) * 0.14;
        if (aim.photos) {
          aim.world.style.setProperty('--dx', `${dx.toFixed(3)}%`);
          aim.world.style.setProperty('--dy', `${dy.toFixed(3)}%`);
        }
        aim.row.style.setProperty('--lx', `${lx.toFixed(2)}%`);
        more ||= Math.abs(tx - dx) > 0.005 || Math.abs(ty - dy) > 0.005 || Math.abs(tl - lx) > 0.05;
      }
      if (more) raf = requestAnimationFrame(frame);
    };
    const wake = () => {
      if (!raf) raf = requestAnimationFrame(frame);
    };

    const enter = (row: HTMLElement, e: PointerEvent) => {
      const world = row.querySelector<HTMLElement>('.sides__world');
      if (!world) return;
      const r = row.getBoundingClientRect();
      const strip = world.querySelector<HTMLElement>('.sides__world-faces');
      aim = {
        row,
        world,
        photos: !!world.querySelector(':scope > img'),
        strip,
        faces: strip ? [...strip.querySelectorAll<HTMLElement>('img')] : [],
        box: world.getBoundingClientRect(),
        left: r.left,
        width: r.width,
        at: performance.now(),
      };
      place(e);
      if (!motion) return;
      world.style.setProperty('--px', `${(ux * 100).toFixed(1)}%`);
      world.style.setProperty('--py', `${(uy * 100).toFixed(1)}%`);
      dx = (0.5 - ux) * 2.4;
      dy = (0.5 - uy) * 4;
      lx = ((e.clientX - r.left) / r.width) * 100;
      if (aim.photos) {
        world.style.setProperty('--dx', `${dx.toFixed(3)}%`);
        world.style.setProperty('--dy', `${dy.toFixed(3)}%`);
      }
      row.style.setProperty('--lx', `${lx.toFixed(2)}%`);
    };
    const leave = () => {
      if (!aim) return;
      light(null);
      aim = null;
    };

    // Scrolling marks the rows still, so they don't open one after another as they pass under a pointer that isn't
    // moving; a real movement (not the page moving under it) frees them, and the row under it opens from there.
    window.addEventListener(
      'scroll',
      () => {
        rows.classList.add('is-still');
        leave();
      },
      { passive: true },
    );
    window.addEventListener(
      'pointermove',
      (e) => {
        if (Math.abs(e.clientX - lastX) + Math.abs(e.clientY - lastY) < 3) return;
        lastX = e.clientX;
        lastY = e.clientY;
        const arriving = rows.classList.contains('is-waiting') || rows.classList.contains('is-rising');
        const row = !arriving && e.target instanceof Element ? e.target.closest<HTMLElement>('.sides__row') : null;
        if (row !== aim?.row) {
          leave();
          if (row) enter(row, e);
        }
        if (!arriving) rows.classList.remove('is-still');
        if (!aim) return;
        place(e);
        wake();
      },
      { passive: true },
    );
    document.documentElement.addEventListener('pointerleave', leave);

    /* ---------- The keyboard's open row ----------
       Its world opens from the start of the name, still, and its lines' light sits under the name; Talent's faces
       develop one after another, and go back to black and white. */
    let wave: number[] = [];
    const calm = () => {
      wave.forEach((id) => window.clearTimeout(id));
      wave = [];
    };
    rows.addEventListener('focusin', (e) => {
      const link = e.target as HTMLElement;
      if (!motion || !link.matches('.sides__row-link:focus-visible')) return;
      const row = link.parentElement!;
      const world = row.querySelector<HTMLElement>('.sides__world');
      const name = row.querySelector<HTMLElement>('.sides__row-name');
      if (!world || !name) return;
      const r = row.getBoundingClientRect();
      const n = name.getBoundingClientRect();
      world.style.setProperty('--px', '12%');
      world.style.setProperty('--py', '50%');
      world.style.setProperty('--dx', '0%');
      world.style.setProperty('--dy', '0%');
      row.style.setProperty('--lx', `${(((n.left + n.width / 2 - r.left) / r.width) * 100).toFixed(1)}%`);
      calm();
      world.querySelectorAll<HTMLElement>('.sides__world-faces img').forEach((face, k) => {
        wave.push(
          window.setTimeout(() => face.classList.add('is-lit'), 200 + k * 140),
          window.setTimeout(() => face.classList.remove('is-lit'), 650 + k * 140),
        );
      });
    });
    rows.addEventListener('focusout', () => {
      calm();
      rows.querySelectorAll('.sides__world-faces .is-lit').forEach((face) => {
        if (face !== lit) face.classList.remove('is-lit');
      });
    });
    } else {
      /* ---------- Phones and tablets: the row in the middle of the screen ----------
         No pointer to open a row, so the one at the middle of the screen opens as the page scrolls (.is-open, with
         .is-auto: its CSS), read from where the screen's middle falls in the rows' fixed height (thirds), with a little
         give at each edge so it doesn't flicker; none while the rows are off the screen. Its world opens from the start
         of its name, as the keyboard's does on desktop, and Talent's faces develop one after another. A tap on a closed
         row opens it (and holds it a moment against the scroll); on the open one, the link goes there. */
      const list = [...rows.querySelectorAll<HTMLElement>('.sides__row')];
      const GIVE = 0.06; // of the rows' height: how far past its edge the open row holds
      let open = -1;
      let heldAt: number | null = null; // the scroll position a tap opened a row at
      let waves: number[] = [];
      rows.classList.add('is-auto', 'is-still');
      const develop = (row: HTMLElement) => {
        waves.forEach((id) => window.clearTimeout(id));
        waves = [];
        const world = row.querySelector<HTMLElement>('.sides__world');
        const name = row.querySelector<HTMLElement>('.sides__row-name');
        if (!world || !name) return;
        const r = row.getBoundingClientRect();
        const n = name.getBoundingClientRect();
        world.style.setProperty('--px', '12%');
        world.style.setProperty('--py', '50%');
        row.style.setProperty('--lx', `${(((n.left + n.width / 2 - r.left) / r.width) * 100).toFixed(1)}%`);
        if (!motion) return;
        world.querySelectorAll<HTMLElement>('.sides__world-faces img').forEach((face, k) => {
          waves.push(
            window.setTimeout(() => face.classList.add('is-lit'), 260 + k * 160),
            window.setTimeout(() => face.classList.remove('is-lit'), 900 + k * 160),
          );
        });
      };
      const openRow = (i: number) => {
        if (i === open) return;
        open = i;
        list.forEach((row, k) => row.classList.toggle('is-open', k === i));
        if (i >= 0) develop(list[i]);
      };
      const pick = () => {
        if (heldAt !== null) {
          if (Math.abs(window.scrollY - heldAt) < 48) return;
          heldAt = null;
        }
        const box = rows.getBoundingClientRect();
        const mid = window.innerHeight / 2;
        if (box.bottom < window.innerHeight * 0.3 || box.top > window.innerHeight * 0.7) return openRow(-1);
        const f = (mid - box.top) / box.height;
        let i = Math.min(list.length - 1, Math.max(0, Math.floor(f * list.length)));
        if (open >= 0 && i !== open && f > open / list.length - GIVE && f < (open + 1) / list.length + GIVE) i = open;
        openRow(i);
      };
      let queued = false;
      window.addEventListener(
        'scroll',
        () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            pick();
          });
        },
        { passive: true },
      );
      window.addEventListener('resize', pick, { passive: true });
      // Once the rows have arrived (their classes change), the middle one opens without waiting for the next scroll.
      new MutationObserver(pick).observe(rows, { attributes: true, attributeFilter: ['class'] });
      pick();
      links.forEach((link, k) =>
        link.addEventListener('click', (e) => {
          if (k === open || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          e.preventDefault();
          heldAt = window.scrollY;
          openRow(k);
        }),
      );
    }

    /* ---------- The brand ticker: resting while off the screen ----------
       (Its eased stop while pointed at is core/BrandTicker.astro's own.) */
    const ticker = document.querySelector<HTMLElement>('.sides__partners .brand-ticker');
    if (motion && ticker) {
      const tracks = () => [...ticker.querySelectorAll('.brand-ticker__track')].flatMap((t) => t.getAnimations());
      new IntersectionObserver(([entry]) => tracks().forEach((a) => (entry.isIntersecting ? a.play() : a.pause()))).observe(ticker);
    }
  }
</script>

<style>
  .sides {
    position: relative;
    padding-block: clamp(80px, 9vw, 150px) clamp(56px, 6vw, 96px);
    color: rgb(var(--ink));
    /* On its own (tablet, phone): deep navy lit softly from two corners. */
    background:
      radial-gradient(60% 55% at 12% 18%, rgb(41 67 104 / 0.5), transparent 70%),
      radial-gradient(55% 50% at 88% 78%, rgb(var(--ice-rgb) / 0.07), transparent 70%),
      linear-gradient(180deg, var(--navy-700), var(--navy-900));
  }

  /* ---------- Desktop: the giant rows ----------
     Three rows sharing a fixed height: pointed at, one takes most of it (flex-grow) while the others close up,
     their names shrinking and dimming, so nothing below moves. Its world comes up behind it: the photograph(s)
     opening from where the pointer came in and settling, under a navy that's deepest behind the name. The height
     follows the screen's (in rem, so past 1920×1080 the rows keep their proportions, tokens.css), never under
     27.5rem: on a short laptop each row stays tall enough for who it is for to sit clear above the name. */
  .sides__rows {
    --rows: clamp(27.5rem, 64vh, 45rem);
    /* An open row's height (2.5 of 3.7 shares): each world is this tall, so a row opening only uncovers it and
       nothing inside it is resized. */
    --open-h: calc(var(--rows) * 0.676);
    position: relative;
    display: flex;
    flex-direction: column;
    height: var(--rows);
    margin-top: var(--space-6);
    border-top: 1px solid transparent;
  }

  .sides__row {
    position: relative;
    flex: 1 1 0;
    min-height: 0;
    border-bottom: 1px solid transparent;
    transition:
      flex-grow 720ms var(--ease-out),
      --sides-lit 300ms var(--ease-out);
  }

  /* The hairlines, drawn over the rows' transparent borders (the same pixels), so they can draw in as the rows
     arrive, and the open row's two lines catch the light under the pointer (--lx, eased behind it; --sides-lit). */
  .sides__rows::before,
  .sides__row::before,
  .sides__row::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    z-index: 1;
    height: 1px;
    transform-origin: 0 50%;
    pointer-events: none;
  }

  .sides__rows::before {
    top: -1px;
    background: rgb(var(--hair) / 0.22);
  }

  .sides__row::before,
  .sides__row::after {
    --light: linear-gradient(
      90deg,
      transparent calc(var(--lx, 50%) - 18vw),
      rgb(var(--tone-lit) / calc(0.9 * var(--sides-lit))) var(--lx, 50%),
      transparent calc(var(--lx, 50%) + 18vw)
    );
  }

  .sides__row::before {
    top: -1px;
    background: var(--light);
  }

  .sides__row::after {
    bottom: -1px;
    background: var(--light), rgb(var(--hair) / 0.22);
  }

  /* A row opens when pointed at, but only once the pointer has moved, never as the page scrolls under a still one
     (.is-still); or when it has the keyboard's focus (not a click's). Not while the rows are arriving (.is-rising). */
  .sides__rows:not(.is-still, .is-rising):hover .sides__row,
  .sides__rows:not(.is-rising):has(.sides__row-link:focus-visible) .sides__row {
    flex-grow: 0.6;
  }

  .sides__rows:not(.is-still, .is-rising) .sides__row:hover,
  .sides__rows:not(.is-rising) .sides__row:has(> .sides__row-link:focus-visible) {
    flex-grow: 2.5;
  }

  .sides__row-link {
    --pad: clamp(0.75rem, 1.6vw, 1.75rem);
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding-inline: var(--pad);
    overflow: hidden;
    isolation: isolate;
    /* Each frame of a row opening is laid out and painted inside the row only. */
    contain: layout paint;
    color: rgb(var(--ink));
  }

  .sides__row-link:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: -2px;
  }

