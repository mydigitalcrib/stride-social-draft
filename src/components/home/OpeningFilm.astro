---
// The homepage's opening, before the hero (inside home/CoverHero.astro), once per visit, on every screen (phones and
// tablets too since 2026-11-13, the owner: the same film, its notifications across the top of a phone's screen):
//   1. The gate: the Stride lockup builds (home/IntroReveal.astro), in navy, over the showreel itself, playing in Stride's
//      blue (a monochrome of it, tinted, palest at the edges, drifting slowly closer and back; the owner, 2026-11-17: the
//      first image's blue, `--ice`, in place of the navy; 2026-11-18: "less white", the ice deepened towards `--steel`), and "Enter", one big word in Stride's wide type rather than a
//      button (the owner, 2026-11-17: the capsule read as a tech company's), appears as the line along the foot completes. What waits behind the door, seen through the brand's colour (the
//      owner, 2026-11-12: the blurred still frame before it read as nothing). The same file as the hero's, so it's
//      ready when the door opens. Pointing at "Enter" (or the keyboard's focus on it) lifts the veil a little.
//   2. Entering is one shot: the rest of the lockup wipes away and the gate goes to navy around the mark, which
//      travels to the centre and grows to the size the hero's entrance draws it at; the entrance
//      (src/scripts/system/hero-entrance.ts) takes it from there, breaking it into the triangles that build the headline.
//   (Its message notifications after the headline were removed, the owner, 2026-11-17.)
// Escape skips it all. Returning visits and reduced motion go straight to the hero, as before. On a phone or tablet the film
// is the hero's own upright reel (core/Media's `mobile`), so it's ready when the door opens there too. The
// words are drafts (src/content/pages/interactions.yaml). Sizes are in rem, so past 1920×1080 it keeps its proportions (tokens.css).
// Behaviour: src/scripts/system/opening.ts.
import IntroReveal from './IntroReveal.astro';
import { interfaceCopy } from '@/lib/ui-copy';

export interface Props {
  words: { label: string; division?: 'social' | 'talent' | 'education' }[];
  reel: { poster: string; mp4?: string; webm?: string; mobile?: { poster: string; mp4: string; webm?: string } };
}

const { words, reel } = Astro.props;
const t = await interfaceCopy();
---

<div class="opening" role="region" aria-label={t('opening.label')} data-opening>
  <div class="opening__gate" data-opening-gate>
    <div class="opening__backdrop" aria-hidden="true">
      <video muted autoplay loop playsinline preload="auto" poster={reel.poster} tabindex="-1">
        {/* Phones and tablets: the hero's upright reel (the same file it plays there). */}
        {reel.mobile?.webm && <source src={reel.mobile.webm} type="video/webm" media="(max-width: 1023px)" />}
        {reel.mobile && <source src={reel.mobile.mp4} type="video/mp4" media="(max-width: 1023px)" />}
        {reel.webm && <source src={reel.webm} type="video/webm" />}
        {reel.mp4 && <source src={reel.mp4} type="video/mp4" />}
      </video>
    </div>
    <div class="opening__lockup">
      <IntroReveal words={words} />
    </div>
    <div class="opening__enter">
      <button class="opening__button" type="button" data-opening-enter>
        {t('opening.enter')}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
      </button>
    </div>
  </div>
</div>
{/* Straight to the end of the page, before anything is drawn: in the hero it would sit under the header. */}
<script is:inline>
  (() => {
    const opening = document.querySelector('[data-opening]');
    if (opening) document.body.append(opening);
  })();
</script>

<style>
  /* Only while the opening plays (the hero's inline script adds html.opening-on, before the first paint). */
  .opening {
    display: none;
  }

  :global(html.opening-on) .opening {
    position: fixed;
    inset: 0;
    z-index: 160; /* over the header, under the consent banner (z 200), like the hero's intro */
    display: block;
    overflow: hidden;
    background: var(--navy-900);
    color: var(--white);
    /* Leaving, it fades evenly (an ease-out dropped most of it in the first frames, so the hero seemed to jump in). */
    transition: opacity 700ms var(--ease-in-out);
  }

  .opening.is-leaving {
    opacity: 0;
    pointer-events: none;
  }

  /* ---------- The gate ---------- */
  /* The film's blue (the owner, 2026-11-18: "less white", the ice read as white): Stride's ice deepened towards its
     steel, from the palette, so the navy lockup still stands out clearly on it. */
  .opening {
    --opening-tint: color-mix(in srgb, var(--ice) 52%, var(--steel));
    /* The lockup's navy, lighter (the owner, 2026-11-23: "make the navy blue look more like light navy blue"; it was the
       darkest navy, #06142b, which read as black): between the palette's two middle navies. */
    --opening-ink: color-mix(in srgb, var(--navy-700) 45%, var(--navy-500));
  }

  .opening__gate {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--opening-tint);
    transition:
      opacity 600ms var(--ease-out),
      background-color 600ms var(--ease-out);
  }

  .opening.is-black .opening__gate {
    opacity: 0;
  }

  /* The showreel in Stride's blue (the owner, 2026-11-17: in place of the navy; 2026-11-18 less white): in monochrome,
     tinted (`color` keeps its light and shade, takes the hue), palest at the edges so the lockup stands in a pool of
     the footage, the veil over it thinner so more of the footage shows, and
     drifting slowly closer and back, so however long the gate waits it never comes to a stop. */
  .opening__backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    isolation: isolate;
    background: var(--opening-tint);
  }

  .opening__backdrop video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05) brightness(1) blur(0.1875rem);
    scale: 1.04;
    animation: opening-drift 40s var(--ease-in-out) infinite alternate both;
    transition: filter 900ms var(--ease-out);
  }

  .opening__backdrop::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--opening-tint);
    mix-blend-mode: color;
  }

  .opening__backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      radial-gradient(62% 58% at 50% 48%, color-mix(in srgb, var(--opening-tint) 34%, transparent), color-mix(in srgb, var(--opening-tint) 58%, transparent) 68%, color-mix(in srgb, var(--opening-tint) 82%, transparent) 100%),
      linear-gradient(color-mix(in srgb, var(--opening-tint) 12%, transparent), color-mix(in srgb, var(--opening-tint) 12%, transparent));
    transition: scale 900ms var(--ease-out);
  }

  @keyframes opening-drift {
    from {
      scale: 1.04;
    }
    to {
      scale: 1.14;
    }
  }

  /* Pointed at (or the keyboard's focus on it, opening.ts's .is-keyed), the button lifts the veil a little: the
     footage brightens and sharpens and the pool of light widens, as if the door were opening. */
  .opening:has(.opening__button:hover) .opening__backdrop video,
  .opening.is-keyed:has(.opening__button:focus-visible) .opening__backdrop video {
    filter: grayscale(1) contrast(1.05) brightness(1.1) blur(0.09375rem);
  }

  .opening:has(.opening__button:hover) .opening__backdrop::after,
  .opening.is-keyed:has(.opening__button:focus-visible) .opening__backdrop::after {
    scale: 1.08;
  }

  /* The hero's grain over the gate too, so the two match. */
  .opening__gate::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grain) 0 0 / var(--grain-size) var(--grain-size);
    opacity: var(--grain-opacity);
    mix-blend-mode: overlay;
    pointer-events: none;
    animation: grain-shift 1s steps(1, end) infinite;
  }

  /* The lockup centres itself in the whole screen, as it does in the hero's intro; past 1920×1080 it keeps its share
     of the screen (in rem: the same up to it). Its line along the foot completes as the button appears (BUTTON_AT,
     opening.ts), so it never reads as still loading. */
  .opening__lockup {
    position: absolute;
    inset: 0;
  }

  /* On the ice, the lockup is a light navy (--opening-ink; the owner's darker sample, #06142b, 2026-11-17, until
     2026-11-23): its words, the divisions' names (their own colours don't read on it) and the line along the foot,
     standing over the grain so the navy stays exactly itself, as does the button's. Entering, the mark turns white as
     the gate goes to navy (below). */
  .opening :global(.reveal) {
    color: var(--opening-ink);
  }

  .opening__lockup,
  .opening__enter {
    z-index: 1;
  }

  .opening :global(.reveal__label) {
    color: inherit;
  }

  .opening :global(.reveal__progress) {
    background: color-mix(in srgb, var(--opening-ink) 14%, transparent);
  }

  .opening :global(.reveal__progress-bar) {
    background: var(--opening-ink);
  }

  @media (min-width: 1024px) {
    .opening :global(.reveal__lockup) {
      font-size: clamp(22px, min(8vw, 12vh, 4vw + 1.875rem), 6.875rem);
    }
  }

  .opening :global(.is-intro-run .reveal__progress-bar) {
    animation-duration: 2.2s;
  }

  .opening__enter {
    position: absolute;
    bottom: 16vh;
    left: 50%;
    opacity: 0;
    translate: -50% 0.875rem;
    transition:
      opacity 600ms var(--ease-out),
      translate 700ms var(--ease-out);
    pointer-events: none;
  }

  .opening.is-ready .opening__enter {
    opacity: 1;
    translate: -50% 0;
    pointer-events: auto;
  }

  /* "Enter": one big word in Stride's own wide type, navy, with an arrow, no box (the owner, 2026-11-17, the fourth of
     five options: the glass capsule read as a tech company's, and Stride is an advertising company). Pointed at or
     focused from the keyboard, the arrow moves on (no box round it). In rem on desktop, so it keeps its share of a
     larger screen. */
  .opening__button {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.25em 0.375em;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--opening-ink);
    white-space: nowrap;
  }

  /* No box round the word, ever (the owner, 2026-11-17: "without the lines"): focused from the keyboard, it shows
     as pointing at it does, the arrow moving on and the footage brightening behind it. */
  .opening__button:focus-visible {
    outline: none;
  }

  .opening__button svg {
    width: 1.1em;
    height: 1.1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 360ms var(--spring-soft, var(--ease-out));
  }

  .opening__button:hover svg,
  .opening.is-keyed .opening__button:focus-visible svg {
    translate: 0.25em 0;
  }

  /* Phones and tablets: a little smaller, on the screen's own 16px root. */
  @media (max-width: 1023px) {
    .opening__button {
      font-size: 1.75rem;
    }
  }

  /* ---------- Entering (opening.ts, .is-handing) ----------
     The rest of the lockup wipes away to the right, the button fades, the gate goes to navy around the mark, and the
     mark travels to where the hero's entrance draws its own, at its size there (--hand-x, --hand-y, --hand-s, measured
     on the click): the entrance takes it from there. */
  /* The ice and its footage go together, in step with the mark's journey, onto the film's navy (not black: ice
     fading over black passed through a muddy grey, and the navy lockup sinks into the navy as it goes). */
  .opening.is-handing .opening__gate {
    background-color: transparent;
    transition: background-color 420ms var(--ease-in-out);
  }

  .opening.is-handing .opening__backdrop,
  .opening.is-handing .opening__gate::after {
    opacity: 0;
    transition: opacity 420ms var(--ease-in-out);
  }

  .opening.is-handing .opening__enter {
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms var(--ease-out);
  }

  .opening.is-handing :global(.reveal__word) {
    animation: opening-wipe 300ms cubic-bezier(0.55, 0, 1, 0.45) both;
  }

  .opening.is-handing :global(.reveal__divider) {
    transform: none;
    animation: opening-wipe 300ms cubic-bezier(0.55, 0, 1, 0.45) 40ms both;
  }

  .opening.is-handing :global(.reveal__slot) {
    animation: opening-wipe 300ms cubic-bezier(0.55, 0, 1, 0.45) 80ms both;
  }

  .opening.is-handing :global(.reveal__progress) {
    opacity: 0;
    transition: opacity 200ms var(--ease-out);
  }

  .opening.is-handing :global(.reveal__mark) {
    translate: var(--hand-x) var(--hand-y);
    scale: var(--hand-s);
    color: var(--white);
    transition:
      translate 380ms var(--ease-in-out),
      scale 380ms var(--ease-in-out),
      color 360ms var(--ease-out);
  }

  @keyframes opening-wipe {
    from {
      clip-path: inset(0 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 100%);
    }
  }

</style>

<script>
  import { initOpening } from '@/scripts/system/opening';
  initOpening();
</script>
