      inset: 0;
      background:
        radial-gradient(circle at calc(var(--holo-x) * 1%) calc(var(--holo-y) * 1%), rgb(var(--white-rgb) / 0.7), transparent 42%),
        linear-gradient(
          115deg,
          transparent calc(var(--holo-x) * 1% - 46%),
          rgb(255 110 199 / 0.65) calc(var(--holo-x) * 1% - 22%),
          rgb(110 214 255 / 0.7) calc(var(--holo-x) * 1%),
          rgb(255 236 128 / 0.65) calc(var(--holo-x) * 1% + 22%),
          transparent calc(var(--holo-x) * 1% + 46%)
        );
      -webkit-mask: var(--src) center / contain no-repeat;
      mask: var(--src) center / contain no-repeat;
