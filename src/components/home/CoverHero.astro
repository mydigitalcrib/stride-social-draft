    .cover__word .cover__char > span {
      position: relative;
      text-shadow:
        calc(var(--ex, 0.5) * 0.075rem) calc(var(--ey, 0.7) * 0.075rem) 0 rgb(214 225 238),
        calc(var(--ex, 0.5) * 0.15rem) calc(var(--ey, 0.7) * 0.15rem) 0 rgb(194 208 226),
        calc(var(--ex, 0.5) * 0.225rem) calc(var(--ey, 0.7) * 0.225rem) 0 rgb(173 190 213),
        calc(var(--ex, 0.5) * 0.3rem) calc(var(--ey, 0.7) * 0.3rem) 0 rgb(151 171 199),
        calc(var(--ex, 0.5) * 0.375rem) calc(var(--ey, 0.7) * 0.375rem) 0 rgb(129 152 184),
        calc(var(--ex, 0.5) * 0.45rem) calc(var(--ey, 0.7) * 0.45rem) 0 rgb(108 132 168),
        calc(var(--ex, 0.5) * 0.525rem) calc(var(--ey, 0.7) * 0.525rem) 0 rgb(88 113 151),
        calc(var(--ex, 0.5) * 0.6rem) calc(var(--ey, 0.7) * 0.6rem) 0 rgb(70 95 133),
        calc(var(--ex, 0.5) * 0.675rem) calc(var(--ey, 0.7) * 0.675rem) 0 rgb(54 78 115),
        calc(var(--ex, 0.5) * 0.75rem) calc(var(--ey, 0.7) * 0.75rem) 0 rgb(40 62 97),
