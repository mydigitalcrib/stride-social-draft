    /* ---------- The word as a door (scrolling on) ----------
       The copy of the word in the navy overlay (its letters white, so with `multiply` the footage shows only
       through them): it comes in as the real word goes (--swap), grows from inside one letter (--door-scale,
       about --ox --oy), and the navy clears at the end (--door-show). Meanwhile the kicker and the band go
       (--door-band). Only while the scene runs it (.has-door). */
    .cover__door {
      position: absolute;
      inset: 0;
      display: block;
