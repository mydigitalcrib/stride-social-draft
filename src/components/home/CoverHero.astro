        calc(var(--ex, 0.5) * 0.0129em) calc(var(--ey, 0.7) * 0.0129em) 0 rgb(173 190 213),
        calc(var(--ex, 0.5) * 0.0171em) calc(var(--ey, 0.7) * 0.0171em) 0 rgb(151 171 199),
        calc(var(--ex, 0.5) * 0.0214em) calc(var(--ey, 0.7) * 0.0214em) 0 rgb(129 152 184),
        calc(var(--ex, 0.5) * 0.0257em) calc(var(--ey, 0.7) * 0.0257em) 0 rgb(108 132 168),
        calc(var(--ex, 0.5) * 0.03em) calc(var(--ey, 0.7) * 0.03em) 0 rgb(88 113 151),
        calc(var(--ex, 0.5) * 0.0343em) calc(var(--ey, 0.7) * 0.0343em) 0 rgb(70 95 133),
        calc(var(--ex, 0.5) * 0.0386em) calc(var(--ey, 0.7) * 0.0386em) 0 rgb(54 78 115),
