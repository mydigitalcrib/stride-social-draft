---
// A creator's profile opened over the page, without leaving it (desktop; the owner's choice, 2026-11-12): from a name in
// "Meet our talent." on /talent, or a name on the roster. Their photo grows from where it was into a press print on the
// left; on the right who they are (signed or partner, name, handle, niche and country, their line, a follower figure
// only when verified, their platforms) and the ways on: Enquire about them, + Shortlist, the full profile. The creator
// before and after peek in at the screen's edges, the arrow keys move between them, Escape or the veil closes it.
// Everything in it is read off the creator's own card on the page (talent/CreatorCard.astro), so it shows exactly what
// the roster's rules let the card show. Behaviour: src/scripts/system/creator-sheet.ts. One per page.
// The print is held, not pinned: it leans towards the pointer with a gloss crossing it, and it can be flicked aside
// (a drag, or a sideways swipe on a trackpad) to the creator before or after, whose photo develops as it comes in.
// While it's open the page behind waits (`sheet:open`, `sheet:close`) and the keyboard stays in it.
import { interfaceCopy } from '@/lib/ui-copy';
import type { SheetEntry } from '@/scripts/system/creator-sheet';

export interface Props {
  /** Profiles for creators the page shows without a card (the photocall's), built by the roster's rules. */
  data?: SheetEntry[];
}

const { data = [] } = Astro.props;
const t = await interfaceCopy();
// As JSON in the page, with nothing in it that could close the script.
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<div class="csheet" role="dialog" aria-modal="true" aria-labelledby="csheet-name" hidden data-csheet data-lenis-prevent>
  {data.length > 0 && <script type="application/json" data-csheet-data set:html={json} />}
  <div class="csheet__veil" data-csheet-close></div>

  <button class="csheet__edge csheet__edge--prev" type="button" aria-label={t('sheet.prev')} data-csheet-prev>
    <img alt="" decoding="async" draggable="false" />
  </button>
  <button class="csheet__edge csheet__edge--next" type="button" aria-label={t('sheet.next')} data-csheet-next>
    <img alt="" decoding="async" draggable="false" />
  </button>

  <div class="csheet__body">
    <div class="csheet__hand" data-csheet-hand>
      <figure class="csheet__print" data-csheet-print>
        <span class="csheet__paper" aria-hidden="true" data-csheet-paper></span>
        <span class="csheet__photo" data-csheet-photo>
          <img alt="" decoding="async" draggable="false" data-csheet-img />
          <video muted loop playsinline preload="none" hidden data-csheet-video></video>
          <span class="csheet__gloss" aria-hidden="true" data-csheet-gloss></span>
        </span>
        <figcaption data-csheet-caption></figcaption>
      </figure>
    </div>

    <div class="csheet__text" data-csheet-text>
      <p class="csheet__top"><span class="csheet__tag exp-label" data-csheet-tag></span><span class="csheet__count exp-label" data-csheet-count></span></p>
      <h2 class="csheet__name" id="csheet-name" data-csheet-name></h2>
      <p class="csheet__handle" data-csheet-handle></p>
      <p class="csheet__details exp-label" data-csheet-details></p>
      <p class="csheet__line" data-csheet-line></p>
      <p class="csheet__figure" data-csheet-figure></p>
      <ul class="csheet__platforms" role="list" data-csheet-platforms></ul>
      <div class="csheet__actions">
        <a class="exp-pill" href="/talent/enquire" data-csheet-enquire>
          <span data-csheet-enquire-label>{t('card.enquireAbout')}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
        </a>
        <a class="csheet__more" href="/talent" data-csheet-profile>
          {t('sheet.profile')}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
        </a>
      </div>
    </div>
  </div>

  <button class="csheet__close" type="button" aria-label={t('sheet.close')} data-csheet-close>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
  </button>
</div>

<style>
  .csheet {
    position: fixed;
    inset: 0;
    z-index: 110;
    display: grid;
    place-items: center;
    color: rgb(var(--ink));
    overscroll-behavior: contain;
  }

  .csheet[hidden] {
    display: none;
  }

  .csheet__veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 80% at 40% 50%, rgb(26 48 86 / 0.7), rgb(6 14 30 / 0.92)),
      rgb(6 14 30 / 0.5);
    backdrop-filter: blur(0.875rem) saturate(1.2);
    -webkit-backdrop-filter: blur(0.875rem) saturate(1.2);
  }

  /* The print's column and the words' beside it. It keeps clear only of the neighbours' prints at the screen's edges
     (42% of each shows), not of the page's margins: it's over the page, so on a laptop the words keep their room. */
  .csheet__body {
    position: relative;
    display: grid;
    grid-template-columns: min(30vw, 26.25rem) minmax(0, 34rem);
    align-items: center;
    gap: clamp(2.25rem, 5vw, 5rem);
    max-width: calc(100vw - 2 * (0.42 * clamp(8.75rem, 13vw, 12.5rem) + 2rem));
    perspective: 75rem;
  }

  /* The hand that holds the print: it leans towards the pointer (creator-sheet.ts). */
  .csheet__hand {
    position: relative;
    touch-action: pan-y;
  }

  /* The press print: the photo grows from where it was into it. Its paper is a layer of its own, so the photo can grow
     alone and the paper come up around it. */
  .csheet__print {
    position: relative;
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0.75rem 0.75rem 1rem;
    color: var(--navy-900);
    rotate: -1.5deg;
    transform-origin: 0 0;
  }

  .csheet__paper {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 0.25rem;
    background: linear-gradient(180deg, #f6f8fa, #e5eaef);
    box-shadow: 0 3.125rem 5.625rem -2.5rem rgb(0 0 0 / 0.95);
  }

  /* A gloss on the print's surface, catching the light as it leans (0 when it's still). */
  .csheet__gloss {
    position: absolute;
    inset: -30%;
    z-index: 1;
    background: linear-gradient(105deg, rgb(var(--white-rgb) / 0) 34%, rgb(var(--white-rgb) / 0.18) 50%, rgb(var(--white-rgb) / 0) 66%);
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
  }

  .csheet__photo {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #10182a;
  }

  .csheet__photo img,
  .csheet__photo video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }

  .csheet__print figcaption {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(16 24 42 / 0.75);
  }

  .csheet__text {
    display: grid;
    justify-items: start;
    gap: 0.625rem;
  }

  .csheet__top {
    display: flex;
    gap: 0.875rem;
  }

  .csheet__tag {
    color: rgb(var(--tone-lit));
  }

  .csheet__count {
    color: rgb(var(--ink) / 0.6);
  }

  .csheet__count:empty {
    display: none;
  }

  .csheet__name {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4.4vw, 4.75rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.92;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .csheet__handle {
    font-size: 1.125rem;
    color: rgb(var(--ink) / 0.86);
  }

  .csheet__details {
    color: rgb(var(--ink) / 0.7);
  }

  .csheet__line {
    max-width: 32rem;
    margin-top: 0.375rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: rgb(var(--ink) / 0.9);
  }

  .csheet__figure {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 800;
    color: rgb(var(--tone-lit));
  }

  .csheet__handle:empty,
  .csheet__details:empty,
  .csheet__line:empty,
  .csheet__figure:empty,
  .csheet__tag:empty,
  .csheet__platforms:empty {
    display: none;
  }

  .csheet__platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .csheet__platforms :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 2.125rem;
    padding: 0 0.875rem;
    border-radius: 999px;
    background: rgb(var(--white-rgb) / 0.08);
    box-shadow: inset 0 0 0 1px rgb(var(--white-rgb) / 0.28);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background-color 200ms var(--ease-out);
  }

  .csheet__platforms :global(a:hover) {
    background: rgb(var(--white-rgb) / 0.16);
  }

  .csheet__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 0.875rem;
    margin-top: 0.875rem;
  }

  .csheet__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--ink) / 0.8);
  }

  .csheet__more svg,
  .csheet__close svg {
    width: 0.9375rem;
    height: 0.9375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .csheet__more:hover {
    color: rgb(var(--ink));
  }

  /* The creators before and after, half in view at the edges. */
  .csheet__edge {
    position: absolute;
    top: 50%;
    z-index: 1;
    width: clamp(8.75rem, 13vw, 12.5rem);
    padding: 0.4375rem 0.4375rem 1.25rem;
    border-radius: 0.1875rem;
    background: linear-gradient(180deg, #e9edf1, #cfd7df);
    box-shadow: 0 1.875rem 3.125rem -1.5rem rgb(0 0 0 / 0.9);
    opacity: 0.5;
    transition:
      opacity 260ms var(--ease-out),
      translate 360ms var(--ease-out);
  }

  .csheet__edge img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 25%;
    filter: grayscale(1);
  }

  .csheet__edge--prev {
    left: 0;
    translate: -58% -50%;
    rotate: 4deg;
  }

  .csheet__edge--next {
    right: 0;
    translate: 58% -50%;
    rotate: -4deg;
  }

  .csheet__edge:hover,
  .csheet__edge:focus-visible {
    opacity: 0.9;
  }

  .csheet__edge--prev:hover {
    translate: -46% -50%;
  }

  .csheet__edge--next:hover {
    translate: 46% -50%;
  }

  /* A print being flicked: the neighbour it's heading for follows the hand, without lagging behind it. */
  .csheet.is-dragging .csheet__edge {
    transition: opacity 260ms var(--ease-out);
  }

  .csheet__edge[hidden] {
    display: none;
  }

  .csheet__close {
    position: absolute;
    top: calc(var(--header-h) / 2 - 1.125rem);
    right: var(--margin);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: linear-gradient(135deg, rgb(var(--white-rgb) / 0.2), rgb(var(--white-rgb) / 0.06));
    box-shadow: inset 0 0 0 1px rgb(var(--white-rgb) / 0.36);
    color: rgb(var(--ink));
    backdrop-filter: blur(0.75rem);
    -webkit-backdrop-filter: blur(0.75rem);
  }

  .csheet__close:focus-visible,
  .csheet__edge:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 3px;
  }

  /* ---------- Phones and tablets: the same profile over the page (the owner, 2026-11-13) ----------
     A phone takes it in one column that scrolls: the press print, then the words; the creators before and after peek
     in at the screen's edges (a flick of the print, or a tap on one, goes to them); the close button stays at the
     top. A tablet keeps the print and the words side by side. */
  @media (max-width: 1023px) {
    .csheet {
      place-items: start center;
      overflow-y: auto;
      padding: calc(var(--header-h) + 0.5rem) var(--margin) 2.5rem;
    }

    .csheet__veil {
      position: fixed;
    }

    .csheet__body {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: var(--space-5);
      width: min(34rem, 100%);
      max-width: none;
    }

    .csheet__hand {
      width: min(64vw, 17rem);
    }

    .csheet__text {
      width: 100%;
    }

    .csheet__name {
      font-size: clamp(2rem, 11vw, 3rem);
    }

    .csheet__line {
      font-size: 1rem;
    }

    .csheet__edge {
      position: fixed;
      top: 34%;
      width: 4.75rem;
      padding: 0.25rem 0.25rem 0.75rem;
    }

    .csheet__edge--prev {
      translate: -60% -50%;
    }

    .csheet__edge--next {
      translate: 60% -50%;
    }

    .csheet__close {
      position: fixed;
      top: max(0.75rem, env(safe-area-inset-top));
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .csheet {
      place-items: center;
    }

    .csheet__body {
      grid-template-columns: min(36vw, 20rem) minmax(0, 1fr);
      align-items: center;
      justify-items: stretch;
      width: min(52rem, calc(100vw - 2 * var(--margin) - 4rem));
    }

    .csheet__hand {
      width: auto;
    }
  }
</style>

<script>
  import { initCreatorSheet } from '@/scripts/system/creator-sheet';
  initCreatorSheet();
</script>
