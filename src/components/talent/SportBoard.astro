---
// Stride Sport's LED board (every screen; a tap does what a click does): along the foot of the hero, in front of the stadium, a perimeter board running its
// athletes' names and what they do, in lit dots, as the boards round a pitch do. It runs on its own; under the pointer it
// slows to a stop, the name pointed at lights up, and a click blinks it twice and opens that athlete's profile over the
// page (creator-sheet.ts, `creators:open`), growing from that spot on the board. The dots are the panel's own and stay
// put while the names crawl through them, as on a real board. On the page's first opening it powers up column by
// column once the floodlights are on (html.spec-cue, SpecialistPage.astro), then gathers speed. Still under reduced
// motion, where pointing and clicking still work. The names are the roster's (its rules: consent, a photo); the board
// is a picture of them (the contact sheet below is the list). Sizes in rem, so it grows with a large screen as its
// names do. Behaviour: sport-board.ts.
import type { CreatorView } from '@/lib/creator-view';

export interface Props {
  athletes: CreatorView[];
  /** Where a creator's own page is (routes.creator, without the id): for a screen without the profile over the page. */
  profile?: string;
}

const { athletes, profile } = Astro.props;
const ids = athletes.map((a) => a.id).join(' ');
---

<div class="board" aria-hidden="true" data-sport-board data-ids={ids} data-profile={profile} style={`--n: ${athletes.length}`}>
  <div class="board__panel">
    <div class="board__dots">
      <div class="board__track" data-board-track>
        {[0, 1].map(() => (
          <span class="board__run">
            {athletes.map((a, i) => (
              <span class="board__item" data-board-item={i} data-press>
                <b>{a.name}</b>{a.niche && <span>{a.niche}</span>}
                <i class="board__mark"></i>
              </span>
            ))}
          </span>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .board {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    height: 3.875rem;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgb(var(--white-rgb) / 0.06), transparent 30%, rgb(0 0 0 / 0.35)),
      rgb(3 9 20 / 0.86);
    box-shadow:
      inset 0 1px 0 rgb(var(--white-rgb) / 0.14),
      inset 0 -1px 0 rgb(0 0 0 / 0.6),
      0 -1.125rem 2.5rem -0.625rem rgb(var(--ice-rgb) / 0.12);
    cursor: pointer;
  }

  /* The panel's seams, every so often. */
  .board::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, transparent 0 calc(22.5625rem - 2px), rgb(0 0 0 / 0.55) calc(22.5625rem - 2px) 22.5625rem);
    pointer-events: none;
  }

  /* The lit dots: the words seen through a fine grid of round holes (fixed to the panel), glowing. The glow is the
     panel's, after the holes, so it's a soft light round the dots rather than dots of light. */
  .board__panel {
    height: 100%;
    filter: drop-shadow(0 0 0.375rem rgb(var(--ice-rgb) / 0.75));
  }

  .board__dots {
    height: 100%;
    -webkit-mask-image: radial-gradient(circle, #000 52%, transparent 62%);
    mask-image: radial-gradient(circle, #000 52%, transparent 62%);
    -webkit-mask-size: 0.25rem 0.25rem;
    mask-size: 0.25rem 0.25rem;
  }

  /* The run, moved by the script on its own layer, so the panel is never repainted as it goes. */
  .board__track {
    display: flex;
    width: max-content;
    height: 100%;
    will-change: transform;
  }

  .board__run {
    display: flex;
    align-items: center;
  }

  .board__item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.875rem;
    padding: 0 1.625rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgb(var(--ice-rgb) / 0.78);
    transition: color 200ms var(--ease-out);
  }

  .board__item span {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: rgb(var(--ice-rgb) / 0.5);
  }

  /* Between names, the mark's triangle. */
  .board__mark {
    align-self: center;
    width: 0.875rem;
    height: 0.875rem;
    margin-left: 0.75rem;
    background: rgb(var(--ice-rgb) / 0.6);
    clip-path: polygon(100% 100%, 0 100%, 100% 0);
  }

  .board__item.is-on {
    color: var(--white);
  }

  .board__item.is-on span {
    color: rgb(var(--white-rgb) / 0.85);
  }

  /* Phones and tablets: a lower board, its names smaller, the panel's dots finer. */
  @media (max-width: 1023px) {
    .board {
      height: 3rem;
    }

    .board::after {
      background: repeating-linear-gradient(90deg, transparent 0 calc(14rem - 2px), rgb(0 0 0 / 0.55) calc(14rem - 2px) 14rem);
    }

    .board__dots {
      -webkit-mask-size: 0.1875rem 0.1875rem;
      mask-size: 0.1875rem 0.1875rem;
    }

    .board__item {
      gap: 0.625rem;
      padding: 0 1.125rem;
      font-size: 1.3125rem;
    }

    .board__item span {
      font-size: 0.6875rem;
    }

    .board__mark {
      width: 0.625rem;
      height: 0.625rem;
      margin-left: 0.5rem;
    }
  }

  /* Powering up, on the page's first opening: column by column, once the floodlights are on. The clip reaches above
     the board, so its glow on the pitch comes on with it. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.spec-cue) .board {
      animation: board-boot 480ms steps(24) 950ms both;
    }

    @keyframes board-boot {
      from {
        clip-path: inset(-4rem 100% 0 0);
      }
      to {
        clip-path: inset(-4rem 0 0 0);
      }
    }
  }
</style>

<script>
  import { initSportBoard } from '@/scripts/system/sport-board';
  initSportBoard();
</script>
