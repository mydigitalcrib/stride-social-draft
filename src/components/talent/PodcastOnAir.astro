---
// Stride Podcasts' hero on desktop: ON AIR above the headline, a sign in lit tubes that flickers on as the page opens,
// as a studio's does when the red light comes on (in ice, not red: one colour per division). Sizes in rem, so it grows
// with a large screen as the headline does. (Its waveform is gone: the owner, 2026-11-13.)
import { interfaceCopy } from '@/lib/ui-copy';

const t = await interfaceCopy();
---

<p class="onair" aria-hidden="true"><span class="onair__dot"></span>{t('spec.podcasts.onair')}</p>

<style>
  .onair {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5625rem 1.125rem 0.5625rem 0.875rem;
    border-radius: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #f4fcff;
    box-shadow:
      inset 0 0 0 2px rgb(var(--ice-rgb) / 0.95),
      0 0 0 1px rgb(var(--ice-rgb) / 0.4),
      0 0 1.375rem rgb(var(--ice-rgb) / 0.55),
      inset 0 0 1.125rem rgb(var(--ice-rgb) / 0.35);
    text-shadow:
      0 0 0.375rem rgb(var(--ice-rgb) / 0.95),
      0 0 1.125rem rgb(var(--ice-rgb) / 0.7);
  }

  .onair__dot {
    width: 0.6875rem;
    height: 0.6875rem;
    border-radius: 50%;
    background: #f4fcff;
    box-shadow: 0 0 0.625rem 0.125rem rgb(var(--ice-rgb) / 0.9);
  }

  @media (max-width: 1023px) {
    .onair {
      gap: 0.5625rem;
      padding: 0.4375rem 0.875rem 0.4375rem 0.6875rem;
      border-radius: 0.625rem;
      font-size: 0.875rem;
    }

    .onair__dot {
      width: 0.5625rem;
      height: 0.5625rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .onair {
      animation: onair-on 1300ms steps(1) 500ms both;
    }

    .onair__dot {
      animation: onair-pulse 2.4s ease-in-out 1.8s infinite;
    }

    @keyframes onair-on {
      0% { opacity: 0.12; }
      12% { opacity: 1; }
      20% { opacity: 0.2; }
      34% { opacity: 0.95; }
      42% { opacity: 0.35; }
      60%,
      100% { opacity: 1; }
    }

    @keyframes onair-pulse {
      50% {
        opacity: 0.35;
        box-shadow: 0 0 0.25rem rgb(var(--ice-rgb) / 0.5);
      }
    }
  }
</style>
