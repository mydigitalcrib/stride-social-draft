  /* While a figure counts up it keeps its final width (the same number, unseen, under it), so the words beside it
     don't move along as digits are added. */
  .spec__stat b {
    display: inline-flex;
    flex-direction: column;
  }

  .spec__stat b::after {
    content: attr(data-spec-count);
    height: 0;
    overflow: hidden;
    visibility: hidden;
  }

  @media (min-width: 1024px) {
    .spec--hero {
      padding-bottom: clamp(6rem, 14vh, 9.375rem);
