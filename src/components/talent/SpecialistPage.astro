  /* Desktop: the headline stays lit, as Stride Talent's does: a soft glow of ice around the letters and a sheen of
     light crossing them every few seconds. Below it, the division counted. */
  .spec__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.75rem;
  }

  .spec__stat {
    display: flex;
    align-items: baseline;
