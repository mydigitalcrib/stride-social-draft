  .spec[data-page='podcasts'] .spec__grid :global(.ccc__photo img) {
    object-fit: contain;
    object-position: 50% 0;
  }

  /* Where they've spoken, in pictures: photographs without frames, four to a row; under each, who it is, what it
     was and when. The picture opens the post it comes from. */
  .spec__seen {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
