---
// The Stride Talent page's content, on every screen: Stride Talent's Instagram profile, recreated (InstaProfile: its
// stories, highlights, posts, case studies and rosters), then the way on for creators (TalentClose). The photocall,
// the division picker, "Meet our talent.", the career plan and the creator stories were taken off the page (the owner,
// 2026-11-18); the picker, the roster browser and the profile sheet live on in the roster and the specialist pages.
// Copy lives in src/content/pages/talent.yaml; creators only with consent (src/lib/roster.ts), figures only verified.
import { getEntry } from 'astro:content';
import InstaProfile from './InstaProfile.astro';
import BackVideo from '../core/BackVideo.astro';
import TalentClose from './TalentClose.astro';

const page = await getEntry('pages', 'talent');
if (!page) throw new Error('Missing src/content/pages/talent.yaml');
const s = page.data.sections;
// The page's one headline, for screen readers and search: the profile shows the handle, as Instagram does.
const title = (s.hero.lines ?? []).join(' ') || 'Stride Talent';
---

{/* The page stands in front of Contact's background, the showreel under Stride's frosted navy (the owner, 2026-11-13). */}
<BackVideo look="deep" mp4="/assets/video/stride-showreel-desktop.mp4" webm="/assets/video/stride-showreel-desktop.webm" poster="/assets/site/stride-showreel-desktop-poster.jpg" blur={10} />

<h1 class="visually-hidden">{title}</h1>
{/* It opens on Stride Talent's Instagram profile, recreated (the owner, 2026-11-17). */}
<InstaProfile />

<TalentClose items={s.close?.items ?? []} />
