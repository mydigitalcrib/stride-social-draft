---
// Stride Talent's division picker (desktop): the divisions as one justified block of giant type, every line running
// edge to edge. Coming into view, each line rises out of its own slot and its words spread out to the edges. Under
// the pointer a name rolls over in its slot to a few of its creators' faces, the others dim, and a line under the
// block says what it is and what a click does. Under the pointer (and once chosen) its letters fill with its
// creators' photographs, one after another, drifting slowly through each face; a click takes a camera flash.
// Choosing a division filters the roster just below (src/scripts/system/roster-browser.ts);
// Sport and Speakers lead to their own pages. Who belongs where is proposed until the roster sheet confirms it
// (src/lib/roster.ts). The type is sized to the width by the script; without it, an estimate does. On a large screen it
// grows with the root size, and it never stands taller than the screen allows (roster-browser.ts). Once a division's
// faces have been fetched, they fade back into the word when the pointer leaves it (.is-warm) instead of vanishing.
export interface Props {
  eyebrow?: string;
  headline?: string;
  body?: string;
  divisions: { id: string; name: string; href: string; own: boolean; count: number; photo: { src: string; alt: string } | null; faces?: { src: string; alt: string }[] }[];
  emptyLabel: string;
}

import { interfaceCopy } from '@/lib/ui-copy';

const { eyebrow, headline, body, divisions, emptyLabel } = Astro.props;
const t = await interfaceCopy();
const label = (d: Props['divisions'][number]) => d.name.replace(/^Stride /, '');

// The block's lines: the divisions in order, two to a line, so no name ever sits alone in the middle. An odd one out
// ends the block on its own, flush left, as the last line of a justified paragraph does.
const size = (line: Props['divisions']) => line.reduce((n, d) => n + label(d).length, 0) + (line.length - 1) * 1.5;
const lines = Array.from({ length: Math.ceil(divisions.length / 2) }, (_, i) => divisions.slice(i * 2, i * 2 + 2));
const plan = { worst: Math.max(...lines.map(size)) };
// Four of its creators' photographs for its letters to show in turn (repeated when it has fewer; none, none).
const FILLS = 4;
const fills = (d: Props['divisions'][number]) => {
  const all = d.faces ?? [];
  return all.length ? Array.from({ length: FILLS }, (_, k) => all[k % all.length]) : [];
};
const cssUrl = (src: string) => `url("${src.replace(/"/g, '%22')}")`;
// What the line under the block says for it.
const caption = (d: Props['divisions'][number]) =>
  [label(d), d.count > 0 ? `${d.count} ${t('picker.creators')}` : emptyLabel, d.own ? t('picker.page') : d.count > 0 ? t('picker.see') : ''].filter(Boolean).join(' · ');
---

<section class="picker" id="divisions" aria-labelledby="picker-title" data-tone="talent" data-look="deep" data-picker style={`--chars: ${plan.worst}`}>
  <div class="picker__inner">
    <header class="picker__head">
      {eyebrow && <p class="exp-label">{eyebrow}</p>}
      {headline && <h2 class="picker__title exp-title" id="picker-title">{headline}</h2>}
      {body && <p class="picker__body">{body}</p>}
    </header>

    <nav class="picker__block" aria-label={headline ?? 'Divisions'} data-picker-block>
      {lines.map((line, i) => (
        <p class="picker__line" style={`--line: ${i}`} data-picker-line>
          {line.map((d) => (
            <a class="picker__item" href={d.href} aria-label={caption(d)} data-picker-item={d.id} data-picker-own={d.own ? '' : undefined} data-picker-caption={caption(d)} aria-pressed={d.own ? undefined : 'false'} data-picker-faces={fills(d).map((f) => f.src).join('|') || undefined}>
              <span class="picker__slot" aria-hidden="true">
                <span class="picker__roll">
                  <span class="picker__name">
                    {label(d)}
                    {fills(d).length > 0 && (
                      <span class="picker__fills">
                        {fills(d).map((f, k) => <span class="picker__fill" style={`--k: ${k}; --img: ${cssUrl(f.src)}`}>{label(d)}</span>)}
                      </span>
                    )}
                  </span>
                </span>
              </span>
            </a>
          ))}
        </p>
      ))}
      <p class="picker__caption exp-label" aria-hidden="true" data-picker-caption-line data-hint={t('picker.hint')}>{t('picker.hint')}</p>
    </nav>
  </div>
</section>

<style>
  .picker {
    position: relative;
    padding-block: clamp(4.5rem, 12vh, 8.75rem);
    color: rgb(var(--ink));
  }

  /* Desktop: straight on from the entrance, without a stretch of empty floor between them. */
  @media (min-width: 1024px) {
    .picker {
      padding-top: clamp(1rem, 3vh, 2.5rem);
    }
  }

  .picker__inner {
    display: grid;
    gap: clamp(2rem, 6vh, 4rem);
    margin-inline: var(--margin);
  }

  .picker__head {
    display: grid;
    gap: var(--space-3);
  }

  .picker__title {
    font-size: clamp(2rem, 3.4vw, 3.5rem);
  }

  .picker__body {
    color: rgb(var(--ink) / 0.78);
  }

  /* ---------- The block: justified, every line edge to edge ---------- */
  .picker__block {
    container-type: inline-size;
    /* An estimate from the longest line; the script measures and sets the real size. */
    font-size: var(--fit, min(7.5rem, calc(100cqi / (var(--chars) * 1.3))));
  }

  .picker__line {
    /* Squeezed in from both sides (--pack, from the script) the words sit together; let out, they spread to the edges. */
    --pack: 0px;
    display: flex;
    justify-content: space-between;
    gap: 0.3em;
    padding-inline: 0;
    font-family: var(--font-display);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: padding-inline 1100ms cubic-bezier(0.6, 0, 0.2, 1) calc(var(--line) * 110ms + 380ms);
  }

  .picker__line:has(> :only-child) {
    justify-content: flex-start;
  }

  .picker__item {
    display: block;
    color: rgb(var(--ink) / 0.9);
    transition:
      color 260ms var(--ease-out),
      opacity 260ms var(--ease-out);
  }

  /* Its slot: one line tall. The name and its number are stacked inside; rolling shows one or the other. */
  .picker__slot {
    display: block;
    height: 1em;
    overflow: hidden;
  }

  .picker__roll {
    display: grid;
    grid-template-rows: 1em;
    justify-items: center;
    transition: translate 760ms cubic-bezier(0.2, 0.9, 0.2, 1) calc(var(--line) * 110ms);
  }

  .picker__name {
    position: relative;
    display: block;
    transition:
      color 260ms var(--ease-out),
      -webkit-text-stroke-color 260ms var(--ease-out);
  }

  /* Its creators in its letters: four copies of the word over it, each filled with one of their photographs (the
     band of it the letters cut through, drifting down through the face), taking turns, one fading into the next; the
     first already in the moment it's pointed at (its turn starts where it's fully in), so the word is never empty.
     Not shown, so not loaded, until the word is pointed at or chosen (the script fetches them a moment ahead). The
     four fade in and out together on their holder (.picker__fills): never with a filter on the letters themselves,
     which Chrome draws as the whole photograph, unclipped, while it changes (the owner's recording, 2026-11-13). */
  .picker__fills {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 260ms var(--ease-out);
  }

  .picker__fill {
    position: absolute;
    inset: 0;
    display: none;
    color: transparent;
    /* The band through the face, round the eyes. */
    background: var(--img) 50% 32% / 100% auto no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    /* No glow: the navy glow the wall gives the smaller words (talent/TalentWall.astro) is inherited, and a text
       shadow is painted over a background clipped to the letters, so it hid the photographs under navy. */
    text-shadow: none;
    opacity: 0;
  }

  .picker__item:is(:hover, :focus-visible, [aria-pressed='true'], .is-glimpse) .picker__fills {
    opacity: 1;
  }

  .picker__item:is(:hover, :focus-visible, [aria-pressed='true'], .is-glimpse) .picker__fill {
    display: block;
    animation: picker-fill 4.4s linear calc(var(--k) * 1.1s - 0.31s) infinite;
  }

  @keyframes picker-fill {
    0% {
      opacity: 0;
      background-position: 50% 24%;
    }
    7% {
      opacity: 1;
    }
    25% {
      opacity: 1;
    }
    32% {
      opacity: 0;
      background-position: 50% 42%;
    }
    100% {
      opacity: 0;
      background-position: 50% 42%;
    }
  }

  /* Pointed at or chosen: the word itself steps back to an outline the photographs fill. */
  .picker__item:hover .picker__name,
  .picker__item:focus-visible .picker__name,
  .picker__item[aria-pressed='true'] .picker__name,
  .picker__item.is-glimpse .picker__name {
    color: rgb(var(--ink) / 0.1);
    -webkit-text-stroke: 0.0625rem rgb(var(--ink) / 0.55);
  }

  .picker__item[aria-pressed='true'] .picker__name {
    -webkit-text-stroke-color: rgb(var(--tone-lit));
  }

  /* A click: the camera's flash on the word. */
  .picker__item {
    position: relative;
  }

  .picker__item.is-flashed::after {
    content: '';
    position: absolute;
    inset: -30% -6%;
    background: radial-gradient(closest-side, rgb(var(--white-rgb) / 0.95), rgb(var(--ice-rgb) / 0.45) 45%, transparent);
    pointer-events: none;
    animation: picker-flash 520ms var(--ease-out) forwards;
  }

  @keyframes picker-flash {
    from {
      opacity: 1;
      scale: 0.7;
    }
    to {
      opacity: 0;
      scale: 1.15;
    }
  }

  /* What the division under the pointer is, and what a click does. */
  .picker__caption {
    margin-top: 0.35em;
    font-size: var(--type-label);
    color: rgb(var(--ink) / 0.72);
    transition: opacity 200ms var(--ease-out);
  }

  .picker__caption.is-swapping {
    opacity: 0;
  }

  /* Under the pointer (or the keyboard) the rest step back; not over the gaps between the words, so it doesn't flicker. */
  .picker__block:has(.picker__item:is(:hover, :focus-visible)) .picker__item:not(:hover, :focus-visible, [aria-pressed='true']) {
    opacity: 0.32;
  }

  /* Its faces fetched (roster-browser.ts): they stay laid in, their holder faded out, and fade back into the word as
     the pointer leaves (the word filling back in under them), picking up where they were when it comes back. */
  @media (prefers-reduced-motion: no-preference) {
    .picker__item.is-warm .picker__fill {
      display: block;
      animation: picker-fill 4.4s linear calc(var(--k) * 1.1s - 0.31s) infinite paused;
    }

    .picker__item.is-warm:is(:hover, :focus-visible, [aria-pressed='true'], .is-glimpse) .picker__fill {
      animation-play-state: running;
    }
  }

  .picker__item:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 4px;
  }

  /* Phones: the same giant type, one division to a line, each sized by the script to run edge to edge (--size; two
     to a line couldn't be big on a phone's width), so the block is still one justified wall of names (the owner,
     2026-11-13: phones as desktop). Tablets keep two to a line, spread wider (roster-browser.ts). */
  @media (max-width: 767px) {
    .picker__line {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }

    .picker__item {
      font-size: var(--size, 1em);
    }

    .picker__roll {
      justify-items: start;
    }
  }

  /* Before it comes into view, and only once the script is there to bring it in: below its slot, the words together. */
  .picker.is-ready:not(.is-in) .picker__roll {
    translate: 0 1.1em;
    transition: none;
  }

  .picker.is-ready:not(.is-in) .picker__line {
    padding-inline: var(--pack);
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .picker__line,
    .picker__roll,
    .picker__item,
    .picker__name {
      transition: none;
    }

    /* The first photograph only, still. */
    .picker__item:hover .picker__fill,
    .picker__item:focus-visible .picker__fill,
    .picker__item[aria-pressed='true'] .picker__fill {
      animation: none;
    }

    .picker__item:hover .picker__fill:first-child,
    .picker__item:focus-visible .picker__fill:first-child,
    .picker__item[aria-pressed='true'] .picker__fill:first-child {
      opacity: 1;
    }

    .picker__item.is-flashed::after {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  import { initDivisionPicker } from '@/scripts/system/roster-browser';
  initDivisionPicker();
</script>
