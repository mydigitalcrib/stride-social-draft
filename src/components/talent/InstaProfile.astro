---
// Stride Talent's Instagram profile, recreated as the opening of /talent (the owner, 2026-11-17: "for the beginning of
// Stride Talent I want this exactly first ... recreate this", instagram.com/stridetalent): its picture, handle and blue
// badge, name, posts / followers / following, category and bio, its link, Follow / Message / Apply, its highlights in a
// row (Talent 2.0's: Join Stride and the niches, each playing its stories), the grid / reels / tagged tabs and its latest posts, three to a row as Instagram lays them out, each opening the
// post on Instagram. Laid out as Instagram's profile is, on the page's own navy (the site's background, not
// Instagram's black), in the system's own type as Instagram's is. Reels is Stride Talent's case studies, each played
// here with its sound (the owner, 2026-11-18); the third tab is the roster.
// Phones: Instagram's phone profile (the picture beside the figures, the bio under them, the buttons full width, the
// highlights a row that scrolls). Data: src/config/stride-instagram.ts (read off the profile on 2026-11-17).
import StoryPlayer from './StoryPlayer.astro';
import { strideInstagram as ig } from '@/config/stride-instagram';
import { talentStories } from '@/lib/talent-stories';
import { routes } from '@/lib/routes';

// Its highlights are Stride Talent 2.0's rings (the owner, 2026-11-17): "Join Stride", then a highlight per niche that
// plays that niche's stories in Talent 2.0's player (lib/talent-stories.ts, scripts/system/talent-stories.ts), drawn
// as Stride's highlight covers: navy, the name in white type.
const { niches, stories, groups, words, join, rosterPosts } = await talentStories();
// The third tab is the roster (the owner, 2026-11-18): a post per niche that has one (`rosterPost` in talent2.yaml), its
// whole roster to swipe through, opened from the tab or from the card after the niche's stories.
const say = (key: string, fallback: string, r?: { label: string; count: number }) =>
  (words[key] ?? fallback).replace('{n}', String(r?.count ?? '')).replace('{niche}', r?.label ?? '');
const long = (text: string) => text.split(' ').some((w) => w.length > 9);
// The Reels tab shows this many case studies before "Show more".
const reelsFirst = 12;
// Its own stories (the owner, 2026-11-18): played from its profile picture, in the same player as the highlights, as a
// group of their own that ends where it ends (`own`) instead of running on into the niches.
const ownStories = ig.stories.map((s, i) => ({
  id: `stride-${i + 1}`,
  n: ig.handle,
  p: '/assets/site/stride-talent-avatar.svg',
  v: 'video' in s ? s.video : null,
  vp: 'video' in s ? s.poster : null,
  pic: 'img' in s ? s.img : s.poster,
  alt: s.alt,
  u: ig.href,
}));
const ownGroup = { k: 'stride', l: ig.handle, ids: ownStories.map((s) => s.id), own: true };

const mark = '<svg viewBox="0 0 106 106" aria-hidden="true"><path d="M53 53H0L53 0v53Z"/><path d="M53 106H0l53-53v53Z"/><path d="M106 53H53l53-53v53Z"/><path d="M106 106H53l53-53v53Z"/></svg>';
---

<section class="igp" aria-labelledby="igp-handle" data-tone="talent" data-look="deep" data-insta-profile data-stories>
  {/* "Stridegram", in the middle of the top, level with the header's logo and menu: this section's own (the owner,
      2026-11-17: "the only section that will have this logo in the middle"). */}
  <img class="igp__brand" src="/assets/site/stridegram-logo-white.png" alt="Stridegram" width="1040" height="224" sizes="(min-width: 1921px) 12vw, 240px" decoding="async" />
  <div class="igp__inner">
    <header class="igp__head">
      {/* Its picture wears Instagram's green ring and plays its own stories; grey once they've all been watched. */}
      {ownStories.length ? (
        <button class="igp__avatar igp__avatar--stories ring" type="button" data-niche="stride" data-plays aria-label={`@${ig.handle}: play its stories`} set:html={mark} />
      ) : (
        <a class="igp__avatar" href={ig.href} target="_blank" rel="noopener" aria-label={`@${ig.handle} on Instagram`} set:html={mark} />
      )}
      <div class="igp__info">
        <div class="igp__row">
          <h2 class="igp__handle" id="igp-handle">{ig.handle}</h2>
          {ig.verified && (
            <svg class="igp__badge" viewBox="0 0 40 40" role="img" aria-label="Verified">
              <path d="M19.998 3.094 14.638 0l-2.972 5.15H5.432v6.354L0 14.64 3.094 20 0 25.359l5.432 3.137v5.905h5.975L14.638 40l5.36-3.094L25.358 40l3.232-5.6h6.162v-6.01L40 25.359 36.905 20 40 14.641l-5.248-3.03v-6.46h-6.419L25.358 0l-5.36 3.094Zm7.415 11.225 2.254 2.287-11.43 11.5-6.835-6.93 2.244-2.258 4.587 4.581 9.18-9.18Z"></path>
            </svg>
          )}
          <a class="igp__more" href={ig.href} target="_blank" rel="noopener" aria-label="More on Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="1.5"></circle><circle cx="12" cy="12" r="1.5"></circle><circle cx="18" cy="12" r="1.5"></circle></svg>
          </a>
        </div>
        <p class="igp__name">{ig.name}</p>
        <ul class="igp__stats" role="list" title={`Source: ${ig.statsSource}`}>
          {ig.stats.map((s) => <li><b>{s.value}</b> {s.label}</li>)}
        </ul>
        <div class="igp__bio">
          <p class="igp__category">{ig.category}</p>
          {ig.bio.map((line) => <p>{line}</p>)}
          <a class="igp__link" href={ig.link.href} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 13.5a4 4 0 0 0 5.66 0l3.18-3.18a4 4 0 0 0-5.66-5.66l-1.06 1.06M13.5 10.5a4 4 0 0 0-5.66 0l-3.18 3.18a4 4 0 0 0 5.66 5.66l1.06-1.06"></path></svg>
            {ig.link.label}
          </a>
        </div>
      </div>
      {/* Under the picture and the words together, across the head, as Instagram's profile has them (the owner,
          2026-11-18). */}
      <p class="igp__buttons">
        <a class="igp__btn igp__btn--follow" href={ig.href} target="_blank" rel="noopener">Follow</a>
        {/* Message goes to the site's Contact page (the owner, 2026-11-18), not Instagram's direct messages. */}
        <a class="igp__btn" href="/contact">Message</a>
        <a class="igp__btn igp__btn--icon" href="/talent/apply" aria-label="Apply to Stride">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="8" r="3.6"></circle><path d="M3.5 20a6.5 6.5 0 0 1 13 0M19 8v6M16 11h6"></path></svg>
        </a>
      </p>
    </header>

    <div class="igp__rail" data-rail>
      <ol class="igp__highlights" role="list" aria-label="Highlights" data-rail-track>
        {join && (
          <li>
            <a class="igp__highlight" href={join.href ?? '/talent/apply'}>
              <span class="igp__ring">
                <span class="igp__cover">{join.label}</span>
                <span class="igp__plus" aria-hidden="true">+</span>
              </span>
              <span class="igp__label">{join.label}</span>
            </a>
          </li>
        )}
        {niches.map((n) => (
          <li>
            <button class="igp__highlight ring" type="button" data-niche={n.key} data-plays aria-label={`${n.label}: play its stories`}>
              <span class="igp__ring">
                <span class:list={['igp__cover', { 'igp__cover--long': long(n.label) }]}>{n.label}</span>
              </span>
              <span class="igp__label">{n.label}</span>
            </button>
          </li>
        ))}
      </ol>
      <button class="igp__step igp__step--prev" type="button" aria-label="Earlier highlights" data-rail-step="-1" tabindex="-1">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
      </button>
      <button class="igp__step igp__step--next" type="button" aria-label="More highlights" data-rail-step="1" tabindex="-1">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>

    <div class="igp__tabs" role="toolbar" aria-label="Posts">
      <button class="igp__tab" type="button" aria-pressed="true" aria-label="Posts" data-igp-tab="all">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="1.5"></rect><path d="M9 3v18M15 3v18M3 9h18M3 15h18"></path></svg>
      </button>
      {/* Reels: Stride Talent's case-study reels, played here; without any, Stride Talent's reels on Instagram. */}
      {ig.reels.length ? (
        <button class="igp__tab" type="button" aria-pressed="false" aria-label="Reels" data-igp-tab="reel">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4.5"></rect><path d="M3 8.5h18M8.5 3l3 5.5M14 3l3 5.5"></path><path d="M10 12v5l4.5-2.5Z" fill="currentColor"></path></svg>
        </button>
      ) : (
        <a class="igp__tab" href={`${ig.href}reels/`} target="_blank" rel="noopener" aria-label="Reels, on Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4.5"></rect><path d="M3 8.5h18M8.5 3l3 5.5M14 3l3 5.5"></path><path d="M10 12v5l4.5-2.5Z" fill="currentColor"></path></svg>
        </a>
      )}
      {rosterPosts.length ? (
        <button class="igp__tab" type="button" aria-pressed="false" aria-label={say('rosterTab', 'Roster')} data-igp-tab="roster">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2.5"></rect><circle cx="12" cy="10" r="3"></circle><path d="M6.5 21a5.5 5.5 0 0 1 11 0"></path></svg>
        </button>
      ) : (
        <a class="igp__tab" href={`${ig.href}tagged/`} target="_blank" rel="noopener" aria-label="Tagged, on Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2.5"></rect><circle cx="12" cy="10" r="3"></circle><path d="M6.5 21a5.5 5.5 0 0 1 11 0"></path></svg>
        </a>
      )}
    </div>

    <ul class="igp__grid" role="list">
      {ig.posts.map((p) => (
        <li data-kind={p.kind} data-tab="all">
          <a class="igp__post" href={p.href ?? `https://www.instagram.com/p/${p.code}/${p.slide ? `?img_index=${p.slide}` : ''}`} target="_blank" rel="noopener" data-igp-open={p.code}>
            <img src={`/assets/site/ig-stridetalent-${p.code}.jpg`} alt={p.alt} width="720" height="900" sizes="(min-width: 1921px) 16.7vw, (min-width: 1024px) 20rem, 33vw" loading="lazy" decoding="async" />
            {p.kind === 'carousel' && (
              <svg class="igp__kind" viewBox="0 0 24 24" role="img" aria-label="Carousel"><path d="M8 3h11a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" fill="currentColor"></path><path d="M3.5 7v12a1.5 1.5 0 0 0 1.5 1.5h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
            )}
            {p.kind === 'reel' && (
              <svg class="igp__kind" viewBox="0 0 24 24" role="img" aria-label="Reel"><rect x="2.5" y="2.5" width="19" height="19" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"></rect><path d="M2.5 8h19M8 2.5l3 5.5M13.5 2.5l3 5.5" fill="none" stroke="currentColor" stroke-width="1.8"></path><path d="M10 11.5v6l5-3Z" fill="currentColor"></path></svg>
            )}
          </a>
        </li>
      ))}
      {/* The Reels tab's case studies, tall as Instagram's reels, each showing its cover; twelve, then twelve more at a
          time. One opens the player below (a modified click, or no JavaScript, opens it on Instagram). */}
      {ig.reels.map((r, i) => (
        <li data-kind="reel" data-tab="reel" data-later={i >= reelsFirst ? '' : undefined} hidden>
          <a
            class="igp__post igp__post--reel"
            href={`https://www.instagram.com/reel/${r.code}/`}
            target="_blank"
            rel="noopener"
            data-igp-reel={i}
            data-src={`/assets/video/ig-stridetalent-reel-${r.code}.mp4`}
            data-poster={`/assets/site/ig-stridetalent-reel-${r.code}.jpg`}
            data-title={r.title}
            data-text={r.text}
          >
            <img src={`/assets/site/ig-stridetalent-reel-${r.code}.jpg`} alt={`Case study: ${r.client}, with ${r.creator}`} width="720" height="1280" sizes="(min-width: 1921px) 16.7vw, (min-width: 1024px) 20rem, 33vw" loading="lazy" decoding="async" />
            <svg class="igp__kind" viewBox="0 0 24 24" role="img" aria-label="Reel"><rect x="2.5" y="2.5" width="19" height="19" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"></rect><path d="M2.5 8h19M8 2.5l3 5.5M13.5 2.5l3 5.5" fill="none" stroke="currentColor" stroke-width="1.8"></path><path d="M10 11.5v6l5-3Z" fill="currentColor"></path></svg>
          </a>
        </li>
      ))}
      {rosterPosts.map((r) => (
        <li data-kind="roster" data-tab="roster" hidden>
          <button class="igp__post igp__post--roster" type="button" data-igp-open={`roster-${r.key}`} data-igp-roster={r.key}>
            <span class="igp__collage" aria-hidden="true">
              {r.creators.slice(0, 4).map((c) => (
                <img src={c.p} alt="" loading="lazy" decoding="async" />
              ))}
            </span>
            <span class="igp__roster-label">
              <b>{r.label}</b>
              <span>
                {say('rosterTab', 'Roster')} · {r.count}
              </span>
            </span>
            <svg class="igp__kind" viewBox="0 0 24 24" role="img" aria-label="Carousel"><path d="M8 3h11a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" fill="currentColor"></path><path d="M3.5 7v12a1.5 1.5 0 0 0 1.5 1.5h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
          </button>
        </li>
      ))}
    </ul>
    {ig.reels.length > reelsFirst && (
      <p class="igp__whos-more" data-igp-reels-more hidden>
        <button class="exp-pill exp-pill--ghost" type="button">
          {say('rosterMore', 'Show more')}
        </button>
      </p>
    )}
    {/* A roster's tile opens its whole roster here, as a grid of its creators (the owner, 2026-11-18: "show the full
        roster here as well as a grid"), 24 at a time; a creator's square opens the roster post on them. */}
    {
      rosterPosts.map((r) => (
        <div class="igp__whos-wrap" data-igp-whos={r.key} hidden>
          <div class="igp__whos-head">
            <button class="igp__whos-back" type="button" data-igp-whos-back>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
              {say('rosterTab', 'Roster')}
            </button>
            <b>{r.label}</b>
            <span>{say('rosterCount', '{n} creators', r)}</span>
          </div>
          <ul class="igp__whos" role="list">
            {r.creators.map((c, i) => (
              <li hidden={i >= 24}>
                <button class="igp__post igp__post--who" type="button" data-igp-who={i} data-igp-who-of={r.key}>
                  <img src={c.p} alt={c.n} loading="lazy" decoding="async" />
                  <span class="igp__who-name">{c.n}</span>
                </button>
              </li>
            ))}
          </ul>
          {r.count > 24 && (
            <p class="igp__whos-more">
              <button class="exp-pill exp-pill--ghost" type="button" data-igp-whos-more>
                {say('rosterMore', 'Show more')}
              </button>
            </p>
          )}
        </div>
      ))
    }
    <p class="igp__all"><a href={ig.href} target="_blank" rel="noopener">See all {ig.stats[0].value} posts on Instagram</a></p>
  </div>
  {/* A post opens here, over the page, as Instagram opens one (the owner, 2026-11-17: all its pictures, swiped in the
      page, without going to Instagram): its pictures on the left (swipe, drag, the arrows or the arrow keys; in the post's
      order, from its cover, the picture the grid shows), the account and its words on the right. Without JavaScript the grid's links go
      to Instagram. */}
  {
    ig.posts.map((p) => (
      <dialog class="igv" data-igp-viewer={p.code} aria-label={p.alt}>
        <div class="igv__box">
          <div class="igv__media">
            <ol class="igv__track" data-igv-track>
              {Array.from({ length: p.slides }, (_, i) => i + 1).map((n, i) => (
                <li class="igv__slide">
                  <img
                    src={`/assets/site/ig-stridetalent-${p.code}-${n}.jpg`}
                    alt={p.alts?.[i] ?? (p.slides > 1 ? `${p.alt} (picture ${i + 1} of ${p.slides})` : p.alt)}
                    sizes="(min-width: 1921px) 28.4vw, (min-width: 1024px) 34rem, 100vw"
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                </li>
              ))}
            </ol>
            {p.slides > 1 && (
              <>
                <button class="igv__step igv__step--prev exp-round" type="button" aria-label="Previous picture" data-igv-step="-1">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
                </button>
                <button class="igv__step igv__step--next exp-round" type="button" aria-label="Next picture" data-igv-step="1">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
                </button>
                <span class="igv__dots" aria-hidden="true">
                  {Array.from({ length: p.slides }, () => (
                    <i />
                  ))}
                </span>
              </>
            )}
          </div>
          <div class="igv__side">
            <header class="igv__head">
              <span class="igv__avatar" set:html={mark} />
              <b>{ig.handle}</b>
              {ig.verified && (
                <svg class="igv__badge" viewBox="0 0 40 40" role="img" aria-label="Verified">
                  <path d="M19.998 3.094 14.638 0l-2.972 5.15H5.432v6.354L0 14.64 3.094 20 0 25.359l5.432 3.137v5.905h5.975L14.638 40l5.36-3.094L25.358 40l3.232-5.6h6.162v-6.01L40 25.359 36.905 20 40 14.641l-5.248-3.03v-6.46h-6.419L25.358 0l-5.36 3.094Zm7.415 11.225 2.254 2.287-11.43 11.5-6.835-6.93 2.244-2.258 4.587 4.581 9.18-9.18Z" fill="currentColor" fill-rule="evenodd" />
                </svg>
              )}
            </header>
            <p class="igv__caption">
              <b>{ig.handle}</b> {p.alt}
            </p>
            {p.slides > 1 && (
              <p class="igv__count" data-igv-count aria-live="polite">
                1 / {p.slides}
              </p>
            )}
            <a class="igv__ig" href={p.href ?? `https://www.instagram.com/p/${p.code}/`} target="_blank" rel="noopener">
              View on Instagram
            </a>
          </div>
          <button class="igv__close exp-round" type="button" aria-label="Close" data-igv-close>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
        </div>
      </dialog>
    ))
  }
  {
    rosterPosts.map((r) => (
      <dialog class="igv igv--roster" data-igp-viewer={`roster-${r.key}`} aria-label={say('rosterCaption', 'The {niche} roster', r)}>
        <div class="igv__box">
          <div class="igv__media">
            <ol class="igv__track" data-igv-track>
              {r.creators.map((c) => (
                <li class="igv__slide igv__slide--who" data-id={c.id} data-name={c.n}>
                  <img src={c.p} alt={c.n} loading="lazy" decoding="async" draggable="false" />
                  <span class="igv__who">{c.n}</span>
                </li>
              ))}
            </ol>
            {r.count > 1 && (
              <>
                <button class="igv__step igv__step--prev exp-round" type="button" aria-label="Previous creator" data-igv-step="-1">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
                </button>
                <button class="igv__step igv__step--next exp-round" type="button" aria-label="Next creator" data-igv-step="1">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
                </button>
              </>
            )}
          </div>
          <div class="igv__side">
            <header class="igv__head">
              <span class="igv__avatar" set:html={mark} />
              <b>{ig.handle}</b>
            </header>
            <p class="igv__caption">
              <b>{ig.handle}</b> {say('rosterCaption', 'The {niche} roster: all {n} creators.', r)}
            </p>
            <p class="igv__count" data-igv-count aria-live="polite">
              1 / {r.count}
            </p>
            {/* The creator shown, as their own page has them (the owner, 2026-11-18: here, not a link away): their
                category and country, name, biography, platforms and the way to enquire. The details come from
                /talent/creators.json as the roster opens. */}
            {r.creators[0] && (
              <div class="igv__card" data-igv-card data-enquire={routes.creatorEnquiry('')}>
                <p class="igv__card-label" data-igv-label />
                <h3 class="igv__card-name" data-igv-name>{r.creators[0].n}</h3>
                <div class="igv__card-bio" data-igv-bio />
                <p class="igv__card-links" data-igv-links />
                <a class="igv__card-enquire exp-pill exp-pill--glass" href={routes.creatorEnquiry(r.creators[0].id)} data-igv-enquire>
                  <span data-igv-enquire-label>Enquire about {r.creators[0].n}</span> →
                </a>
              </div>
            )}
          </div>
          <button class="igv__close exp-round" type="button" aria-label="Close" data-igv-close>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
        </div>
      </dialog>
    ))
  }
  {/* A case study plays here, over the page, as Instagram opens a reel: the video whole, with its sound (a press pauses
      it, the speaker mutes it), its caption beside it, the arrows, the arrow keys or a swipe up and down for the next
      or the one before; it goes round until it's closed. One player for every reel, given the reel's file as it opens,
      so nothing loads before a reel is chosen. */}
  {
    ig.reels.length > 0 && (
