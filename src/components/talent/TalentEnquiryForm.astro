---
// Stride Talent's brand enquiry: for booking a creator, a division, an athlete or a speaker. Fields only;
// the frame is core/FormShell. Posts to the Stride OS brief once Stride gives the address
// (PUBLIC_TALENT_ENQUIRY_ACTION); `interest` and `creator` say where each enquiry should go. Prefills
// ?interest= and ?creator=. The public fallback is the team inbox, never a talent manager's email.
import Field from '../core/Field.astro';
import FormShell from '../core/FormShell.astro';
import { brandEnquiryLimits as max, enquiryEmail, marketOptions, talentEnquiryAction } from '@/config/forms';
import { getRoster } from '@/lib/roster';

export interface Props {
  messages: { success: string; error: string; unavailable: string; consent: string };
  interests: { value: string; label: string }[];
  tone?: 'light' | 'dark';
}

const { messages, interests, tone = 'light' } = Astro.props;
const names = Object.fromEntries((await getRoster()).map((c) => [c.id, c.data.name]));
---

<FormShell action={talentEnquiryAction} email={enquiryEmail} subject="Stride Talent enquiry" submitLabel="Send enquiry" messages={messages} names={names} tone={tone}>
  <p class="tenq__about" hidden data-prefill-note>Enquiry about <strong data-prefill-name></strong></p>
  <div class="tenq__grid">
    <Field name="name" label="Name" required autocomplete="name" maxlength={max.name} messages={{ required: 'Enter your name' }} tone={tone} />
    <Field name="company" label="Company" required autocomplete="organization" maxlength={max.company} messages={{ required: 'Enter your company name' }} tone={tone} />
    <Field name="email" label="Work email" type="email" required autocomplete="email" maxlength={max.email} messages={{ required: 'Enter your work email', invalid: 'Enter an email address in the format name@example.com' }} tone={tone} />
    <Field name="market" label="Market" type="select" required options={marketOptions} messages={{ required: 'Choose your market' }} tone={tone} />
    <Field name="interest" label="Looking for" type="select" required options={interests} prefill="interest" messages={{ required: 'Choose what you are looking for, or "Not sure yet"' }} tone={tone} />
    <Field name="budget" label="Estimated budget" maxlength={max.budget} tone={tone} />
    <div class="tenq__wide">
      <Field name="brief" label="Your brief" type="textarea" required rows={6} maxlength={max.brief} hint="Who do you want to work with, what for, and when?" messages={{ required: 'Tell us a little about what you need' }} tone={tone} />
    </div>
  </div>
  <input type="hidden" name="creator" value="" data-prefill="creator" />
</FormShell>

<style>
  .tenq__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--gutter);
  }

  .tenq__wide {
    grid-column: 1 / -1;
  }

  .tenq__about {
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--accent);
    font-size: var(--type-small);
  }

  .tenq__about[hidden] {
    display: none;
  }

  @media (max-width: 767px) {
    .tenq__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
